// Run the tests with `fe test`.

use ingot::{Vault, VaultMsg}
use std::evm::{days, ether}

#[test(balance = 10_000_000_000_000_000_000)]
fn deposit_is_locked() uses (evm: mut Evm) {
    let vault = evm.create2<Vault>(value: Wei::zero(), args: (days(7),), salt: 0)

    let unlock: Timestamp = evm
        .call(
            addr: vault,
            gas: 200000,
            value: ether(1),
            message: VaultMsg::Deposit {},
        )
    let balance: Wei = evm
        .call(
            addr: vault,
            gas: 100000,
            value: Wei::zero(),
            message: VaultMsg::BalanceOf { owner: evm.address() },
        )
    assert!(balance == ether(1))

    let stored: Timestamp = evm
        .call(
            addr: vault,
            gas: 100000,
            value: Wei::zero(),
            message: VaultMsg::UnlockTime { owner: evm.address() },
        )
    assert!(stored == unlock)
}

// Review M2: a bare `should_revert` also passed when the setup itself reverted, so this
// test never proved that Withdraw is blocked. The setup is now a plain `call` (it must
// succeed), the positive control checks the deposit landed, and only Withdraw may fail.
#[test(balance = 10_000_000_000_000_000_000)]
fn withdraw_before_unlock_reverts() uses (evm: mut Evm) {
    let vault = evm.create2<Vault>(value: Wei::zero(), args: (days(7),), salt: 0)
    let _: Timestamp = evm
        .call(
            addr: vault,
            gas: 200000,
            value: ether(1),
            message: VaultMsg::Deposit {},
        )
    let before: Wei = evm
        .call(
            addr: vault,
            gas: 100000,
            value: Wei::zero(),
            message: VaultMsg::BalanceOf { owner: evm.address() },
        )
    assert!(before == ether(1))

    let payee = Address::new(0x1234)
    assert!(
        !evm.try_call(
            addr: vault,
            gas: 200000,
            value: Wei::zero(),
            message: VaultMsg::Withdraw { to: payee },
        )
            .success(),
    )

    let after: Wei = evm
        .call(
            addr: vault,
            gas: 100000,
            value: Wei::zero(),
            message: VaultMsg::BalanceOf { owner: evm.address() },
        )
    assert!(after == ether(1))
    assert!(evm.balance(payee) == Wei::zero())
    assert!(evm.balance(vault) == ether(1))
}

#[test(balance = 10_000_000_000_000_000_000)]
fn withdraw_after_unlock() uses (evm: mut Evm) {
    // Without a lock period, a deposit can be withdrawn right away.
    let vault = evm.create2<Vault>(value: Wei::zero(), args: (Duration::zero(),), salt: 0)
    let _: Timestamp = evm
        .call(
            addr: vault,
            gas: 200000,
            value: ether(1),
            message: VaultMsg::Deposit {},
        )

    let payee = Address::new(0x1234)
    let withdrawn: Wei = evm
        .call(
            addr: vault,
            gas: 200000,
            value: Wei::zero(),
            message: VaultMsg::Withdraw { to: payee },
        )
    assert!(withdrawn == ether(1))
    assert!(evm.balance(payee) == ether(1))
    let balance: Wei = evm
        .call(
            addr: vault,
            gas: 100000,
            value: Wei::zero(),
            message: VaultMsg::BalanceOf { owner: evm.address() },
        )
    assert!(balance == Wei::zero())
}
