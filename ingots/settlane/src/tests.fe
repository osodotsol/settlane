use std::evm::returndata::decode_error_string
// Production-ingot tests for Phase 2A: creation, validation, funding, queries, unknown ids.
//
// Every rejection test has a positive control (the same call, valid, succeeds) and checks
// that the rejected call changed nothing. There is no bare `#[test(should_revert)]`: it
// would also pass on a revert in the setup (lint T-REVERT, review M2). Tests that need a
// different caller or a movable clock are in the dev ingot (ingots/settlane-dev).
use ingot::rules
use ingot::rules::{CreateCheck, ReviewCheck, SubmitCheck}
use ingot::settlane::{SettleMsg, Settlane}
use ingot::types::MilestoneState
use std::evm::{ether, predict_create2, seconds, wei}
use std::evm::CallOutcome

const MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

// Everything `create` takes except the funding value.
struct Args {
    provider: Address,
    verifier: Address,
    review_period: Duration,
    n: u8,
    amounts: [Wei; 3],
    deliver_by: [Timestamp; 3],
    specs: [u256; 3],
}

impl Copy for Args {}

fn at(_ now: Timestamp, _ secs: u256) -> Timestamp {
    Timestamp::from_seconds(now.as_seconds() + secs)
}

// A valid three-milestone agreement: 1 + 2 + 3 ETH, deadlines 100, 200, 300 s from now.
fn valid(_ now: Timestamp) -> Args {
    Args {
        provider: Address::new(0xa1),
        verifier: Address::new(0xa2),
        review_period: seconds(3600),
        n: 3,
        amounts: [ether(1), ether(2), ether(3)],
        deliver_by: [at(now, 100), at(now, 200), at(now, 300)],
        specs: [0x51, 0x52, 0x53],
    }
}

fn total_of(_ a: Args) -> Wei {
    rules::total_amount(n: a.n, amounts: a.amounts)
}

// Emitted by the TEST CONTRACT with its own address. scripts/check_events.py compares the
// `client` topic of every direct-call AgreementCreated with it (R-003): the test contract is
// the caller of those calls, and this value does not come from Settlane.
#[event]
struct CallerProbe {
    #[indexed]
    who: Address,
}

fn deploy() -> Address uses (evm: mut Evm) {
    evm.emit(CallerProbe { who: evm.address() })
    evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
}

fn try_create(_ s: Address, _ a: Args, _ value: Wei) -> bool
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 1000000,
        value,
        message: SettleMsg::Create {
            provider: a.provider,
            verifier: a.verifier,
            review_period: a.review_period,
            n: a.n,
            amounts: a.amounts,
            deliver_by: a.deliver_by,
            specs: a.specs,
        },
    )
        .success()
}

fn create(_ s: Address, _ a: Args, _ value: Wei) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: s,
        gas: 1000000,
        value,
        message: SettleMsg::Create {
            provider: a.provider,
            verifier: a.verifier,
            review_period: a.review_period,
            n: a.n,
            amounts: a.amounts,
            deliver_by: a.deliver_by,
            specs: a.specs,
        },
    )
}

fn outstanding(_ s: Address) -> Wei uses (evm: mut Evm) {
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::TotalOutstanding {},
    )
}

fn milestone(_ s: Address, _ id: u256, _ m: u8) -> (
    u8,
    Wei,
    Timestamp,
    Timestamp,
    u256,
    u256,
    u256,
    u256,
)
uses (evm: mut Evm)
{
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetMilestone { id, m },
    )
}

fn accounting(_ s: Address, _ id: u256) -> (Wei, Wei, Wei, Wei)
uses (evm: mut Evm)
{
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetAccounting { id },
    )
}

fn agreement(_ s: Address, _ id: u256) -> (Address, Address, Address, Duration, u8)
uses (evm: mut Evm)
{
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetAgreement { id },
    )
}

fn exists(_ s: Address, _ id: u256) -> bool uses (evm: mut Evm) {
    evm.try_call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetAgreement { id },
    )
        .success()
}

// The accounting invariants (docs/SECURITY.md I1, I2, I9) for agreements 1..=last_id, and
// that agreement last_id + 1 does not exist. Called after every state-changing step.
// I9 is `balance >= outstanding` in general: ETH can reach the contract without an agreement
// (it is pre-funded at its address before deployment, forced in by selfdestruct or a coinbase
// reward), and nothing in the contract can claim it. `surplus` is the extra ETH the test knows
// about (zero for most tests), and the balance must be exactly `outstanding + surplus`.
fn check_invariants(_ s: Address, _ last_id: u256, _ surplus: Wei)
uses (evm: mut Evm)
{
    var id: u256 = 1
    var sum = Wei::zero()
    while id <= last_id {
        let acc = accounting(s, id)
        // I1: deposited == paid + refunded + outstanding.
        assert!(acc.0 == acc.1 + acc.2 + acc.3, "I1 conservation")
        var live = Wei::zero()
        var m: u8 = 0
        while m < 3 {
            let x = milestone(s, id, m)
            // states 1..=3 (Funded, Submitted, Approved) are still owed.
            if x.0 >= 1 && x.0 <= 3 {
                live = live + x.1
            }
            m += 1
        }
        assert!(
            live == acc.3,
            "outstanding equals the live milestone amounts",
        )
        sum = sum + acc.3
        id += 1
    }
    assert!(
        outstanding(s) == sum,
        "total outstanding equals the per-agreement sum",
    )
    // I9, general form: the contract always holds at least what it owes.
    assert!(evm.balance(s) >= sum, "I9 balance >= outstanding")
    // And exactly what the test knows: nothing was lost and nothing was created.
    assert!(
        evm.balance(s) == sum + surplus,
        "balance == outstanding + known surplus",
    )
    assert!(!exists(s, last_id + 1), "no agreement beyond last_id")
}

// After a rejected call: nothing changed (same total owed, same balance, no new agreement).
fn assert_untouched(_ s: Address, _ last_id: u256, _ owed: Wei, _ surplus: Wei)
uses (evm: mut Evm)
{
    assert!(
        outstanding(s) == owed,
        "rejected call changed total outstanding",
    )
    assert!(
        evm.balance(s) == owed + surplus,
        "rejected call changed the contract balance",
    )
    assert!(
        !exists(s, last_id + 1),
        "rejected call created an agreement",
    )
}

// ------------------------------------------------------------ Phase 2B helpers

// The reason a call reverted. Each negative test asserts WHY it failed, not only that it did:
// the revert data carries the message, and a wrong reason is a failed test.
enum Why {
    UnknownAgreement,
    NotProvider,
    NotVerifier,
    NoSuchMilestone,
    WrongState,
    NotSubmitted,
    DeliveryClosed,
    ReviewClosed,
    ZeroEvidence,
    EvidenceMismatch,
    RevisionMismatch,
}

impl Copy for Why {}

fn because(_ out: CallOutcome, _ why: Why) -> bool {
    if out.success() {
        return false
    }
    let reason = match decode_error_string(out.returndata()) {
        Option::Some(reason) => reason,
        Option::None => {
            return false
        },
    }
    match why {
        Why::UnknownAgreement => reason == "unknown agreement",
        Why::NotProvider => reason == "caller is not the provider",
        Why::NotVerifier => reason == "caller is not the verifier",
        Why::NoSuchMilestone => reason == "no such milestone",
        Why::WrongState => reason == "milestone cannot take evidence in this state",
        Why::NotSubmitted => reason == "milestone is not submitted",
        Why::DeliveryClosed => reason == "delivery window is closed",
        Why::ReviewClosed => reason == "review window is closed",
        Why::ZeroEvidence => reason == "evidence is zero",
        Why::EvidenceMismatch => reason == "evidence does not match the submitted evidence",
        Why::RevisionMismatch => reason == "submission revision does not match",
    }
}

// Direct calls from the test contract, which is the client and holds no provider or verifier role.
fn submit_as_client(_ s: Address, _ id: u256, _ m: u8, _ e: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Submit { id, m, evidence: e },
    )
}

fn approve_as_client(_ s: Address, _ id: u256, _ m: u8, _ e: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Approve { id, m, evidence: e, revision: 1 },
    )
}

fn reject_as_client(_ s: Address, _ id: u256, _ m: u8, _ e: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Reject { id, m, evidence: e, revision: 1 },
    )
}

fn same_milestone(
    _ a: (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256),
    _ b: (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256),
) -> bool {
    a.0 == b.0
        && a.1 == b.1
        && a.2 == b.2
        && a.3 == b.3
        && a.4 == b.4
        && a.5 == b.5
        && a.6 == b.6
        && a.7 == b.7
}

// ---------------------------------------------------------------- valid creation

#[test(balance = 100_000_000_000_000_000_000)]
fn creates_a_single_milestone_agreement() uses (evm: mut Evm) {
    let s = deploy()
    let now = evm.timestamp()
    var a = valid(now)
    a.n = 1
    a.amounts = [ether(2), Wei::zero(), Wei::zero()]
    a.deliver_by = [at(now, 100), Timestamp::from_seconds(0), Timestamp::from_seconds(0)]
    a.specs = [0x51, 0, 0]

    let id = create(s, a, ether(2))
    assert!(id == 1, "the first id is 1")

    let ag = agreement(s, id)
    assert!(ag.0 == evm.address(), "the caller is the client")
    assert!(ag.1 == Address::new(0xa1))
    assert!(ag.2 == Address::new(0xa2))
    assert!(ag.3 == seconds(3600))
    assert!(ag.4 == 1)

    let m0 = milestone(s, id, 0)
    assert!(m0.0 == 1, "slot 0 is Funded")
    assert!(m0.1 == ether(2))
    assert!(m0.2 == at(now, 100))
    assert!(
        m0.3 == at(now, 3700),
        "decide_by is deliver_by plus the review period",
    )
    assert!(m0.4 == 0x51)
    assert!(m0.5 == 0, "no evidence yet")
    // Unused slots read as None with everything zero (D-017).
    let m1 = milestone(s, id, 1)
    assert!(
        m1.0 == 0 && m1.1 == Wei::zero() && m1.2.as_seconds() == 0 && m1.4 == 0,
    )
    assert!(milestone(s, id, 2).0 == 0)

    let acc = accounting(s, id)
    assert!(
        acc.0 == ether(2) && acc.1 == Wei::zero() && acc.2 == Wei::zero() && acc.3 == ether(2),
    )
    check_invariants(s, 1, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn creates_a_three_milestone_agreement_with_every_field_stored()
uses (evm: mut Evm)
{
    let s = deploy()
    let now = evm.timestamp()
    let a = valid(now)
    let id = create(s, a, ether(6))
    assert!(id == 1)

    let ag = agreement(s, id)
    assert!(
        ag.0 == evm.address() && ag.1 == a.provider && ag.2 == a.verifier,
    )
    assert!(ag.3 == a.review_period && ag.4 == 3)

    var m: u8 = 0
    while m < 3 {
        let k = m as usize
        let x = milestone(s, id, m)
        assert!(x.0 == 1, "every used slot is Funded")
        assert!(x.1 == a.amounts[k])
        assert!(x.2 == a.deliver_by[k])
        assert!(x.3 == a.deliver_by[k] + a.review_period, "decide_by")
        assert!(x.4 == a.specs[k])
        assert!(x.5 == 0)
        m += 1
    }
    let acc = accounting(s, id)
    assert!(acc.0 == ether(6) && acc.3 == ether(6))
    assert!(outstanding(s) == ether(6))
    assert!(evm.balance(s) == ether(6))
    check_invariants(s, 1, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn ids_increment_and_agreements_are_isolated() uses (evm: mut Evm) {
    let s = deploy()
    let now = evm.timestamp()
    let a = valid(now)
    var b = valid(now)
    b.provider = Address::new(0xb1)
    b.verifier = Address::new(0xb2)
    b.n = 2
    b.amounts = [ether(4), ether(5), Wei::zero()]
    b.deliver_by = [at(now, 500), at(now, 600), Timestamp::from_seconds(0)]
    b.specs = [0x61, 0x62, 0]

    assert!(create(s, a, ether(6)) == 1)
    let first_before = milestone(s, 1, 2)
    assert!(create(s, b, ether(9)) == 2)

    // Agreement 2 has its own parties and amounts, agreement 1 is untouched (I8).
    assert!(agreement(s, 2).1 == Address::new(0xb1))
    assert!(agreement(s, 1).1 == Address::new(0xa1))
    assert!(milestone(s, 2, 1).1 == ether(5))
    assert!(
        milestone(s, 2, 2).0 == 0,
        "agreement 2 has no third milestone",
    )
    assert!(
        milestone(s, 1, 2).1 == first_before.1 && milestone(s, 1, 2).4 == first_before.4,
    )
    assert!(
        accounting(s, 1).3 == ether(6) && accounting(s, 2).3 == ether(9),
    )
    assert!(outstanding(s) == ether(15))
    check_invariants(s, 2, Wei::zero())
}

// ------------------------------------------------------------- invalid creation inputs

#[test(balance = 100_000_000_000_000_000_000)]
fn rejects_invalid_parties_and_leaves_no_trace() uses (evm: mut Evm) {
    let s = deploy()
    let now = evm.timestamp()
    let good = valid(now)
    assert!(try_create(s, good, ether(6)), "positive control")
    let owed = ether(6)

    var a = good
    a.provider = Address::zero()
    assert!(!try_create(s, a, ether(6)), "provider is zero")
    a = good
    a.verifier = Address::zero()
    assert!(!try_create(s, a, ether(6)), "verifier is zero")
    a = good
    a.provider = evm.address()
    assert!(!try_create(s, a, ether(6)), "client is provider")
    a = good
    a.verifier = evm.address()
    assert!(!try_create(s, a, ether(6)), "client is verifier")
    a = good
    a.verifier = good.provider
    assert!(!try_create(s, a, ether(6)), "provider is verifier")
    a = good
    a.provider = Address::zero()
    a.verifier = Address::zero()
    assert!(!try_create(s, a, ether(6)), "both zero")
    a = good
    a.provider = evm.address()
    a.verifier = evm.address()
    assert!(!try_create(s, a, ether(6)), "all three the same")

    assert_untouched(s, 1, owed, Wei::zero())
    check_invariants(s, 1, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn rejects_a_milestone_count_outside_one_to_three() uses (evm: mut Evm) {
    let s = deploy()
    let now = evm.timestamp()
    let good = valid(now)
    assert!(try_create(s, good, ether(6)), "positive control")

    var a = good
    a.n = 0
    assert!(!try_create(s, a, Wei::zero()), "n = 0")
    assert!(!try_create(s, a, ether(6)), "n = 0 with value")
    a.n = 4
    assert!(!try_create(s, a, ether(6)), "n = 4")
    a.n = 255
    assert!(!try_create(s, a, ether(6)), "n = 255")

    assert_untouched(s, 1, ether(6), Wei::zero())
    check_invariants(s, 1, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn rejects_non_empty_unused_slots() uses (evm: mut Evm) {
    let s = deploy()
    let now = evm.timestamp()
    let zero_t = Timestamp::from_seconds(0)

    // n = 1 with a clean slot 1 and 2 is the positive control.
    var one = valid(now)
    one.n = 1
    one.amounts = [ether(1), Wei::zero(), Wei::zero()]
    one.deliver_by = [at(now, 100), zero_t, zero_t]
    one.specs = [0x51, 0, 0]
    assert!(try_create(s, one, ether(1)), "positive control")
    let owed = ether(1)

    var a = one
    a.amounts = [ether(1), wei(1), Wei::zero()]
    assert!(
        !try_create(s, a, ether(1) + wei(1)),
        "slot 1 has an amount",
    )
    a = one
    a.specs = [0x51, 7, 0]
    assert!(!try_create(s, a, ether(1)), "slot 1 has a spec")
    a = one
    a.deliver_by = [at(now, 100), at(now, 100), zero_t]
    assert!(!try_create(s, a, ether(1)), "slot 1 has a deadline")
    a = one
    a.amounts = [ether(1), Wei::zero(), wei(1)]
    assert!(
        !try_create(s, a, ether(1) + wei(1)),
        "slot 2 has an amount",
    )
    a = one
    a.specs = [0x51, 0, 7]
    assert!(!try_create(s, a, ether(1)), "slot 2 has a spec")
    a = one
    a.deliver_by = [at(now, 100), zero_t, at(now, 100)]
    assert!(!try_create(s, a, ether(1)), "slot 2 has a deadline")

    // n = 2 with a dirty slot 2.
    var two = valid(now)
    two.n = 2
    two.amounts = [ether(1), ether(2), wei(1)]
    two.specs = [0x51, 0x52, 0]
    two.deliver_by = [at(now, 100), at(now, 200), zero_t]
    assert!(
        !try_create(s, two, ether(3) + wei(1)),
        "n = 2 with an amount in slot 2",
    )

    assert_untouched(s, 1, owed, Wei::zero())
    check_invariants(s, 1, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn rejects_zero_amount_or_zero_spec_in_any_used_slot() uses (evm: mut Evm) {
    let s = deploy()
    let now = evm.timestamp()
    let good = valid(now)
    assert!(try_create(s, good, ether(6)), "positive control")

    var k: u8 = 0
    while k < 3 {
        let i = k as usize
        var a = good
        var amounts = good.amounts
        amounts[i] = Wei::zero()
        a.amounts = amounts
        assert!(
            !try_create(s, a, total_of(a)),
            "zero amount in a used slot",
        )

        var b = good
        var specs = good.specs
        specs[i] = 0
        b.specs = specs
        assert!(!try_create(s, b, ether(6)), "zero spec in a used slot")
        k += 1
    }
    assert_untouched(s, 1, ether(6), Wei::zero())
    check_invariants(s, 1, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn enforces_deliver_by_strictly_after_the_production_clock()
uses (evm: mut Evm)
{
    let s = deploy()
    let now = evm.timestamp()

    // Boundary: deliver_by == now is rejected, now + 1 is accepted (docs/LIFECYCLE.md DE).
    var a = valid(now)
    a.n = 1
    a.amounts = [ether(1), Wei::zero(), Wei::zero()]
    a.specs = [0x51, 0, 0]
    a.deliver_by = [now, Timestamp::from_seconds(0), Timestamp::from_seconds(0)]
    assert!(!try_create(s, a, ether(1)), "deliver_by == now")
    a.deliver_by = [
        Timestamp::from_seconds(now.as_seconds() - 1),
        Timestamp::from_seconds(0),
        Timestamp::from_seconds(0),
    ]
    assert!(!try_create(s, a, ether(1)), "deliver_by == now - 1")
    a.deliver_by = [
        Timestamp::from_seconds(0),
        Timestamp::from_seconds(0),
        Timestamp::from_seconds(0),
    ]
    assert!(!try_create(s, a, ether(1)), "deliver_by == 0")
    assert_untouched(s, 0, Wei::zero(), Wei::zero())

    a.deliver_by = [at(now, 1), Timestamp::from_seconds(0), Timestamp::from_seconds(0)]
    assert!(
        try_create(s, a, ether(1)),
        "deliver_by == now + 1 is the accepted boundary",
    )
    assert!(milestone(s, 1, 0).2 == at(now, 1))

    // Every used slot is checked, not only the first.
    var b = valid(now)
    b.deliver_by = [at(now, 100), at(now, 200), now]
    assert!(!try_create(s, b, ether(6)), "third deadline == now")
    b.deliver_by = [at(now, 100), now, at(now, 300)]
    assert!(!try_create(s, b, ether(6)), "second deadline == now")
    b.deliver_by = [at(now, 100), at(now, 200), at(now, 300)]
    assert!(try_create(s, b, ether(6)), "all deadlines after now")

    // Deadlines need not be ordered, and are stored as given (immutable once created).
    var c = valid(now)
    c.deliver_by = [at(now, 300), at(now, 100), at(now, 200)]
    assert!(
        try_create(s, c, ether(6)),
        "unordered deadlines are allowed",
    )
    assert!(
        milestone(s, 3, 0).2 == at(now, 300) && milestone(s, 3, 1).2 == at(now, 100),
    )
    check_invariants(s, 3, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn rejects_a_zero_review_period() uses (evm: mut Evm) {
    let s = deploy()
    let now = evm.timestamp()
    var a = valid(now)
    a.review_period = seconds(1)
    assert!(
        try_create(s, a, ether(6)),
        "positive control: one second is the minimum",
    )
    a.review_period = Duration::zero()
    assert!(!try_create(s, a, ether(6)), "zero review period")
    assert_untouched(s, 1, ether(6), Wei::zero())
    check_invariants(s, 1, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn requires_exact_funding() uses (evm: mut Evm) {
    let s = deploy()
    let now = evm.timestamp()
    let a = valid(now)
    assert!(
        try_create(s, a, ether(6)),
        "positive control: exactly 6 ETH",
    )
    let owed = ether(6)

    assert!(!try_create(s, a, ether(6) - wei(1)), "one wei too little")
    assert!(!try_create(s, a, ether(6) + wei(1)), "one wei too much")
    assert!(!try_create(s, a, Wei::zero()), "no value")
    assert!(!try_create(s, a, ether(3)), "half")
    assert!(!try_create(s, a, ether(12)), "double")

    // n = 2 must be funded with the first two amounts only.
    var b = a
    b.n = 2
    b.amounts = [ether(1), ether(2), Wei::zero()]
    b.deliver_by = [at(now, 100), at(now, 200), Timestamp::from_seconds(0)]
    b.specs = [0x51, 0x52, 0]
    assert!(!try_create(s, b, ether(6)), "value for three funds two")
    assert!(!try_create(s, b, ether(1)), "value for one funds two")
    assert_untouched(s, 1, owed, Wei::zero())
    check_invariants(s, 1, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn rejects_arithmetic_overflow_in_the_amount_sum() uses (evm: mut Evm) {
    let s = deploy()
    let now = evm.timestamp()
    var a = valid(now)
    a.n = 2
    a.amounts = [wei(MAX), wei(1), Wei::zero()]
    a.deliver_by = [at(now, 100), at(now, 200), Timestamp::from_seconds(0)]
    a.specs = [0x51, 0x52, 0]
    assert!(
        !try_create(s, a, ether(1)),
        "MAX + 1 overflows the sum (Panic 0x11)",
    )
    assert!(!try_create(s, a, Wei::zero()), "overflow with no value")
    assert_untouched(s, 0, Wei::zero(), Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn rejects_decide_by_overflow_and_accepts_the_exact_boundary()
uses (evm: mut Evm)
{
    let s = deploy()
    let now = evm.timestamp()
    var a = valid(now)
    a.n = 1
    a.review_period = seconds(1000)
    a.amounts = [ether(1), Wei::zero(), Wei::zero()]
    a.specs = [0x51, 0, 0]

    // deliver_by + review_period == MAX fits, one more second does not.
    a.deliver_by = [
        Timestamp::from_seconds(MAX - 1000),
        Timestamp::from_seconds(0),
        Timestamp::from_seconds(0),
    ]
    assert!(
        try_create(s, a, ether(1)),
        "decide_by == MAX is the accepted boundary",
    )
    assert!(
        milestone(s, 1, 0).3.as_seconds() == MAX,
        "decide_by stored exactly",
    )
    a.deliver_by = [
        Timestamp::from_seconds(MAX - 999),
        Timestamp::from_seconds(0),
        Timestamp::from_seconds(0),
    ]
    assert!(!try_create(s, a, ether(1)), "decide_by would overflow")
    a.deliver_by = [
        Timestamp::from_seconds(MAX),
        Timestamp::from_seconds(0),
        Timestamp::from_seconds(0),
    ]
    assert!(!try_create(s, a, ether(1)), "deliver_by == MAX overflows")
    assert_untouched(s, 1, ether(1), Wei::zero())
    check_invariants(s, 1, Wei::zero())
}

// ------------------------------------------------- every slot against the same clock (R-003)

#[test(balance = 100_000_000_000_000_000_000)]
fn every_slot_of_a_two_milestone_agreement_is_judged_against_the_same_clock()
uses (evm: mut Evm)
{
    let s = deploy()
    let now = evm.timestamp()
    let zero_t = Timestamp::from_seconds(0)
    let before = Timestamp::from_seconds(now.as_seconds() - 1)
    var a = valid(now)
    a.n = 2
    a.amounts = [ether(1), ether(2), Wei::zero()]
    a.specs = [0x51, 0x52, 0]

    // Both slots one second ahead: accepted. This is the positive control for every case below.
    a.deliver_by = [at(now, 1), at(now, 1), zero_t]
    assert!(try_create(s, a, ether(3)), "both slots now + 1")
    // One bad slot sinks the agreement, in either position and on either side of `now`.
    a.deliver_by = [now, at(now, 1), zero_t]
    assert!(!try_create(s, a, ether(3)), "slot 0 == now")
    a.deliver_by = [at(now, 1), now, zero_t]
    assert!(!try_create(s, a, ether(3)), "slot 1 == now")
    a.deliver_by = [before, at(now, 1), zero_t]
    assert!(!try_create(s, a, ether(3)), "slot 0 == now - 1")
    a.deliver_by = [at(now, 1), before, zero_t]
    assert!(!try_create(s, a, ether(3)), "slot 1 == now - 1")
    a.deliver_by = [zero_t, at(now, 1), zero_t]
    assert!(!try_create(s, a, ether(3)), "slot 0 == 0")
    a.deliver_by = [at(now, 1), zero_t, zero_t]
    assert!(!try_create(s, a, ether(3)), "slot 1 == 0")
    assert_untouched(s, 1, ether(3), Wei::zero())

    // The boundary is the same for both slots: now + 1 is accepted in either order.
    a.deliver_by = [at(now, 2), at(now, 1), zero_t]
    assert!(
        try_create(s, a, ether(3)),
        "slot 1 == now + 1, slot 0 later",
    )
    a.deliver_by = [at(now, 1), at(now, 2), zero_t]
    assert!(
        try_create(s, a, ether(3)),
        "slot 0 == now + 1, slot 1 later",
    )
    assert!(
        milestone(s, 2, 1).2 == at(now, 1) && milestone(s, 3, 0).2 == at(now, 1),
    )
    check_invariants(s, 3, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn the_boundary_holds_in_every_slot_of_a_three_milestone_agreement()
uses (evm: mut Evm)
{
    let s = deploy()
    let now = evm.timestamp()
    var k: u8 = 0
    var created: u256 = 0
    while k < 3 {
        let i = k as usize
        // `now` in slot k only (the others far ahead) is rejected, `now + 1` is accepted.
        var late = [at(now, 100), at(now, 200), at(now, 300)]
        late[i] = now
        var a = valid(now)
        a.deliver_by = late
        assert!(!try_create(s, a, ether(6)), "slot k == now")
        late[i] = Timestamp::from_seconds(now.as_seconds() - 1)
        a.deliver_by = late
        assert!(!try_create(s, a, ether(6)), "slot k == now - 1")
        assert_untouched(s, created, ether(6) * created, Wei::zero())

        late[i] = at(now, 1)
        a.deliver_by = late
        assert!(try_create(s, a, ether(6)), "slot k == now + 1")
        created += 1
        assert!(
            milestone(s, created, k).2 == at(now, 1),
            "the boundary deadline is stored as given",
        )
        k += 1
    }
    assert!(created == 3 && outstanding(s) == ether(18))
    check_invariants(s, 3, Wei::zero())
}

// ------------------------------------------------ Phase 2B: callers without a role

#[test(balance = 100_000_000_000_000_000_000)]
fn a_caller_with_no_role_cannot_submit_approve_or_reject_and_changes_nothing()
uses (evm: mut Evm)
{
    let s = deploy()
    let now = evm.timestamp()
    assert!(
        create(s, valid(now), ether(6)) == 1,
        "positive control: the agreement exists",
    )
    let before0 = milestone(s, 1, 0)
    let before1 = milestone(s, 1, 1)
    let before2 = milestone(s, 1, 2)
    var m: u8 = 0
    while m < 3 {
        // The test contract is the client: not the provider, not the verifier.
        assert!(
            because(submit_as_client(s, 1, m, 0xe1), Why::NotProvider),
            "client cannot submit",
        )
        assert!(
            because(approve_as_client(s, 1, m, 0xe1), Why::NotVerifier),
            "client cannot approve",
        )
        assert!(
            because(reject_as_client(s, 1, m, 0xe1), Why::NotVerifier),
            "client cannot reject",
        )
        m += 1
    }
    assert!(same_milestone(milestone(s, 1, 0), before0))
    assert!(same_milestone(milestone(s, 1, 1), before1))
    assert!(same_milestone(milestone(s, 1, 2), before2))
    assert_untouched(s, 1, ether(6), Wei::zero())
    check_invariants(s, 1, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn transitions_on_an_unknown_agreement_are_rejected_for_any_caller()
uses (evm: mut Evm)
{
    let s = deploy()
    // Nothing exists yet: ids 0 and 1 are unknown. The agreement check comes before the role check.
    assert!(
        because(submit_as_client(s, 0, 0, 0xe1), Why::UnknownAgreement),
        "submit on id 0",
    )
    assert!(
        because(approve_as_client(s, 0, 0, 0xe1), Why::UnknownAgreement),
        "approve on id 0",
    )
    assert!(
        because(reject_as_client(s, 0, 0, 0xe1), Why::UnknownAgreement),
        "reject on id 0",
    )
    assert!(
        because(submit_as_client(s, 1, 0, 0xe1), Why::UnknownAgreement),
        "submit before any agreement",
    )
    assert!(
        because(approve_as_client(s, 1, 0, 0xe1), Why::UnknownAgreement),
    )
    assert!(
        because(reject_as_client(s, 1, 0, 0xe1), Why::UnknownAgreement),
    )

    let now = evm.timestamp()
    var a = valid(now)
    a.n = 1
    a.amounts = [ether(1), Wei::zero(), Wei::zero()]
    a.deliver_by = [at(now, 100), Timestamp::from_seconds(0), Timestamp::from_seconds(0)]
    a.specs = [0x51, 0, 0]
    assert!(
        create(s, a, ether(1)) == 1,
        "positive control: agreement 1 now exists",
    )
    // Positive control for the reason itself: on the known agreement the reason is the ROLE.
    assert!(
        because(submit_as_client(s, 1, 0, 0xe1), Why::NotProvider),
        "known agreement: a role problem",
    )
    assert!(
        because(submit_as_client(s, 2, 0, 0xe1), Why::UnknownAgreement),
        "id 2 is unknown",
    )
    assert!(
        because(approve_as_client(s, 2, 0, 0xe1), Why::UnknownAgreement),
    )
    assert!(
        because(reject_as_client(s, 2, 0, 0xe1), Why::UnknownAgreement),
    )
    assert!(
        because(submit_as_client(s, MAX, 0, 0xe1), Why::UnknownAgreement),
        "id 2^256 - 1",
    )
    assert!(
        because(approve_as_client(s, MAX, 0, 0xe1), Why::UnknownAgreement),
    )
    assert!(
        because(reject_as_client(s, MAX, 0, 0xe1), Why::UnknownAgreement),
    )
    // An unused slot of a known agreement: the role is checked before the slot.
    assert!(
        because(submit_as_client(s, 1, 1, 0xe1), Why::NotProvider),
        "slot 1 is unused, role first",
    )
    assert!(milestone(s, 1, 0).0 == 1, "nothing changed")
    assert_untouched(s, 1, ether(1), Wei::zero())
    check_invariants(s, 1, Wei::zero())
}

// ------------------------------------------------------------------- unknown ids

#[test(balance = 100_000_000_000_000_000_000)]
fn unknown_agreement_ids_revert_or_read_as_none() uses (evm: mut Evm) {
    let s = deploy()
    // Nothing created yet: ids 0 and 1 are unknown.
    assert!(!exists(s, 0), "id 0 is never valid")
    assert!(!exists(s, 1))
    assert!(!exists(s, MAX))
    assert!(
        !evm.try_call(
            addr: s,
            gas: 100000,
            value: Wei::zero(),
            message: SettleMsg::GetAccounting { id: 0 },
        )
            .success(),
    )
    assert!(
        !evm.try_call(
            addr: s,
            gas: 100000,
            value: Wei::zero(),
            message: SettleMsg::GetAccounting { id: 1 },
        )
            .success(),
    )
    // A milestone of an unknown agreement reads as None, all zero (D-017).
    let none = milestone(s, 1, 0)
    assert!(
        none.0 == 0
            && none.1 == Wei::zero()
            && none.2.as_seconds() == 0
            && none.3.as_seconds() == 0,
    )
    assert!(none.4 == 0 && none.5 == 0)
    assert!(milestone(s, 0, 0).0 == 0)
    assert!(outstanding(s) == Wei::zero())

    let now = evm.timestamp()
    var a = valid(now)
    a.n = 1
    a.amounts = [ether(1), Wei::zero(), Wei::zero()]
    a.deliver_by = [at(now, 100), Timestamp::from_seconds(0), Timestamp::from_seconds(0)]
    a.specs = [0x51, 0, 0]
    assert!(create(s, a, ether(1)) == 1, "positive control")

    assert!(exists(s, 1))
    assert!(!exists(s, 0))
    assert!(!exists(s, 2))
    assert!(!exists(s, MAX))
    assert!(
        !evm.try_call(
            addr: s,
            gas: 100000,
            value: Wei::zero(),
            message: SettleMsg::GetAccounting { id: 2 },
        )
            .success(),
    )
    assert!(
        milestone(s, 2, 0).0 == 0,
        "unknown agreement 2 reads as None",
    )
    // Unused slots of a known agreement read as None, including slots beyond 2.
    assert!(milestone(s, 1, 1).0 == 0)
    assert!(milestone(s, 1, 2).0 == 0)
    assert!(milestone(s, 1, 3).0 == 0)
    assert!(milestone(s, 1, 255).0 == 0)
    assert!(milestone(s, 1, 0).0 == 1, "slot 0 is Funded")
    check_invariants(s, 1, Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn only_create_is_payable() uses (evm: mut Evm) {
    let s = deploy()
    let now = evm.timestamp()
    var a = valid(now)
    a.n = 1
    a.amounts = [ether(1), Wei::zero(), Wei::zero()]
    a.deliver_by = [at(now, 100), Timestamp::from_seconds(0), Timestamp::from_seconds(0)]
    a.specs = [0x51, 0, 0]
    assert!(create(s, a, ether(1)) == 1, "positive control")

    // The same views succeed with no value, and are rejected when value is attached.
    assert!(
        evm.try_call(
            addr: s,
            gas: 100000,
            value: Wei::zero(),
            message: SettleMsg::GetAgreement { id: 1 },
        )
            .success(),
    )
    assert!(
        !evm.try_call(
            addr: s,
            gas: 100000,
            value: wei(1),
            message: SettleMsg::GetAgreement { id: 1 },
        )
            .success(),
    )
    assert!(
        !evm.try_call(
            addr: s,
            gas: 100000,
            value: wei(1),
            message: SettleMsg::GetMilestone { id: 1, m: 0 },
        )
            .success(),
    )
    assert!(
        !evm.try_call(
            addr: s,
            gas: 100000,
            value: wei(1),
            message: SettleMsg::GetAccounting { id: 1 },
        )
            .success(),
    )
    assert!(
        !evm.try_call(
            addr: s,
            gas: 100000,
            value: wei(1),
            message: SettleMsg::TotalOutstanding {},
        )
            .success(),
    )
    assert!(evm.balance(s) == ether(1), "rejected value was not kept")
    check_invariants(s, 1, Wei::zero())
}

// ------------------------------------------------------------------ surplus ETH (I9)

// I9 is `balance >= outstanding`, not equality (R-002). ETH can reach the contract without an
// agreement: it has no `receive`, but its address is predictable, and an address with no code
// accepts ETH, so a test can send ETH to it BEFORE deploying there. (On a live chain the same
// happens through selfdestruct or a coinbase reward.) Nothing in the contract can claim it.
#[test(balance = 100_000_000_000_000_000_000)]
fn surplus_eth_keeps_balance_at_or_above_outstanding_and_is_never_owed()
uses (evm: mut Evm)
{
    let predicted = predict_create2<Settlane>(deployer: evm.address(), args: (), salt: 1)
    assert!(
        evm.send_value(addr: predicted, gas: 100000, value: ether(2)).success(),
        "positive control: a code-less address accepts ETH",
    )
    let s = deploy()
    assert!(
        s == predicted,
        "positive control: the prediction was right, so the ETH is in this contract",
    )
    assert!(
        evm.balance(s) == ether(2),
        "the surplus arrived before any agreement",
    )
    assert!(
        outstanding(s) == Wei::zero(),
        "the surplus is not owed to anyone",
    )
    check_invariants(s, 0, ether(2))

    let now = evm.timestamp()
    let a = valid(now)
    assert!(create(s, a, ether(6)) == 1)
    assert!(
        evm.balance(s) == ether(8),
        "8 ETH held: 6 owed, 2 surplus",
    )
    assert!(
        outstanding(s) == ether(6),
        "outstanding counts only the agreement",
    )
    assert!(
        accounting(s, 1).0 == ether(6) && accounting(s, 1).3 == ether(6),
        "the surplus is in no agreement",
    )
    check_invariants(s, 1, ether(2))

    // Rejected calls leave both the owed amount and the surplus exactly as they were.
    assert!(!try_create(s, a, ether(6) + wei(1)), "one wei too much")
    assert!(
        !try_create(s, a, ether(8)),
        "funding with the surplus amount is still a mismatch",
    )
    assert_untouched(s, 1, ether(6), ether(2))

    // A second agreement: the surplus stays out of both agreements and the total.
    var b = a
    b.n = 1
    b.amounts = [ether(1), Wei::zero(), Wei::zero()]
    b.deliver_by = [at(now, 100), Timestamp::from_seconds(0), Timestamp::from_seconds(0)]
    b.specs = [0x51, 0, 0]
    assert!(create(s, b, ether(1)) == 2)
    assert!(outstanding(s) == ether(7) && evm.balance(s) == ether(9))
    check_invariants(s, 2, ether(2))
}

// ------------------------------------------------------------ pure rules (no EVM)

fn rule_code(_ a: Args, _ client: Address, _ value: Wei, _ now: Timestamp) -> u8 {
    rules::check_code(
        rules::check_create(
            client,
            provider: a.provider,
            verifier: a.verifier,
            review_period: a.review_period,
            n: a.n,
            amounts: a.amounts,
            deliver_by: a.deliver_by,
            specs: a.specs,
            value,
            now,
        ),
    )
}

#[test]
fn rules_accept_a_valid_agreement_and_report_each_failure() {
    let now = Timestamp::from_seconds(1000)
    let client = Address::new(0xc1)
    let a = valid(now)
    assert!(rule_code(a, client, ether(6), now) == 0, "valid")

    // Parties
    var b = a
    b.provider = Address::zero()
    assert!(rule_code(b, client, ether(6), now) == 1, "ProviderZero")
    b = a
    b.verifier = Address::zero()
    assert!(rule_code(b, client, ether(6), now) == 2, "VerifierZero")
    b = a
    b.provider = client
    assert!(
        rule_code(b, client, ether(6), now) == 3,
        "ClientIsProvider",
    )
    b = a
    b.verifier = client
    assert!(
        rule_code(b, client, ether(6), now) == 4,
        "ClientIsVerifier",
    )
    b = a
    b.verifier = a.provider
    assert!(
        rule_code(b, client, ether(6), now) == 5,
        "ProviderIsVerifier",
    )
    // Count
    b = a
    b.n = 0
    assert!(
        rule_code(b, client, ether(6), now) == 6,
        "BadMilestoneCount 0",
    )
    b.n = 4
    assert!(
        rule_code(b, client, ether(6), now) == 6,
        "BadMilestoneCount 4",
    )
    b = a
    b.n = 2
    b.amounts = [ether(1), ether(2), wei(1)]
    assert!(
        rule_code(b, client, ether(3), now) == 7,
        "UnusedSlotNotEmpty",
    )
    // Amounts
    b = a
    b.amounts = [Wei::zero(), ether(2), ether(3)]
    assert!(rule_code(b, client, ether(5), now) == 8, "ZeroAmount")
    b = a
    b.n = 2
    b.amounts = [wei(MAX), wei(1), Wei::zero()]
    b.deliver_by = [at(now, 100), at(now, 200), Timestamp::from_seconds(0)]
    b.specs = [0x51, 0x52, 0]
    assert!(
        rule_code(b, client, Wei::zero(), now) == 9,
        "AmountSumOverflow",
    )
    assert!(
        rule_code(a, client, ether(6) + wei(1), now) == 10,
        "ValueMismatch +1",
    )
    assert!(
        rule_code(a, client, ether(6) - wei(1), now) == 10,
        "ValueMismatch -1",
    )
    // Time
    b = a
    b.deliver_by = [at(now, 100), now, at(now, 300)]
    assert!(
        rule_code(b, client, ether(6), now) == 11,
        "DeliveryNotInFuture",
    )
    b = a
    b.review_period = Duration::zero()
    assert!(
        rule_code(b, client, ether(6), now) == 12,
        "ZeroReviewPeriod",
    )
    b = a
    b.deliver_by = [at(now, 100), at(now, 200), Timestamp::from_seconds(MAX)]
    assert!(
        rule_code(b, client, ether(6), now) == 13,
        "DecideByOverflow",
    )
    // Spec
    b = a
    b.specs = [0x51, 0, 0x53]
    assert!(rule_code(b, client, ether(6), now) == 14, "ZeroSpec")
}

#[test]
fn rules_overflow_cases_are_explicit_rules_and_never_panic() {
    let now = Timestamp::from_seconds(1000)
    let client = Address::new(0xc1)
    // The amount sum: MAX + 1 is reported (code 9), and MAX - 1 + 1 == MAX is exactly funded.
    var a = valid(now)
    a.n = 2
    a.amounts = [wei(MAX), wei(1), Wei::zero()]
    a.deliver_by = [at(now, 100), at(now, 200), Timestamp::from_seconds(0)]
    a.specs = [0x51, 0x52, 0]
    assert!(
        rule_code(a, client, wei(MAX), now) == 9,
        "MAX + 1 overflows",
    )
    a.amounts = [wei(MAX - 1), wei(1), Wei::zero()]
    assert!(
        rule_code(a, client, wei(MAX), now) == 0,
        "MAX - 1 + 1 is exactly MAX",
    )
    // The decide_by window: deliver_by + review_period == MAX fits, one more does not.
    var b = valid(now)
    b.n = 1
    b.amounts = [ether(1), Wei::zero(), Wei::zero()]
    b.specs = [0x51, 0, 0]
    b.review_period = seconds(1000)
    b.deliver_by = [
        Timestamp::from_seconds(MAX - 1000),
        Timestamp::from_seconds(0),
        Timestamp::from_seconds(0),
    ]
    assert!(
        rule_code(b, client, ether(1), now) == 0,
        "decide_by == MAX fits",
    )
    b.deliver_by = [
        Timestamp::from_seconds(MAX - 999),
        Timestamp::from_seconds(0),
        Timestamp::from_seconds(0),
    ]
    assert!(
        rule_code(b, client, ether(1), now) == 13,
        "decide_by would wrap",
    )
}

#[test]
fn rules_run_stage_by_stage_in_the_lifecycle_order() {
    // docs/LIFECYCLE.md lists Parties, Count, Amounts, Time, Spec. Each case puts a fault of a
    // LATER stage in an EARLIER slot and a fault of an EARLIER stage in a LATER slot: the
    // earlier stage must win. (Checking slot by slot would report the later stage here.)
    let now = Timestamp::from_seconds(1000)
    let client = Address::new(0xc1)
    let zero_t = Timestamp::from_seconds(0)

    // Amounts before Spec: slot 0 has no spec, slot 2 has no amount.
    var a = valid(now)
    a.specs = [0, 0x52, 0x53]
    a.amounts = [ether(1), ether(2), Wei::zero()]
    assert!(
        rule_code(a, client, ether(3), now) == 8,
        "zero amount (slot 2) before zero spec (slot 0)",
    )
    // Amounts before Time: slot 0 deadline is not in the future, slot 2 has no amount.
    a = valid(now)
    a.deliver_by = [now, at(now, 200), at(now, 300)]
    a.amounts = [ether(1), ether(2), Wei::zero()]
    assert!(
        rule_code(a, client, ether(3), now) == 8,
        "zero amount before a past deadline",
    )
    // Funding before Time: the value is wrong and slot 0's deadline is not in the future.
    a = valid(now)
    a.deliver_by = [now, at(now, 200), at(now, 300)]
    assert!(
        rule_code(a, client, ether(5), now) == 10,
        "value mismatch before a past deadline",
    )
    // Time before Spec: slot 0 has no spec, slot 2's deadline is not in the future.
    a = valid(now)
    a.specs = [0, 0x52, 0x53]
    a.deliver_by = [at(now, 100), at(now, 200), now]
    assert!(
        rule_code(a, client, ether(6), now) == 11,
        "past deadline (slot 2) before zero spec (slot 0)",
    )
    // Review period before Spec, and decide_by overflow before Spec.
    a = valid(now)
    a.specs = [0, 0x52, 0x53]
    a.review_period = Duration::zero()
    assert!(
        rule_code(a, client, ether(6), now) == 12,
        "zero review period before zero spec",
    )
    a = valid(now)
    a.n = 1
    a.amounts = [ether(1), Wei::zero(), Wei::zero()]
    a.specs = [0, 0, 0]
    a.review_period = seconds(6)
    a.deliver_by = [Timestamp::from_seconds(MAX - 5), zero_t, zero_t]
    assert!(
        rule_code(a, client, ether(1), now) == 13,
        "decide_by overflow before zero spec",
    )
    // Count before Amounts: a dirty unused slot 2 and a zero amount in slot 0.
    a = valid(now)
    a.n = 2
    a.amounts = [Wei::zero(), ether(2), wei(1)]
    assert!(
        rule_code(a, client, ether(2), now) == 7,
        "unused slot before zero amount",
    )
    // The sum overflow is reported before the value is compared.
    a = valid(now)
    a.n = 2
    a.amounts = [wei(MAX), wei(1), Wei::zero()]
    a.deliver_by = [at(now, 100), at(now, 200), Timestamp::from_seconds(0)]
    a.specs = [0x51, 0x52, 0]
    assert!(
        rule_code(a, client, Wei::zero(), now) == 9,
        "sum overflow before value mismatch",
    )
}

#[test]
fn rules_report_the_first_failure_in_a_fixed_order() {
    let now = Timestamp::from_seconds(1000)
    let client = Address::new(0xc1)
    // Several faults at once, fixed one stage at a time: Parties, Count, Amounts (funding),
    // Time (review period), Spec.
    var a = valid(now)
    a.provider = Address::zero()
    a.n = 0
    a.review_period = Duration::zero()
    a.specs = [0, 0, 0]
    assert!(
        rule_code(a, client, Wei::zero(), now) == 1,
        "parties first",
    )
    a.provider = Address::new(0xa1)
    assert!(rule_code(a, client, Wei::zero(), now) == 6, "then count")
    a.n = 3
    assert!(
        rule_code(a, client, Wei::zero(), now) == 10,
        "then funding",
    )
    assert!(
        rule_code(a, client, ether(6), now) == 12,
        "then the review period",
    )
    a.review_period = seconds(10)
    assert!(
        rule_code(a, client, ether(6), now) == 14,
        "then the specs",
    )
    a.specs = [0x51, 0x52, 0x53]
    assert!(rule_code(a, client, ether(6), now) == 0, "all fixed")
}

#[test]
fn rules_deadline_boundaries_at_d_minus_1_d_and_d_plus_1() {
    let now = Timestamp::from_seconds(1000)
    let client = Address::new(0xc1)
    var a = valid(now)
    a.n = 1
    a.amounts = [ether(1), Wei::zero(), Wei::zero()]
    a.specs = [0x51, 0, 0]
    let zero_t = Timestamp::from_seconds(0)
    a.deliver_by = [Timestamp::from_seconds(999), zero_t, zero_t]
    assert!(rule_code(a, client, ether(1), now) == 11, "d = now - 1")
    a.deliver_by = [Timestamp::from_seconds(1000), zero_t, zero_t]
    assert!(rule_code(a, client, ether(1), now) == 11, "d = now")
    a.deliver_by = [Timestamp::from_seconds(1001), zero_t, zero_t]
    assert!(rule_code(a, client, ether(1), now) == 0, "d = now + 1")

    // The same boundary expressed as the open predicate used by later phases.
    let d = Timestamp::from_seconds(1000)
    assert!(
        rules::delivery_open(now: Timestamp::from_seconds(999), deliver_by: d),
    )
    assert!(
        !rules::delivery_open(now: Timestamp::from_seconds(1000), deliver_by: d),
    )
    assert!(
        !rules::delivery_open(now: Timestamp::from_seconds(1001), deliver_by: d),
    )
}

#[test]
fn rules_judge_every_used_slot_against_the_same_now() {
    let now = Timestamp::from_seconds(1000)
    let client = Address::new(0xc1)
    let zero_t = Timestamp::from_seconds(0)
    // n = 2 and n = 3. One slot at a time sits on the boundary (now - 1, now, now + 1) while the
    // others are far ahead. A slot is rejected at now - 1 and now, accepted at now + 1, whatever
    // its index. (A clock that shifted with the slot index would pass slot 0 and fail slot 2.)
    var n: u8 = 2
    while n <= 3 {
        var k: u8 = 0
        while k < n {
            let i = k as usize
            var a = valid(now)
            a.n = n
            var amounts = [ether(1), ether(2), ether(3)]
            var specs = [0x51, 0x52, 0x53]
            var due = [at(now, 100), at(now, 200), at(now, 300)]
            if n == 2 {
                amounts[2] = Wei::zero()
                specs[2] = 0
                due[2] = zero_t
            }
            a.amounts = amounts
            a.specs = specs
            let value = if n == 2 { ether(3) } else { ether(6) }
            due[i] = Timestamp::from_seconds(999)
            a.deliver_by = due
            assert!(
                rule_code(a, client, value, now) == 11,
                "slot k == now - 1",
            )
            due[i] = Timestamp::from_seconds(1000)
            a.deliver_by = due
            assert!(rule_code(a, client, value, now) == 11, "slot k == now")
            due[i] = Timestamp::from_seconds(1001)
            a.deliver_by = due
            assert!(rule_code(a, client, value, now) == 0, "slot k == now + 1")
            k += 1
        }
        n += 1
    }
}

fn submit_code_of(
    _ exists: bool,
    _ caller: Address,
    _ state: MilestoneState,
    _ deliver_by: u256,
    _ now: u256,
    _ evidence: u256,
) -> u8 {
    rules::submit_code(
        rules::check_submit(
            agreement_exists: exists,
            caller,
            provider: Address::new(0xa1),
            state,
            deliver_by: Timestamp::from_seconds(deliver_by),
            now: Timestamp::from_seconds(now),
            evidence,
        ),
    )
}

fn review_code_of(
    _ exists: bool,
    _ caller: Address,
    _ state: MilestoneState,
    _ decide_by: u256,
    _ now: u256,
    _ stored: u256,
    _ evidence: u256,
) -> u8 {
    rules::review_code(
        rules::check_review(
            agreement_exists: exists,
            caller,
            verifier: Address::new(0xa2),
            state,
            decide_by: Timestamp::from_seconds(decide_by),
            now: Timestamp::from_seconds(now),
            stored_evidence: stored,
            evidence,
            stored_revision: 1,
            revision: 1,
        ),
    )
}

#[test]
fn rules_submit_reports_each_failure_and_accepts_a_valid_submission() {
    let p = Address::new(0xa1)
    let other = Address::new(0xc1)
    // base: the provider submits nonzero evidence for a Funded milestone due at 2000, at time 1000.
    assert!(
        submit_code_of(true, p, MilestoneState::Funded, 2000, 1000, 7) == 0,
        "valid",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::Submitted, 2000, 1000, 7) == 0,
        "a resubmission is valid",
    )
    assert!(
        submit_code_of(false, p, MilestoneState::Funded, 2000, 1000, 7) == 1,
        "UnknownAgreement",
    )
    assert!(
        submit_code_of(true, other, MilestoneState::Funded, 2000, 1000, 7) == 2,
        "NotProvider",
    )
    assert!(
        submit_code_of(
                true,
                Address::new(0xa2),
                MilestoneState::Funded,
                2000,
                1000,
                7,
            ) == 2,
        "the verifier is not the provider",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::None, 2000, 1000, 7) == 3,
        "NoSuchMilestone",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::Approved, 2000, 1000, 7) == 4,
        "WrongState: Approved",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::Paid, 2000, 1000, 7) == 4,
        "WrongState: Paid",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::Refunded, 2000, 1000, 7) == 4,
        "WrongState: Refunded",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::Funded, 2000, 2000, 7) == 5,
        "DeliveryClosed at d",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::Funded, 2000, 2001, 7) == 5,
        "DeliveryClosed at d + 1",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::Funded, 2000, 1999, 7) == 0,
        "open at d - 1",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::Funded, 2000, 1000, 0) == 6,
        "ZeroEvidence",
    )
}

#[test]
fn rules_submit_checks_run_in_the_documented_order() {
    let p = Address::new(0xa1)
    let other = Address::new(0xc1)
    // Each pair puts a fault of a LATER rule alongside a fault of an EARLIER one: the earlier wins.
    assert!(
        submit_code_of(false, other, MilestoneState::None, 2000, 3000, 0) == 1,
        "agreement before role",
    )
    assert!(
        submit_code_of(true, other, MilestoneState::None, 2000, 3000, 0) == 2,
        "role before milestone",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::None, 2000, 3000, 0) == 3,
        "milestone before state, window and evidence",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::Approved, 2000, 3000, 0) == 4,
        "state before window and evidence",
    )
    assert!(
        submit_code_of(true, p, MilestoneState::Funded, 2000, 3000, 0) == 5,
        "window before evidence",
    )
}

#[test]
fn rules_review_reports_each_failure_and_accepts_a_valid_review() {
    let v = Address::new(0xa2)
    let other = Address::new(0xc1)
    // base: the verifier names the stored evidence 7 of a Submitted milestone, decide_by 5600, time 1000.
    assert!(
        review_code_of(true, v, MilestoneState::Submitted, 5600, 1000, 7, 7) == 0,
        "valid",
    )
    assert!(
        review_code_of(false, v, MilestoneState::Submitted, 5600, 1000, 7, 7) == 1,
        "UnknownAgreement",
    )
    assert!(
        review_code_of(true, other, MilestoneState::Submitted, 5600, 1000, 7, 7) == 2,
        "NotVerifier",
    )
    assert!(
        review_code_of(
                true,
                Address::new(0xa1),
                MilestoneState::Submitted,
                5600,
                1000,
                7,
                7,
            ) == 2,
        "the provider is not the verifier",
    )
    assert!(
        review_code_of(true, v, MilestoneState::None, 5600, 1000, 0, 7) == 3,
        "NoSuchMilestone",
    )
    assert!(
        review_code_of(true, v, MilestoneState::Funded, 5600, 1000, 0, 7) == 4,
        "NotSubmitted: Funded",
    )
    assert!(
        review_code_of(true, v, MilestoneState::Approved, 5600, 1000, 7, 7) == 4,
        "NotSubmitted: Approved (a replay)",
    )
    assert!(
        review_code_of(true, v, MilestoneState::Paid, 5600, 1000, 7, 7) == 4,
        "NotSubmitted: Paid",
    )
    assert!(
        review_code_of(true, v, MilestoneState::Refunded, 5600, 1000, 7, 7) == 4,
        "NotSubmitted: Refunded",
    )
    assert!(
        review_code_of(true, v, MilestoneState::Submitted, 5600, 5599, 7, 7) == 0,
        "open at decide_by - 1",
    )
    assert!(
        review_code_of(true, v, MilestoneState::Submitted, 5600, 5600, 7, 7) == 5,
        "ReviewClosed at decide_by",
    )
    assert!(
        review_code_of(true, v, MilestoneState::Submitted, 5600, 5601, 7, 7) == 5,
        "ReviewClosed at decide_by + 1",
    )
    assert!(
        review_code_of(true, v, MilestoneState::Submitted, 5600, 1000, 7, 8) == 6,
        "EvidenceMismatch",
    )
    assert!(
        review_code_of(true, v, MilestoneState::Submitted, 5600, 1000, 7, 0) == 6,
        "zero evidence never matches",
    )
}

#[test]
fn rules_review_checks_run_in_the_documented_order() {
    let v = Address::new(0xa2)
    let other = Address::new(0xc1)
    assert!(
        review_code_of(false, other, MilestoneState::None, 5600, 9000, 7, 9) == 1,
        "agreement before role",
    )
    assert!(
        review_code_of(true, other, MilestoneState::None, 5600, 9000, 7, 9) == 2,
        "role before milestone",
    )
    assert!(
        review_code_of(true, v, MilestoneState::None, 5600, 9000, 7, 9) == 3,
        "milestone before state",
    )
    assert!(
        review_code_of(true, v, MilestoneState::Funded, 5600, 9000, 7, 9) == 4,
        "state before window and evidence",
    )
    assert!(
        review_code_of(true, v, MilestoneState::Submitted, 5600, 9000, 7, 9) == 5,
        "window before evidence",
    )
}

#[test]
fn rules_delivery_and_review_windows_at_d_minus_1_d_and_d_plus_1() {
    let d = Timestamp::from_seconds(1000)
    let decide = Timestamp::from_seconds(4600)
    assert!(
        rules::delivery_open(now: Timestamp::from_seconds(999), deliver_by: d),
    )
    assert!(
        !rules::delivery_open(now: Timestamp::from_seconds(1000), deliver_by: d),
    )
    assert!(
        !rules::delivery_open(now: Timestamp::from_seconds(1001), deliver_by: d),
    )
    assert!(
        rules::review_open(now: Timestamp::from_seconds(4599), decide_by: decide),
    )
    assert!(
        !rules::review_open(now: Timestamp::from_seconds(4600), decide_by: decide),
    )
    assert!(
        !rules::review_open(now: Timestamp::from_seconds(4601), decide_by: decide),
    )
    // A submission made just before the delivery deadline still gets the whole review window:
    // the delivery window is closed at 1001, the review window is open until 4600.
    assert!(
        !rules::delivery_open(now: Timestamp::from_seconds(1001), deliver_by: d),
    )
    assert!(
        rules::review_open(now: Timestamp::from_seconds(1001), decide_by: decide),
    )
}

#[test]
fn rules_only_funded_and_submitted_milestones_take_evidence() {
    assert!(!rules::can_submit_from(MilestoneState::None))
    assert!(rules::can_submit_from(MilestoneState::Funded))
    assert!(rules::can_submit_from(MilestoneState::Submitted))
    assert!(!rules::can_submit_from(MilestoneState::Approved))
    assert!(!rules::can_submit_from(MilestoneState::Paid))
    assert!(!rules::can_submit_from(MilestoneState::Refunded))
}

#[test]
fn rules_total_amount_sums_only_the_used_slots() {
    assert!(
        rules::total_amount(n: 0, amounts: [ether(1), ether(2), ether(3)]) == Wei::zero(),
    )
    assert!(
        rules::total_amount(n: 1, amounts: [ether(1), ether(2), ether(3)]) == ether(1),
    )
    assert!(
        rules::total_amount(n: 2, amounts: [ether(1), ether(2), ether(3)]) == ether(3),
    )
    assert!(
        rules::total_amount(n: 3, amounts: [ether(1), ether(2), ether(3)]) == ether(6),
    )
    assert!(
        rules::total_amount(n: 3, amounts: [wei(MAX - 2), wei(1), wei(1)]) == wei(MAX),
    )
}

#[test(should_revert, panic = 0x11)]
fn rules_total_amount_overflow_panics() {
    let _ = rules::total_amount(n: 2, amounts: [wei(MAX), wei(1), Wei::zero()])
}

#[test]
fn rules_decide_by_is_deliver_by_plus_the_review_period() {
    let d = Timestamp::from_seconds(5000)
    assert!(
        rules::decide_by(deliver_by: d, review_period: seconds(60))
            == Timestamp::from_seconds(5060),
    )
    assert!(
        rules::decide_by(
                deliver_by: Timestamp::from_seconds(MAX - 5),
                review_period: seconds(5),
            )
                .as_seconds()
            == MAX,
    )
}

#[test(should_revert, panic = 0x11)]
fn rules_decide_by_overflow_panics() {
    let _ = rules::decide_by(
        deliver_by: Timestamp::from_seconds(MAX - 4),
        review_period: seconds(5),
    )
}

#[test]
fn the_none_state_is_first_and_codes_are_stable() {
    // D-017: an unset storage key reads as the first variant, so `None` must be code 0.
    assert!(rules::state_code(MilestoneState::None) == 0)
    assert!(rules::state_code(MilestoneState::Funded) == 1)
    assert!(rules::state_code(MilestoneState::Submitted) == 2)
    assert!(rules::state_code(MilestoneState::Approved) == 3)
    assert!(rules::state_code(MilestoneState::Paid) == 4)
    assert!(rules::state_code(MilestoneState::Refunded) == 5)
    assert!(rules::check_code(CreateCheck::Valid) == 0)
}
