// Pure settlement rules. No `uses`: nothing here reads storage, time or value. The current
// time always arrives as the `now` argument, so the same rules run under the production
// clock and under the dev ingot's settable clock (D-016).
use ingot::types::MilestoneState

// First failed creation rule, in the order docs/LIFECYCLE.md "Creation validation" lists them:
// Parties, Count, Amounts, Time, Spec. `Valid` means all passed. Overflow cases are explicit
// rules here (no panic), so every check, including the `decide_by` window, finishes before
// the handler writes anything to storage.
pub enum CreateCheck {
    Valid,
    // Parties (D-011)
    ProviderZero,
    VerifierZero,
    ClientIsProvider,
    ClientIsVerifier,
    ProviderIsVerifier,
    // Count
    BadMilestoneCount,
    UnusedSlotNotEmpty,
    // Amounts
    ZeroAmount,
    AmountSumOverflow,
    ValueMismatch,
    // Time
    DeliveryNotInFuture,
    ZeroReviewPeriod,
    DecideByOverflow,
    // Spec
    ZeroSpec,
}

impl Copy for CreateCheck {}

pub fn check_code(_ c: CreateCheck) -> u8 {
    match c {
        CreateCheck::Valid => 0,
        CreateCheck::ProviderZero => 1,
        CreateCheck::VerifierZero => 2,
        CreateCheck::ClientIsProvider => 3,
        CreateCheck::ClientIsVerifier => 4,
        CreateCheck::ProviderIsVerifier => 5,
        CreateCheck::BadMilestoneCount => 6,
        CreateCheck::UnusedSlotNotEmpty => 7,
        CreateCheck::ZeroAmount => 8,
        CreateCheck::AmountSumOverflow => 9,
        CreateCheck::ValueMismatch => 10,
        CreateCheck::DeliveryNotInFuture => 11,
        CreateCheck::ZeroReviewPeriod => 12,
        CreateCheck::DecideByOverflow => 13,
        CreateCheck::ZeroSpec => 14,
    }
}

// Stable numeric code of a milestone state, as returned by `getMilestone`.
pub fn state_code(_ s: MilestoneState) -> u8 {
    match s {
        MilestoneState::None => 0,
        MilestoneState::Funded => 1,
        MilestoneState::Submitted => 2,
        MilestoneState::Approved => 3,
        MilestoneState::Paid => 4,
        MilestoneState::Refunded => 5,
    }
}

// Sum of the used milestone amounts. Checked: an overflow reverts with Panic(0x11).
pub fn total_amount(n: u8, amounts: [Wei; 3]) -> Wei {
    var total = Wei::zero()
    var i: u8 = 0
    while i < n && i < 3 {
        total = total + amounts[i as usize]
        i += 1
    }
    total
}

// `deliver_by + review_period`. Checked: an overflow reverts with Panic(0x11), so no
// milestone can be created whose review window wraps around.
pub fn decide_by(deliver_by: Timestamp, review_period: Duration) -> Timestamp {
    deliver_by + review_period
}

// `open` predicates are strict `<` and expiry is `>=` (docs/LIFECYCLE.md, DE). Later
// phases use them for submission, review and refunds, and they are tested at d-1, d, d+1.
pub fn delivery_open(now: Timestamp, deliver_by: Timestamp) -> bool {
    now < deliver_by
}

pub const U256_MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

// All creation rules (docs/LIFECYCLE.md "Creation validation"), stage by stage in the table's
// order: Parties, Count, Amounts, Time, Spec. Within a stage every used slot is checked in
// index order, and the first failure is returned. Unused slots (index >= n) must be empty.
// `client` is the caller, `now` is the clock, `value` is the ETH sent with the call.
// Nothing here panics: the sum and the `decide_by` window are tested against U256_MAX first.
pub fn check_create(
    client: Address,
    provider: Address,
    verifier: Address,
    review_period: Duration,
    n: u8,
    amounts: [Wei; 3],
    deliver_by: [Timestamp; 3],
    specs: [u256; 3],
    value: Wei,
    now: Timestamp,
) -> CreateCheck {
    // Parties
    if provider == Address::zero() {
        return CreateCheck::ProviderZero
    }
    if verifier == Address::zero() {
        return CreateCheck::VerifierZero
    }
    if client == provider {
        return CreateCheck::ClientIsProvider
    }
    if client == verifier {
        return CreateCheck::ClientIsVerifier
    }
    if provider == verifier {
        return CreateCheck::ProviderIsVerifier
    }

    // Count: 1..=3 milestones, and every unused slot completely empty.
    if n < 1 || n > 3 {
        return CreateCheck::BadMilestoneCount
    }
    var i: u8 = 0
    while i < 3 {
        let k = i as usize
        if i >= n {
            if amounts[k] != Wei::zero()
                || specs[k] != 0
                || deliver_by[k] != Timestamp::from_seconds(0) {
                return CreateCheck::UnusedSlotNotEmpty
            }
        }
        i += 1
    }

    // Amounts: each used amount > 0, the sum cannot overflow, and the value is exactly the sum.
    var sum: u256 = 0
    i = 0
    while i < n {
        let a = amounts[i as usize].as_wei()
        if a == 0 {
            return CreateCheck::ZeroAmount
        }
        if a > U256_MAX - sum {
            return CreateCheck::AmountSumOverflow
        }
        sum = sum + a
        i += 1
    }
    if value.as_wei() != sum {
        return CreateCheck::ValueMismatch
    }

    // Time: every deadline strictly after now, a nonzero review period, and no `decide_by` wrap.
    i = 0
    while i < n {
        if !(deliver_by[i as usize] > now) {
            return CreateCheck::DeliveryNotInFuture
        }
        i += 1
    }
    if review_period == Duration::zero() {
        return CreateCheck::ZeroReviewPeriod
    }
    i = 0
    while i < n {
        if deliver_by[i as usize].as_seconds() > U256_MAX - review_period.as_seconds() {
            return CreateCheck::DecideByOverflow
        }
        i += 1
    }

    // Spec: every used milestone commits to a nonzero specification hash.
    i = 0
    while i < n {
        if specs[i as usize] == 0 {
            return CreateCheck::ZeroSpec
        }
        i += 1
    }
    CreateCheck::Valid
}
