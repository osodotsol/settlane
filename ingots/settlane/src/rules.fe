// Pure settlement rules. No `uses`: nothing here reads storage, time or value. The current
// time always arrives as the `now` argument, so the same rules run under the production
// clock and under the dev ingot's settable clock (D-016).
use ingot::types::MilestoneState

// First failed creation rule, in the order docs/LIFECYCLE.md "Creation validation" lists them:
// Parties, Count, Amounts, Time, Spec. `Valid` means all passed. Overflow cases are explicit
// rules here (no panic), so every check, including the `decide_by` window, finishes before
// the handler writes anything to storage.
pub enum CreateCheck {
    Valid,
    // Parties (D-011)
    ProviderZero,
    VerifierZero,
    ClientIsProvider,
    ClientIsVerifier,
    ProviderIsVerifier,
    // Count
    BadMilestoneCount,
    UnusedSlotNotEmpty,
    // Amounts
    ZeroAmount,
    AmountSumOverflow,
    ValueMismatch,
    // Time
    DeliveryNotInFuture,
    ZeroReviewPeriod,
    DecideByOverflow,
    // Spec
    ZeroSpec,
}

impl Copy for CreateCheck {}

pub fn check_code(_ c: CreateCheck) -> u8 {
    match c {
        CreateCheck::Valid => 0,
        CreateCheck::ProviderZero => 1,
        CreateCheck::VerifierZero => 2,
        CreateCheck::ClientIsProvider => 3,
        CreateCheck::ClientIsVerifier => 4,
        CreateCheck::ProviderIsVerifier => 5,
        CreateCheck::BadMilestoneCount => 6,
        CreateCheck::UnusedSlotNotEmpty => 7,
        CreateCheck::ZeroAmount => 8,
        CreateCheck::AmountSumOverflow => 9,
        CreateCheck::ValueMismatch => 10,
        CreateCheck::DeliveryNotInFuture => 11,
        CreateCheck::ZeroReviewPeriod => 12,
        CreateCheck::DecideByOverflow => 13,
        CreateCheck::ZeroSpec => 14,
    }
}

// Stable numeric code of a milestone state, as returned by `getMilestone`.
pub fn state_code(_ s: MilestoneState) -> u8 {
    match s {
        MilestoneState::None => 0,
        MilestoneState::Funded => 1,
        MilestoneState::Submitted => 2,
        MilestoneState::Approved => 3,
        MilestoneState::Paid => 4,
        MilestoneState::Refunded => 5,
    }
}

// Sum of the used milestone amounts. Checked: an overflow reverts with Panic(0x11).
pub fn total_amount(n: u8, amounts: [Wei; 3]) -> Wei {
    var total = Wei::zero()
    var i: u8 = 0
    while i < n && i < 3 {
        total = total + amounts[i as usize]
        i += 1
    }
    total
}

// `deliver_by + review_period`. Checked: an overflow reverts with Panic(0x11), so no
// milestone can be created whose review window wraps around.
pub fn decide_by(deliver_by: Timestamp, review_period: Duration) -> Timestamp {
    deliver_by + review_period
}

// `open` predicates are strict `<` and expiry is `>=` (docs/LIFECYCLE.md, DE). Later
// phases use them for submission, review and refunds, and they are tested at d-1, d, d+1.
pub fn delivery_open(now: Timestamp, deliver_by: Timestamp) -> bool {
    now < deliver_by
}

// The review window is open strictly before `decide_by` (docs/LIFECYCLE.md, DE). It is the
// mirror of `expired` for a Submitted milestone: a refund (Phase 3) needs `now >= decide_by`.
pub fn review_open(now: Timestamp, decide_by: Timestamp) -> bool {
    now < decide_by
}

// A milestone can take new evidence in these states (T2): first submission from `Funded`,
// resubmission from `Submitted`. `Approved` is immutable, and `Paid`, `Refunded` are terminal.
pub fn can_submit_from(_ s: MilestoneState) -> bool {
    match s {
        MilestoneState::None => false,
        MilestoneState::Funded => true,
        MilestoneState::Submitted => true,
        MilestoneState::Approved => false,
        MilestoneState::Paid => false,
        MilestoneState::Refunded => false,
    }
}

// First failed rule of `Submit` (T2), in this order: the agreement exists, the caller is the
// provider, the milestone exists, its state allows submission, the delivery window is open,
// and the evidence is not zero.
pub enum SubmitCheck {
    Valid,
    UnknownAgreement,
    NotProvider,
    NoSuchMilestone,
    WrongState,
    DeliveryClosed,
    ZeroEvidence,
}

impl Copy for SubmitCheck {}

pub fn submit_code(_ c: SubmitCheck) -> u8 {
    match c {
        SubmitCheck::Valid => 0,
        SubmitCheck::UnknownAgreement => 1,
        SubmitCheck::NotProvider => 2,
        SubmitCheck::NoSuchMilestone => 3,
        SubmitCheck::WrongState => 4,
        SubmitCheck::DeliveryClosed => 5,
        SubmitCheck::ZeroEvidence => 6,
    }
}

pub fn check_submit(
    agreement_exists: bool,
    caller: Address,
    provider: Address,
    state: MilestoneState,
    deliver_by: Timestamp,
    now: Timestamp,
    evidence: u256,
) -> SubmitCheck {
    if !agreement_exists {
        return SubmitCheck::UnknownAgreement
    }
    if caller != provider {
        return SubmitCheck::NotProvider
    }
    if state_code(state) == 0 {
        return SubmitCheck::NoSuchMilestone
    }
    if !can_submit_from(state) {
        return SubmitCheck::WrongState
    }
    if !delivery_open(now, deliver_by) {
        return SubmitCheck::DeliveryClosed
    }
    if evidence == 0 {
        return SubmitCheck::ZeroEvidence
    }
    SubmitCheck::Valid
}

// First failed rule of `Approve` (T3) and `Reject` (T4). They share one check, so their guards
// cannot drift apart: the agreement exists, the caller is the verifier, the milestone exists,
// it is `Submitted`, the review window is open, and the evidence the verifier names is exactly
// the stored evidence (D-015), with the same submission revision.
pub enum ReviewCheck {
    Valid,
    UnknownAgreement,
    NotVerifier,
    NoSuchMilestone,
    NotSubmitted,
    ReviewClosed,
    EvidenceMismatch,
    RevisionMismatch,
}

impl Copy for ReviewCheck {}

pub fn review_code(_ c: ReviewCheck) -> u8 {
    match c {
        ReviewCheck::Valid => 0,
        ReviewCheck::UnknownAgreement => 1,
        ReviewCheck::NotVerifier => 2,
        ReviewCheck::NoSuchMilestone => 3,
        ReviewCheck::NotSubmitted => 4,
        ReviewCheck::ReviewClosed => 5,
        ReviewCheck::EvidenceMismatch => 6,
        ReviewCheck::RevisionMismatch => 7,
    }
}

pub fn check_review(
    agreement_exists: bool,
    caller: Address,
    verifier: Address,
    state: MilestoneState,
    decide_by: Timestamp,
    now: Timestamp,
    stored_evidence: u256,
    evidence: u256,
    stored_revision: u256,
    revision: u256,
) -> ReviewCheck {
    if !agreement_exists {
        return ReviewCheck::UnknownAgreement
    }
    if caller != verifier {
        return ReviewCheck::NotVerifier
    }
    if state_code(state) == 0 {
        return ReviewCheck::NoSuchMilestone
    }
    if state_code(state) != 2 {
        return ReviewCheck::NotSubmitted
    }
    if !review_open(now, decide_by) {
        return ReviewCheck::ReviewClosed
    }
    if evidence != stored_evidence {
        return ReviewCheck::EvidenceMismatch
    }
    if revision != stored_revision {
        return ReviewCheck::RevisionMismatch
    }
    ReviewCheck::Valid
}

// First failed rule of `Claim` (T5), in the same order as the other transitions: the agreement
// exists, the caller is the provider, the milestone exists, it is `Approved`, and the payee is
// not the zero address. `Paid` is not `Approved`, so a second claim fails here (I4).
pub enum ClaimCheck {
    Valid,
    UnknownAgreement,
    NotProvider,
    NoSuchMilestone,
    NotApproved,
    ZeroPayee,
}

impl Copy for ClaimCheck {}

pub fn claim_code(_ c: ClaimCheck) -> u8 {
    match c {
        ClaimCheck::Valid => 0,
        ClaimCheck::UnknownAgreement => 1,
        ClaimCheck::NotProvider => 2,
        ClaimCheck::NoSuchMilestone => 3,
        ClaimCheck::NotApproved => 4,
        ClaimCheck::ZeroPayee => 5,
    }
}

pub fn check_claim(
    agreement_exists: bool,
    caller: Address,
    provider: Address,
    state: MilestoneState,
    to: Address,
) -> ClaimCheck {
    if !agreement_exists {
        return ClaimCheck::UnknownAgreement
    }
    if caller != provider {
        return ClaimCheck::NotProvider
    }
    if state_code(state) == 0 {
        return ClaimCheck::NoSuchMilestone
    }
    if state_code(state) != 3 {
        return ClaimCheck::NotApproved
    }
    if to == Address::zero() {
        return ClaimCheck::ZeroPayee
    }
    ClaimCheck::Valid
}

// `expired` (docs/LIFECYCLE.md "Derived time predicates"): a Funded milestone once its delivery
// window has closed, a Submitted one once its review window has closed. No other state ever
// expires: `Approved` never does, and `Paid` and `Refunded` are terminal. Each test is the exact
// negation of the window that the transition guards use, so Submit and Approve/Reject are
// disjoint from Refund at every `now` (I10).
pub fn expired(
    _ state: MilestoneState,
    _ now: Timestamp,
    _ deliver_by: Timestamp,
    _ decide_by: Timestamp,
) -> bool {
    match state {
        MilestoneState::None => false,
        MilestoneState::Funded => !delivery_open(now, deliver_by),
        MilestoneState::Submitted => !review_open(now, decide_by),
        MilestoneState::Approved => false,
        MilestoneState::Paid => false,
        MilestoneState::Refunded => false,
    }
}

// A milestone the client may refund once it has expired (T6): only `Funded` or `Submitted`.
pub fn can_refund_from(_ s: MilestoneState) -> bool {
    match s {
        MilestoneState::None => false,
        MilestoneState::Funded => true,
        MilestoneState::Submitted => true,
        MilestoneState::Approved => false,
        MilestoneState::Paid => false,
        MilestoneState::Refunded => false,
    }
}

// First failed rule of `Refund` (T6), in the order of the other transitions (agreement, role,
// milestone, state, window, then the argument): the agreement exists, the caller is the client,
// the milestone exists, it is `Funded` or `Submitted`, it has expired, and the payee is not the
// zero address. `Refunded` and `Paid` are not refundable states, so a second refund and a refund
// after a claim fail here (I3, I4); `Refunded` is not `Approved`, so a claim after a refund fails
// in `check_claim`.
pub enum RefundCheck {
    Valid,
    UnknownAgreement,
    NotClient,
    NoSuchMilestone,
    NotRefundable,
    NotExpired,
    ZeroPayee,
}

impl Copy for RefundCheck {}

pub fn refund_code(_ c: RefundCheck) -> u8 {
    match c {
        RefundCheck::Valid => 0,
        RefundCheck::UnknownAgreement => 1,
        RefundCheck::NotClient => 2,
        RefundCheck::NoSuchMilestone => 3,
        RefundCheck::NotRefundable => 4,
        RefundCheck::NotExpired => 5,
        RefundCheck::ZeroPayee => 6,
    }
}

pub fn check_refund(
    agreement_exists: bool,
    caller: Address,
    client: Address,
    state: MilestoneState,
    deliver_by: Timestamp,
    decide_by: Timestamp,
    now: Timestamp,
    to: Address,
) -> RefundCheck {
    if !agreement_exists {
        return RefundCheck::UnknownAgreement
    }
    if caller != client {
        return RefundCheck::NotClient
    }
    if state_code(state) == 0 {
        return RefundCheck::NoSuchMilestone
    }
    if !can_refund_from(state) {
        return RefundCheck::NotRefundable
    }
    if !expired(state, now, deliver_by, decide_by) {
        return RefundCheck::NotExpired
    }
    if to == Address::zero() {
        return RefundCheck::ZeroPayee
    }
    RefundCheck::Valid
}

pub const U256_MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

// All creation rules (docs/LIFECYCLE.md "Creation validation"), stage by stage in the table's
// order: Parties, Count, Amounts, Time, Spec. Within a stage every used slot is checked in
// index order, and the first failure is returned. Unused slots (index >= n) must be empty.
// `client` is the caller, `now` is the clock, `value` is the ETH sent with the call.
// Nothing here panics: the sum and the `decide_by` window are tested against U256_MAX first.
pub fn check_create(
    client: Address,
    provider: Address,
    verifier: Address,
    review_period: Duration,
    n: u8,
    amounts: [Wei; 3],
    deliver_by: [Timestamp; 3],
    specs: [u256; 3],
    value: Wei,
    now: Timestamp,
) -> CreateCheck {
    // Parties
    if provider == Address::zero() {
        return CreateCheck::ProviderZero
    }
    if verifier == Address::zero() {
        return CreateCheck::VerifierZero
    }
    if client == provider {
        return CreateCheck::ClientIsProvider
    }
    if client == verifier {
        return CreateCheck::ClientIsVerifier
    }
    if provider == verifier {
        return CreateCheck::ProviderIsVerifier
    }

    // Count: 1..=3 milestones, and every unused slot completely empty.
    if n < 1 || n > 3 {
        return CreateCheck::BadMilestoneCount
    }
    var i: u8 = 0
    while i < 3 {
        let k = i as usize
        if i >= n {
            if amounts[k] != Wei::zero()
                || specs[k] != 0
                || deliver_by[k] != Timestamp::from_seconds(0) {
                return CreateCheck::UnusedSlotNotEmpty
            }
        }
        i += 1
    }

    // Amounts: each used amount > 0, the sum cannot overflow, and the value is exactly the sum.
    var sum: u256 = 0
    i = 0
    while i < n {
        let a = amounts[i as usize].as_wei()
        if a == 0 {
            return CreateCheck::ZeroAmount
        }
        if a > U256_MAX - sum {
            return CreateCheck::AmountSumOverflow
        }
        sum = sum + a
        i += 1
    }
    if value.as_wei() != sum {
        return CreateCheck::ValueMismatch
    }

    // Time: every deadline strictly after now, a nonzero review period, and no `decide_by` wrap.
    i = 0
    while i < n {
        if !(deliver_by[i as usize] > now) {
            return CreateCheck::DeliveryNotInFuture
        }
        i += 1
    }
    if review_period == Duration::zero() {
        return CreateCheck::ZeroReviewPeriod
    }
    i = 0
    while i < n {
        if deliver_by[i as usize].as_seconds() > U256_MAX - review_period.as_seconds() {
            return CreateCheck::DecideByOverflow
        }
        i += 1
    }

    // Spec: every used milestone commits to a nonzero specification hash.
    i = 0
    while i < n {
        if specs[i as usize] == 0 {
            return CreateCheck::ZeroSpec
        }
        i += 1
    }
    CreateCheck::Valid
}
