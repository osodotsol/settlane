// The Settlane contract and its message type. Every arm is glue (D-016): it provides the Clock
// and calls a shared handler.
//
// Declared effects: `Ctx`, `Log` and `Call`. `Call` is listed only by the `Claim` and `Refund`
// arms (lint E-CALL), so they are the only ways ETH leaves the contract, and each of those arms is
// exactly the call of its handler (lint C-XFER-ARM, review G-1). There is no `Create`.
use ingot::handlers
use ingot::types::{Agreement, Clock, Milestone, Totals}
use std::evm::StorageMap

// `pub` so the dev ingot's test-clock shell can serve the identical message set.
pub msg SettleMsg {
    // Creates and funds an agreement. `msg.value` must equal the sum of the first `n`
    // amounts. The caller is the client. Returns the agreement id (the first is 1).
    #[selector = sol(
        "create(address,address,uint256,uint8,uint256[3],uint256[3],uint256[3])",
    )]
    Create {
        provider: Address,
        verifier: Address,
        review_period: Duration,
        n: u8,
        amounts: [Wei; 3],
        deliver_by: [Timestamp; 3],
        specs: [u256; 3],
    } -> u256,
    // T2: the provider submits (or resubmits) a nonzero evidence hash for milestone `m`.
    #[selector = sol("submit(uint256,uint8,uint256)")]
    Submit { id: u256, m: u8, evidence: u256 },
    // T3: the verifier approves the evidence it names. It must equal the stored evidence.
    #[selector = sol("approve(uint256,uint8,uint256,uint256)")]
    Approve { id: u256, m: u8, evidence: u256, revision: u256 },
    // T4: the verifier asks for a revision of the evidence it names (D-015). Back to `Funded`.
    #[selector = sol("reject(uint256,uint8,uint256,uint256)")]
    Reject { id: u256, m: u8, evidence: u256, revision: u256 },
    // T5: the provider claims an approved milestone. The stored amount is sent to `to` (D-004).
    #[selector = sol("claim(uint256,uint8,address)")]
    Claim { id: u256, m: u8, to: Address } -> Wei,
    // T6: the client refunds an expired Funded or Submitted milestone. The stored amount is sent
    // to `to`, which the client chooses (D-005a).
    #[selector = sol("refund(uint256,uint8,address)")]
    Refund { id: u256, m: u8, to: Address } -> Wei,
    #[selector = sol("getAgreement(uint256)")]
    GetAgreement { id: u256 } -> (Address, Address, Address, Duration, u8),
    #[selector = sol("getMilestone(uint256,uint8)")]
    GetMilestone { id: u256, m: u8 } -> (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256),
    #[selector = sol("getAccounting(uint256)")]
    GetAccounting { id: u256 } -> (Wei, Wei, Wei, Wei),
    #[selector = sol("totalOutstanding()")]
    TotalOutstanding -> Wei,
}

pub contract Settlane uses (ctx: Ctx, call: mut Call, log: mut Log) {
    mut totals: Totals,
    mut agreements: StorageMap<u256, Agreement>,
    mut milestones: StorageMap<(u256, u8), Milestone>,

    recv SettleMsg {
        #[payable]
        Create { provider, verifier, review_period, n, amounts, deliver_by, specs } -> u256
        uses (ctx, mut log, mut totals, mut agreements, mut milestones)
        {
            var id: u256 = 0
            // The production clock: block time, and nothing else (lint C-CLOCK).
            with (Clock = Clock { now: ctx.timestamp() }) {
                id = handlers::create_handler(
                    provider,
                    verifier,
                    review_period,
                    n,
                    amounts,
                    deliver_by,
                    specs,
                )
            }
            id
        }

        Submit { id, m, evidence } uses (ctx, mut log, agreements, mut milestones) {
            with (Clock = Clock { now: ctx.timestamp() }) {
                handlers::submit_handler(id, m, evidence)
            }
        }

        Approve { id, m, evidence, revision } uses (ctx, mut log, agreements, mut milestones) {
            with (Clock = Clock { now: ctx.timestamp() }) {
                handlers::approve_handler(id, m, evidence, revision)
            }
        }

        Reject { id, m, evidence, revision } uses (ctx, mut log, agreements, mut milestones) {
            with (Clock = Clock { now: ctx.timestamp() }) {
                handlers::reject_handler(id, m, evidence, revision)
            }
        }

        // One of the two arms that list `call` (lint E-CALL). Claim has no time guard: an approval
        // never expires (docs/LIFECYCLE.md), so no Clock is needed here. The body must be exactly
        // this call (lint C-XFER-ARM): nothing may run after the transfer (review G-1).
        Claim { id, m, to } -> Wei uses (
            ctx,
            mut call,
            mut log,
            mut totals,
            mut agreements,
            mut milestones,
        ) {
            handlers::claim_handler(id, m, to)
        }

        // The other arm that lists `call`. `expired` needs the production clock. `with` is a
        // statement block, so the amount comes back through a local (FE_NOTES). The body must be
        // exactly this (lint C-XFER-ARM): no storage write or call after the transfer (G-1).
        Refund { id, m, to } -> Wei uses (
            ctx,
            mut call,
            mut log,
            mut totals,
            mut agreements,
            mut milestones,
        ) {
            var amount = Wei::zero()
            with (Clock = Clock { now: ctx.timestamp() }) {
                amount = handlers::refund_handler(id, m, to)
            }
            amount
        }

        GetAgreement { id } -> (Address, Address, Address, Duration, u8)
        uses (agreements)
        {
            handlers::get_agreement_handler(id)
        }

        GetMilestone { id, m } -> (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256)
        uses (milestones)
        {
            handlers::get_milestone_handler(id, m)
        }

        GetAccounting { id } -> (Wei, Wei, Wei, Wei)
        uses (agreements)
        {
            handlers::get_accounting_handler(id)
        }

        TotalOutstanding -> Wei uses (totals) {
            handlers::total_outstanding_handler()
        }
    }
}
