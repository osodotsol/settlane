// Shared handler bodies (D-016). Each `recv` arm of `Settlane`, and of the dev ingot's
// `SettlaneTestClock`, only supplies the Clock and calls one of these. Handlers see
// contract state through `uses` parameters, and time only through the `clock` effect.
//
// Phase 2A: creation and queries. No handler here lists `call` or `create`, so none can
// move ETH (and the contract does not even declare those effects).
use ingot::rules
use ingot::rules::{CreateCheck, ReviewCheck, SubmitCheck}
use ingot::types::{
    Agreement,
    AgreementCreated,
    Clock,
    Milestone,
    MilestoneApproved,
    MilestoneRejected,
    MilestoneState,
    MilestoneSubmitted,
    Totals,
}
use std::evm::StorageMap

// Reverts with the reason for the first failed creation rule.
pub fn require_valid(_ c: CreateCheck) {
    match c {
        CreateCheck::Valid => {},
        CreateCheck::ProviderZero => {
            assert!(false, "provider is zero")
        },
        CreateCheck::VerifierZero => {
            assert!(false, "verifier is zero")
        },
        CreateCheck::ClientIsProvider => {
            assert!(false, "client is provider")
        },
        CreateCheck::ClientIsVerifier => {
            assert!(false, "client is verifier")
        },
        CreateCheck::ProviderIsVerifier => {
            assert!(false, "provider is verifier")
        },
        CreateCheck::BadMilestoneCount => {
            assert!(false, "milestone count not 1..3")
        },
        CreateCheck::UnusedSlotNotEmpty => {
            assert!(false, "unused milestone slot not empty")
        },
        CreateCheck::ZeroAmount => {
            assert!(false, "milestone amount is zero")
        },
        CreateCheck::AmountSumOverflow => {
            assert!(false, "milestone amounts overflow")
        },
        CreateCheck::ValueMismatch => {
            assert!(false, "value does not equal the milestone total")
        },
        CreateCheck::DeliveryNotInFuture => {
            assert!(false, "deliver_by not in the future")
        },
        CreateCheck::ZeroReviewPeriod => {
            assert!(false, "review period is zero")
        },
        CreateCheck::DecideByOverflow => {
            assert!(false, "deliver_by plus review period overflows")
        },
        CreateCheck::ZeroSpec => {
            assert!(false, "milestone spec is zero")
        },
    }
}

// T1: create and fund an agreement. The caller becomes the client. Every rule, including the
// deadlines and the `decide_by` window, is validated first (rules::check_create), and only then
// is anything written to storage. There is no external call, so nothing can re-enter.
pub fn create_handler(
    provider: Address,
    verifier: Address,
    review_period: Duration,
    n: u8,
    amounts: [Wei; 3],
    deliver_by: [Timestamp; 3],
    specs: [u256; 3],
) -> u256
uses (
    clock: Clock,
    ctx: Ctx,
    log: mut Log,
    totals: mut Totals,
    agreements: mut StorageMap<u256, Agreement>,
    milestones: mut StorageMap<(u256, u8), Milestone>,
)
{
    let client = ctx.caller()
    let value = ctx.value()
    require_valid(
        rules::check_create(
            client,
            provider,
            verifier,
            review_period,
            n,
            amounts,
            deliver_by,
            specs,
            value,
            now: clock.now,
        ),
    )

    let id = totals.next_id + 1
    let total = rules::total_amount(n, amounts)
    totals.next_id = id
    totals.outstanding = totals.outstanding + total
    agreements
        .set(
            key: id,
            value: Agreement {
                client,
                provider,
                verifier,
                review_period,
                n,
                deposited: total,
                paid: Wei::zero(),
                refunded: Wei::zero(),
            },
        )

    var i: u8 = 0
    while i < n {
        let k = i as usize
        milestones
            .set(
                key: (id, i),
                value: Milestone {
                    state: MilestoneState::Funded,
                    amount: amounts[k],
                    deliver_by: deliver_by[k],
                    decide_by: rules::decide_by(
                        deliver_by: deliver_by[k],
                        review_period: review_period,
                    ),
                    spec: specs[k],
                    evidence: 0,
                    rejections: 0,
                    revision: 0,
                },
            )
        i += 1
    }

    log.emit(
        AgreementCreated { id, client, provider, verifier, total, milestones: n },
    )
    id
}

// Reverts with the reason for the first failed `Submit` rule.
pub fn require_submit(_ c: SubmitCheck) {
    match c {
        SubmitCheck::Valid => {},
        SubmitCheck::UnknownAgreement => {
            assert!(false, "unknown agreement")
        },
        SubmitCheck::NotProvider => {
            assert!(false, "caller is not the provider")
        },
        SubmitCheck::NoSuchMilestone => {
            assert!(false, "no such milestone")
        },
        SubmitCheck::WrongState => {
            assert!(false, "milestone cannot take evidence in this state")
        },
        SubmitCheck::DeliveryClosed => {
            assert!(false, "delivery window is closed")
        },
        SubmitCheck::ZeroEvidence => {
            assert!(false, "evidence is zero")
        },
    }
}

// Reverts with the reason for the first failed `Approve` or `Reject` rule.
pub fn require_review(_ c: ReviewCheck) {
    match c {
        ReviewCheck::Valid => {},
        ReviewCheck::UnknownAgreement => {
            assert!(false, "unknown agreement")
        },
        ReviewCheck::NotVerifier => {
            assert!(false, "caller is not the verifier")
        },
        ReviewCheck::NoSuchMilestone => {
            assert!(false, "no such milestone")
        },
        ReviewCheck::NotSubmitted => {
            assert!(false, "milestone is not submitted")
        },
        ReviewCheck::ReviewClosed => {
            assert!(false, "review window is closed")
        },
        ReviewCheck::EvidenceMismatch => {
            assert!(false, "evidence does not match the submitted evidence")
        },
        ReviewCheck::RevisionMismatch => {
            assert!(false, "submission revision does not match")
        },
    }
}

// T2: the provider submits evidence, or resubmits while the delivery window is open. Only the
// state and the evidence change: amounts, deadlines and spec are never rewritten from here.
// No ETH moves and nothing is called.
pub fn submit_handler(id: u256, m: u8, evidence: u256)
uses (
    clock: Clock,
    ctx: Ctx,
    log: mut Log,
    agreements: StorageMap<u256, Agreement>,
    milestones: mut StorageMap<(u256, u8), Milestone>,
)
{
    let a = agreements.get(key: id)
    let x = milestones.get(key: (id, m))
    require_submit(
        rules::check_submit(
            agreement_exists: a.n != 0,
            caller: ctx.caller(),
            provider: a.provider,
            state: x.state,
            deliver_by: x.deliver_by,
            now: clock.now,
            evidence,
        ),
    )
    let revision = x.revision + 1
    milestones
        .set(
            key: (id, m),
            value: Milestone {
                state: MilestoneState::Submitted,
                amount: x.amount,
                deliver_by: x.deliver_by,
                decide_by: x.decide_by,
                spec: x.spec,
                evidence,
                rejections: x.rejections,
                revision,
            },
        )
    log.emit(MilestoneSubmitted { id, m, evidence, revision })
}

// T3: the verifier approves the evidence it names. The milestone becomes `Approved`, which no
// handler can change again, and the evidence stays as it was. No ETH moves: approval only
// creates the provider's entitlement (it is claimed in a later phase).
pub fn approve_handler(id: u256, m: u8, evidence: u256, revision: u256)
uses (
    clock: Clock,
    ctx: Ctx,
    log: mut Log,
    agreements: StorageMap<u256, Agreement>,
    milestones: mut StorageMap<(u256, u8), Milestone>,
)
{
    let a = agreements.get(key: id)
    let x = milestones.get(key: (id, m))
    require_review(
        rules::check_review(
            agreement_exists: a.n != 0,
            caller: ctx.caller(),
            verifier: a.verifier,
            state: x.state,
            decide_by: x.decide_by,
            now: clock.now,
            stored_evidence: x.evidence,
            evidence,
            stored_revision: x.revision,
            revision,
        ),
    )
    milestones
        .set(
            key: (id, m),
            value: Milestone {
                state: MilestoneState::Approved,
                amount: x.amount,
                deliver_by: x.deliver_by,
                decide_by: x.decide_by,
                spec: x.spec,
                evidence: x.evidence,
                rejections: x.rejections,
                revision: x.revision,
            },
        )
    log.emit(MilestoneApproved { id, m, evidence, revision })
}

// T4: the verifier asks for a revision of the evidence it names (D-006b, D-015). The milestone
// returns to `Funded`, the evidence is cleared and the rejection counter goes up. Deadlines are
// absolute and untouched, so the provider can resubmit only while the delivery window is open.
pub fn reject_handler(id: u256, m: u8, evidence: u256, revision: u256)
uses (
    clock: Clock,
    ctx: Ctx,
    log: mut Log,
    agreements: StorageMap<u256, Agreement>,
    milestones: mut StorageMap<(u256, u8), Milestone>,
)
{
    let a = agreements.get(key: id)
    let x = milestones.get(key: (id, m))
    require_review(
        rules::check_review(
            agreement_exists: a.n != 0,
            caller: ctx.caller(),
            verifier: a.verifier,
            state: x.state,
            decide_by: x.decide_by,
            now: clock.now,
            stored_evidence: x.evidence,
            evidence,
            stored_revision: x.revision,
            revision,
        ),
    )
    let rejections = x.rejections + 1
    milestones
        .set(
            key: (id, m),
            value: Milestone {
                state: MilestoneState::Funded,
                amount: x.amount,
                deliver_by: x.deliver_by,
                decide_by: x.decide_by,
                spec: x.spec,
                evidence: 0,
                rejections,
                revision: x.revision,
            },
        )
    log.emit(
        MilestoneRejected { id, m, evidence, revision, rejections },
    )
}

// Parties and review window. Reverts for an unknown agreement id (including 0).
pub fn get_agreement_handler(id: u256) -> (Address, Address, Address, Duration, u8)
uses (agreements: StorageMap<u256, Agreement>)
{
    let a = agreements.get(key: id)
    assert!(a.n != 0, "unknown agreement")
    (a.client, a.provider, a.verifier, a.review_period, a.n)
}

// (state code, amount, deliver_by, decide_by, spec, evidence, rejections, revision). An unknown agreement id or
// an unused slot reads as state 0 (`None`) with everything zero (D-017). It does not revert.
pub fn get_milestone_handler(id: u256, m: u8) -> (
    u8,
    Wei,
    Timestamp,
    Timestamp,
    u256,
    u256,
    u256,
    u256,
)
uses (milestones: StorageMap<(u256, u8), Milestone>)
{
    let x = milestones.get(key: (id, m))
    (
        rules::state_code(x.state),
        x.amount,
        x.deliver_by,
        x.decide_by,
        x.spec,
        x.evidence,
        x.rejections,
        x.revision,
    )
}

// (deposited, paid, refunded, outstanding). Reverts for an unknown agreement id.
pub fn get_accounting_handler(id: u256) -> (Wei, Wei, Wei, Wei)
uses (agreements: StorageMap<u256, Agreement>)
{
    let a = agreements.get(key: id)
    assert!(a.n != 0, "unknown agreement")
    (a.deposited, a.paid, a.refunded, a.deposited - a.paid - a.refunded)
}

pub fn total_outstanding_handler() -> Wei uses (totals: Totals) {
    totals.outstanding
}
