// Dev ingot: test-only contracts. Nothing here is deployable, and `fe build` at the
// workspace root never emits it (default-members is the production ingot only, D-014).
use settlane::handlers
use settlane::settlane::SettleMsg
use settlane::types::{Agreement, Clock, Milestone, Totals}
use std::evm::StorageMap

// The only message the shell has that the production contract does not.
pub msg DevMsg {
    #[selector = sol("setTime(uint256)")]
    SetTime { now: Timestamp },
}

// The production contract with a settable clock (D-009, D-016). It serves the identical
// `SettleMsg` and every arm calls the same shared handler as `Settlane`. The two differ in
// exactly one thing: where `Clock.now` comes from. Production reads the block, this reads
// the `now` field, so tests can cross deadlines that a frozen test block never reaches.
pub contract SettlaneTestClock uses (ctx: Ctx, call: mut Call, log: mut Log) {
    mut now: Timestamp,
    mut totals: Totals,
    mut agreements: StorageMap<u256, Agreement>,
    mut milestones: StorageMap<(u256, u8), Milestone>,

    recv SettleMsg {
        #[payable]
        Create { provider, verifier, review_period, n, amounts, deliver_by, specs } -> u256
        uses (ctx, mut log, mut totals, mut agreements, mut milestones, now)
        {
            var id: u256 = 0
            with (Clock = Clock { now }) {
                id = handlers::create_handler(
                    provider,
                    verifier,
                    review_period,
                    n,
                    amounts,
                    deliver_by,
                    specs,
                )
            }
            id
        }

        Submit { id, m, evidence } uses (ctx, mut log, agreements, mut milestones, now) {
            with (Clock = Clock { now }) {
                handlers::submit_handler(id, m, evidence)
            }
        }

        Approve { id, m, evidence, revision } uses (ctx, mut log, agreements, mut milestones, now) {
            with (Clock = Clock { now }) {
                handlers::approve_handler(id, m, evidence, revision)
            }
        }

        Reject { id, m, evidence, revision } uses (ctx, mut log, agreements, mut milestones, now) {
            with (Clock = Clock { now }) {
                handlers::reject_handler(id, m, evidence, revision)
            }
        }

        Claim { id, m, to } -> Wei uses (
            ctx,
            mut call,
            mut log,
            mut totals,
            mut agreements,
            mut milestones,
        ) {
            handlers::claim_handler(id, m, to)
        }

        GetAgreement { id } -> (Address, Address, Address, Duration, u8)
        uses (agreements)
        {
            handlers::get_agreement_handler(id)
        }

        GetMilestone { id, m } -> (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256)
        uses (milestones)
        {
            handlers::get_milestone_handler(id, m)
        }

        GetAccounting { id } -> (Wei, Wei, Wei, Wei)
        uses (agreements)
        {
            handlers::get_accounting_handler(id)
        }

        TotalOutstanding -> Wei uses (totals) {
            handlers::total_outstanding_handler()
        }
    }

    recv DevMsg {
        SetTime { now: t } uses (mut now) {
            now = t
        }
    }
}

// A separate address that calls Settlane on someone's behalf. The harness has no caller
// impersonation (FE_NOTES E4), so a contract is how a test gets a different `msg.sender`.
pub msg ActorMsg {
    #[selector = sol(
        "createVia(address,address,address,uint256,uint8,uint256[3],uint256[3],uint256[3])",
    )]
    CreateVia {
        target: Address,
        provider: Address,
        verifier: Address,
        review_period: Duration,
        n: u8,
        amounts: [Wei; 3],
        deliver_by: [Timestamp; 3],
        specs: [u256; 3],
    } -> u256,
    // Forward a transition to Settlane as this actor (the caller Settlane sees is the actor).
    #[selector = sol("submitVia(address,uint256,uint8,uint256)")]
    SubmitVia { target: Address, id: u256, m: u8, evidence: u256 },
    #[selector = sol("approveVia(address,uint256,uint8,uint256,uint256)")]
    ApproveVia { target: Address, id: u256, m: u8, evidence: u256, revision: u256 },
    #[selector = sol("rejectVia(address,uint256,uint8,uint256,uint256)")]
    RejectVia { target: Address, id: u256, m: u8, evidence: u256, revision: u256 },
    #[selector = sol("claimVia(address,uint256,uint8,address)")]
    ClaimVia { target: Address, id: u256, m: u8, to: Address } -> Wei,
}

// Emitted by the Actor with its own address before it forwards a call. scripts/check_events.py
// compares it with the `client` topic of the AgreementCreated event that follows, so the
// event's client is checked against an independent source of truth.
#[event]
pub struct Acted {
    #[indexed]
    pub actor: Address,
}

pub contract Actor uses (ctx: Ctx, call: mut Call, log: mut Log) {
    recv ActorMsg {
        #[payable]
        CreateVia {
            target,
            provider,
            verifier,
            review_period,
            n,
            amounts,
            deliver_by,
            specs,
        } -> u256
        uses (ctx, mut call, mut log)
        {
            log.emit(Acted { actor: ctx.address() })
            call.call(
                addr: target,
                gas: 1000000,
                value: ctx.value(),
                message: SettleMsg::Create {
                    provider,
                    verifier,
                    review_period,
                    n,
                    amounts,
                    deliver_by,
                    specs,
                },
            )
        }

        #[payable]
        SubmitVia { target, id, m, evidence } uses (ctx, mut call) {
            call.call(
                addr: target,
                gas: 1000000,
                value: ctx.value(),
                message: SettleMsg::Submit { id, m, evidence },
            )
        }

        #[payable]
        ApproveVia { target, id, m, evidence, revision }
        uses (ctx, mut call)
        {
            call.call(
                addr: target,
                gas: 1000000,
                value: ctx.value(),
                message: SettleMsg::Approve { id, m, evidence, revision },
            )
        }

        #[payable]
        RejectVia { target, id, m, evidence, revision }
        uses (ctx, mut call)
        {
            call.call(
                addr: target,
                gas: 1000000,
                value: ctx.value(),
                message: SettleMsg::Reject { id, m, evidence, revision },
            )
        }

        #[payable]
        ClaimVia { target, id, m, to } -> Wei uses (ctx, mut call) {
            call.call(
                addr: target,
                gas: 1000000,
                value: ctx.value(),
                message: SettleMsg::Claim { id, m, to },
            )
        }
    }
}

// A provider that tries to be paid twice. It forwards Submit and Claim to Settlane as itself,
// and it can RECEIVE plain ETH through a payable fallback, which tries to claim the same
// milestone again while the first payout is still in flight. Settlane must pay it exactly once:
//   - with the 2300-gas stipend (`send_value(gas: 0)`) the fallback cannot even attempt the call;
//   - if gas were forwarded, the milestone is already `Paid` before the transfer (checks,
//     effects, interaction), so the nested claim reverts.
// `attempts` and `succeeded` count nested claims; both stay 0 under the production code.
pub msg AttackMsg {
    #[selector = sol("setup(address,uint256,uint8)")]
    Setup { target: Address, id: u256, m: u8 },
    #[selector = sol("submitAs(uint256)")]
    SubmitAs { evidence: u256 },
    #[selector = sol("claimTo(address)")]
    ClaimTo { to: Address } -> Wei,
    #[selector = sol("stats()")]
    Stats -> (u256, u256),
}

pub contract Reentrant uses (ctx: Ctx, call: mut Call) {
    mut target: Address,
    mut id: u256,
    mut m: u8,
    mut attempts: u256,
    mut succeeded: u256,

    recv {
        AttackMsg::Setup { target: t, id: i, m: k }
        uses (mut target, mut id, mut m)
        {
            target = t
            id = i
            m = k
        }

        AttackMsg::SubmitAs { evidence } uses (mut call, target, id, m) {
            call.call(
                addr: target,
                gas: 1000000,
                value: Wei::zero(),
                message: SettleMsg::Submit { id, m, evidence },
            )
        }

        AttackMsg::ClaimTo { to } -> Wei uses (mut call, target, id, m) {
            call.call(
                addr: target,
                gas: 2000000,
                value: Wei::zero(),
                message: SettleMsg::Claim { id, m, to },
            )
        }

        AttackMsg::Stats {} -> (u256, u256) uses (attempts, succeeded) {
            (attempts, succeeded)
        }

        // Receiving the payout. With only the stipend there is not enough gas to call or write,
        // so just accept the ETH. With more gas, try to claim the same milestone again.
        #[payable]
        _ uses (ctx, mut call, target, id, m, mut attempts, mut succeeded) {
            if ctx.gas() < 60000 {
                return
            }
            attempts += 1
            let again = call
                .try_call(
                    addr: target,
                    gas: ctx.gas() - 20000,
                    value: Wei::zero(),
                    message: SettleMsg::Claim { id, m, to: ctx.address() },
                )
            if again.success() {
                succeeded += 1
            }
        }
    }
}
