use std::evm::returndata::decode_error_string
// Dev-ingot tests for Phase 2A. These need what the production ingot's tests cannot have:
// a clock that moves (the test-clock shell) and a caller other than the test contract (the
// Actor). The shell runs the production handlers (D-016), so what is tested here is the
// shipped creation logic under other clocks and other callers.
use ingot::{
    Actor,
    ActorMsg,
    AttackMsg,
    DevMsg,
    GasCap,
    Greedy,
    LOOT,
    Once,
    Reentrant,
    SettlaneTestClock,
}
use std::evm::CallOutcome
use settlane::settlane::{SettleMsg, Settlane}
use std::evm::{ether, seconds, wei}

const MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

struct Args {
    provider: Address,
    verifier: Address,
    review_period: Duration,
    n: u8,
    amounts: [Wei; 3],
    deliver_by: [Timestamp; 3],
    specs: [u256; 3],
}

impl Copy for Args {}

// Emitted by the TEST CONTRACT with its own address (R-003). scripts/check_events.py compares
// the `client` topic of every direct-call AgreementCreated with it, so the client of a direct
// call is checked against a value that does not come from Settlane.
#[event]
struct CallerProbe {
    #[indexed]
    who: Address,
}

fn probe() uses (evm: mut Evm) {
    evm.emit(CallerProbe { who: evm.address() })
}

fn t(_ secs: u256) -> Timestamp {
    Timestamp::from_seconds(secs)
}

// A valid three-milestone agreement (1 + 2 + 3 ETH) with deadlines 100, 200, 300 s after `base`.
fn valid(_ base: u256) -> Args {
    Args {
        provider: Address::new(0xa1),
        verifier: Address::new(0xa2),
        review_period: seconds(3600),
        n: 3,
        amounts: [ether(1), ether(2), ether(3)],
        deliver_by: [t(base + 100), t(base + 200), t(base + 300)],
        specs: [0x51, 0x52, 0x53],
    }
}

// A one-milestone agreement of 1 ETH due at `deliver_by`.
fn single(_ deliver_by: u256) -> Args {
    Args {
        provider: Address::new(0xa1),
        verifier: Address::new(0xa2),
        review_period: seconds(3600),
        n: 1,
        amounts: [ether(1), Wei::zero(), Wei::zero()],
        deliver_by: [t(deliver_by), t(0), t(0)],
        specs: [0x51, 0, 0],
    }
}

// Two milestones (1 + 2 ETH) due at d0 and d1, slot 2 empty. Fund it with 3 ETH.
fn two(_ d0: u256, _ d1: u256) -> Args {
    Args {
        provider: Address::new(0xa1),
        verifier: Address::new(0xa2),
        review_period: seconds(3600),
        n: 2,
        amounts: [ether(1), ether(2), Wei::zero()],
        deliver_by: [t(d0), t(d1), t(0)],
        specs: [0x51, 0x52, 0],
    }
}

// Three milestones (1 + 2 + 3 ETH) due at d0, d1 and d2. Fund it with 6 ETH.
fn three(_ d0: u256, _ d1: u256, _ d2: u256) -> Args {
    Args {
        provider: Address::new(0xa1),
        verifier: Address::new(0xa2),
        review_period: seconds(3600),
        n: 3,
        amounts: [ether(1), ether(2), ether(3)],
        deliver_by: [t(d0), t(d1), t(d2)],
        specs: [0x51, 0x52, 0x53],
    }
}

fn try_create(_ s: Address, _ a: Args, _ value: Wei) -> bool
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 1000000,
        value,
        message: SettleMsg::Create {
            provider: a.provider,
            verifier: a.verifier,
            review_period: a.review_period,
            n: a.n,
            amounts: a.amounts,
            deliver_by: a.deliver_by,
            specs: a.specs,
        },
    )
        .success()
}

fn create(_ s: Address, _ a: Args, _ value: Wei) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: s,
        gas: 1000000,
        value,
        message: SettleMsg::Create {
            provider: a.provider,
            verifier: a.verifier,
            review_period: a.review_period,
            n: a.n,
            amounts: a.amounts,
            deliver_by: a.deliver_by,
            specs: a.specs,
        },
    )
}

fn set_time(_ shell: Address, _ now: u256) uses (evm: mut Evm) {
    evm.call(
        addr: shell,
        gas: 100000,
        value: Wei::zero(),
        message: DevMsg::SetTime { now: t(now) },
    )
}

fn outstanding(_ s: Address) -> Wei uses (evm: mut Evm) {
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::TotalOutstanding {},
    )
}

fn milestone(_ s: Address, _ id: u256, _ m: u8) -> (
    u8,
    Wei,
    Timestamp,
    Timestamp,
    u256,
    u256,
    u256,
    u256,
)
uses (evm: mut Evm)
{
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetMilestone { id, m },
    )
}

fn agreement(_ s: Address, _ id: u256) -> (Address, Address, Address, Duration, u8)
uses (evm: mut Evm)
{
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetAgreement { id },
    )
}

fn accounting(_ s: Address, _ id: u256) -> (Wei, Wei, Wei, Wei)
uses (evm: mut Evm)
{
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetAccounting { id },
    )
}

fn exists(_ s: Address, _ id: u256) -> bool uses (evm: mut Evm) {
    evm.try_call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetAgreement { id },
    )
        .success()
}

// Both contracts expose identical state for agreement `id` through every public view.
fn same_state(_ a: Address, _ b: Address, _ id: u256) uses (evm: mut Evm) {
    let x = agreement(a, id)
    let y = agreement(b, id)
    assert!(
        x.0 == y.0 && x.1 == y.1 && x.2 == y.2 && x.3 == y.3 && x.4 == y.4,
        "agreement differs",
    )
    let p = accounting(a, id)
    let q = accounting(b, id)
    assert!(
        p.0 == q.0 && p.1 == q.1 && p.2 == q.2 && p.3 == q.3,
        "accounting differs",
    )
    var m: u8 = 0
    while m < 4 {
        let u = milestone(a, id, m)
        let v = milestone(b, id, m)
        assert!(
            u.0 == v.0
                && u.1 == v.1
                && u.2 == v.2
                && u.3 == v.3
                && u.4 == v.4
                && u.5 == v.5
                && u.6 == v.6
                && u.7 == v.7,
            "milestone differs",
        )
        m += 1
    }
}

// Runs the same call on both and requires the same verdict. Returns it.
fn agree(_ prod: Address, _ shell: Address, _ a: Args, _ value: Wei) -> bool
uses (evm: mut Evm)
{
    let x = try_create(prod, a, value)
    let y = try_create(shell, a, value)
    assert!(x == y, "shell and production disagree")
    x
}

#[test(balance = 200_000_000_000_000_000_000)]
fn shell_and_production_agree_when_their_clocks_agree() uses (evm: mut Evm) {
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 2)
    let now = evm.timestamp().as_seconds()
    set_time(shell, now)

    // Valid creation: same id, same stored state.
    let good = valid(now)
    assert!(create(prod, good, ether(6)) == 1)
    assert!(create(shell, good, ether(6)) == 1)
    same_state(prod, shell, 1)
    assert!(outstanding(prod) == outstanding(shell))

    // The same verdict for a spread of invalid inputs (each is rejected by both).
    var a = good
    a.provider = Address::zero()
    assert!(!agree(prod, shell, a, ether(6)), "provider zero")
    a = good
    a.provider = evm.address()
    assert!(!agree(prod, shell, a, ether(6)), "client is provider")
    a = good
    a.verifier = good.provider
    assert!(!agree(prod, shell, a, ether(6)), "provider is verifier")
    a = good
    a.n = 4
    assert!(!agree(prod, shell, a, ether(6)), "n = 4")
    a = good
    a.review_period = Duration::zero()
    assert!(!agree(prod, shell, a, ether(6)), "zero review period")
    assert!(
        !agree(prod, shell, good, ether(6) + wei(1)),
        "one wei too much",
    )
    assert!(
        !agree(prod, shell, good, ether(6) - wei(1)),
        "one wei too little",
    )
    a = good
    a.deliver_by = [t(now), t(now + 200), t(now + 300)]
    assert!(!agree(prod, shell, a, ether(6)), "deliver_by == now")
    a = single(MAX - 999)
    a.review_period = seconds(1000)
    assert!(!agree(prod, shell, a, ether(1)), "decide_by overflow")
    a = single(now + 1)
    assert!(
        agree(prod, shell, a, ether(1)),
        "now + 1 accepted by both",
    )

    // Unknown ids behave alike: agreements revert, milestones read as None.
    assert!(exists(prod, 1) && exists(shell, 1))
    assert!(!exists(prod, 3) && !exists(shell, 3))
    assert!(!exists(prod, 0) && !exists(shell, 0))
    same_state(prod, shell, 2)
    assert!(
        milestone(prod, 3, 0).0 == 0 && milestone(shell, 3, 0).0 == 0,
    )
    assert!(
        outstanding(prod) == ether(7) && outstanding(shell) == ether(7),
    )
    assert!(
        evm.balance(prod) == ether(7) && evm.balance(shell) == ether(7),
    )
}

#[test(balance = 100_000_000_000_000_000_000)]
fn the_shell_crosses_creation_deadlines_that_a_frozen_block_cannot()
uses (evm: mut Evm)
{
    probe()
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 1)

    // Clock at 1000: deliver_by 1000 is rejected, 1001 is accepted (strict `>`).
    set_time(shell, 1000)
    assert!(
        !try_create(shell, single(1000), ether(1)),
        "deliver_by == now",
    )
    assert!(
        !try_create(shell, single(999), ether(1)),
        "deliver_by == now - 1",
    )
    assert!(
        outstanding(shell) == Wei::zero(),
        "rejections leave nothing behind",
    )
    assert!(
        try_create(shell, single(1001), ether(1)),
        "deliver_by == now + 1",
    )
    assert!(milestone(shell, 1, 0).2 == t(1001))
    assert!(milestone(shell, 1, 0).3 == t(1001 + 3600), "decide_by")

    // Move the clock past that deadline: the same input is now in the past.
    set_time(shell, 1001)
    assert!(
        !try_create(shell, single(1001), ether(1)),
        "now caught up with 1001",
    )
    set_time(shell, 5000)
    assert!(
        !try_create(shell, single(1001), ether(1)),
        "1001 is long past",
    )
    assert!(
        try_create(shell, single(5001), ether(1)),
        "5001 is after 5000",
    )

    // A deadline is judged against the clock at creation only. Agreement 1 is stored as created.
    assert!(
        milestone(shell, 1, 0).2 == t(1001),
        "stored deadlines never change",
    )
    assert!(milestone(shell, 1, 0).0 == 1, "still Funded")

    // Time zero: a used slot with deliver_by 0 is never in the future.
    set_time(shell, 0)
    assert!(
        !try_create(shell, single(0), ether(1)),
        "deliver_by 0 at time 0",
    )
    assert!(
        try_create(shell, single(1), ether(1)),
        "deliver_by 1 at time 0",
    )

    // The sum is exact at any clock, and the three-milestone shape works at a late clock.
    set_time(shell, 10000)
    assert!(!try_create(shell, valid(10000), ether(6) + wei(1)))
    assert!(try_create(shell, valid(10000), ether(6)))
    assert!(outstanding(shell) == ether(9), "1 + 1 + 1 + 6 ETH")
    assert!(evm.balance(shell) == ether(9))
}

#[test(balance = 100_000_000_000_000_000_000)]
fn production_has_no_way_to_set_its_clock() uses (evm: mut Evm) {
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 2)
    let now = evm.timestamp().as_seconds()

    // Positive control: the same `setTime` call works on the shell.
    assert!(
        evm.try_call(
            addr: shell,
            gas: 100000,
            value: Wei::zero(),
            message: DevMsg::SetTime { now: t(now + 10000) },
        )
            .success(),
    )
    // Production rejects it: the selector does not exist there. Several forms of the attempt.
    assert!(
        !evm.try_call(
            addr: prod,
            gas: 100000,
            value: Wei::zero(),
            message: DevMsg::SetTime { now: t(now + 10000) },
        )
            .success(),
    )
    assert!(
        !evm.try_call(
            addr: prod,
            gas: 100000,
            value: Wei::zero(),
            message: DevMsg::SetTime { now: t(0) },
        )
            .success(),
    )
    assert!(
        !evm.try_call(
            addr: prod,
            gas: 100000,
            value: ether(1),
            message: DevMsg::SetTime { now: t(now + 10000) },
        )
            .success(),
    )

    // And production time still follows the block: the boundary has not moved.
    assert!(
        !try_create(prod, single(now), ether(1)),
        "deliver_by == block time is still rejected",
    )
    assert!(
        try_create(prod, single(now + 1000), ether(1)),
        "now + 1000 is still accepted",
    )
    assert!(outstanding(prod) == ether(1))
    // The shell's clock was moved far ahead, production's was not affected by it.
    assert!(
        try_create(prod, single(now + 1), ether(1)),
        "now + 1 is still accepted by production",
    )
    assert!(
        !try_create(shell, single(now + 1), ether(1)),
        "the same input is past on the moved shell",
    )
}

#[test(balance = 100_000_000_000_000_000_000)]
fn the_client_is_the_caller_and_never_a_parameter() uses (evm: mut Evm) {
    let s = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let actor = evm.create2<Actor>(value: Wei::zero(), args: (), salt: 2)
    let now = evm.timestamp().as_seconds()
    let a = valid(now)

    // Created through the actor, the actor is the client and the test contract is not.
    let id: u256 = evm
        .call(
            addr: actor,
            gas: 2000000,
            value: ether(6),
            message: ActorMsg::CreateVia {
                target: s,
                provider: a.provider,
                verifier: a.verifier,
                review_period: a.review_period,
                n: a.n,
                amounts: a.amounts,
                deliver_by: a.deliver_by,
                specs: a.specs,
            },
        )
    assert!(id == 1)
    let ag = agreement(s, 1)
    assert!(ag.0 == actor, "the actor is the client")
    assert!(ag.0 != evm.address())
    assert!(evm.balance(s) == ether(6) && outstanding(s) == ether(6))

    // Distinctness is judged against the real caller: the actor as its own provider is
    // rejected, while the test contract (a different address) as provider is accepted.
    let by_itself = evm
        .try_call(
            addr: actor,
            gas: 2000000,
            value: ether(6),
            message: ActorMsg::CreateVia {
                target: s,
                provider: actor,
                verifier: a.verifier,
                review_period: a.review_period,
                n: a.n,
                amounts: a.amounts,
                deliver_by: a.deliver_by,
                specs: a.specs,
            },
        )
    assert!(
        !by_itself.success(),
        "the actor cannot be its own provider",
    )
    assert!(
        outstanding(s) == ether(6),
        "the rejected call left nothing behind",
    )
    let other = evm
        .try_call(
            addr: actor,
            gas: 2000000,
            value: ether(6),
            message: ActorMsg::CreateVia {
                target: s,
                provider: evm.address(),
                verifier: a.verifier,
                review_period: a.review_period,
                n: a.n,
                amounts: a.amounts,
                deliver_by: a.deliver_by,
                specs: a.specs,
            },
        )
    assert!(other.success(), "a different provider is accepted")
    assert!(
        agreement(s, 2).0 == actor && agreement(s, 2).1 == evm.address(),
    )
    assert!(outstanding(s) == ether(12))
}

// A `u8` field is range-checked at ABI decode (experiments/review/u1_u8_abi.fe). If it were
// truncated instead, n = 259 would silently become n = 3. This mirrors the production message
// with a wide `n` and the same 4-byte selector. It lives in the dev ingot because the
// production ingot may not use a selector that is not `sol(..)` (lint C-ABI, R-002 finding 1),
// and `sol(..)` itself cannot be used here: the compiler checks it against the `u256` field.
msg WideCreate {
    // keccak256("create(address,address,uint256,uint8,uint256[3],uint256[3],uint256[3])")[:4]
    #[selector = 0x75ac1b9d]
    Create {
        provider: Address,
        verifier: Address,
        review_period: Duration,
        n: u256,
        amounts: [Wei; 3],
        deliver_by: [Timestamp; 3],
        specs: [u256; 3],
    } -> u256,
}

fn try_wide(_ s: Address, _ a: Args, _ n: u256, _ value: Wei) -> bool
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 1000000,
        value,
        message: WideCreate::Create {
            provider: a.provider,
            verifier: a.verifier,
            review_period: a.review_period,
            n,
            amounts: a.amounts,
            deliver_by: a.deliver_by,
            specs: a.specs,
        },
    )
        .success()
}

#[test(balance = 100_000_000_000_000_000_000)]
fn a_wide_n_is_rejected_at_decode_and_never_truncated() uses (evm: mut Evm) {
    probe()
    let s = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let now = evm.timestamp().as_seconds()
    let a = valid(now)
    assert!(
        try_wide(s, a, 3, ether(6)),
        "positive control: the wide mirror works with n = 3",
    )
    assert!(
        !try_wide(s, a, 256, ether(6)),
        "n = 256 must not wrap to 0",
    )
    assert!(
        !try_wide(s, a, 259, ether(6)),
        "n = 259 must not wrap to 3",
    )
    assert!(!try_wide(s, a, MAX, ether(6)), "n = 2^256 - 1")
    assert!(
        outstanding(s) == ether(6) && evm.balance(s) == ether(6),
        "only the control created anything",
    )
    assert!(!exists(s, 2), "no second agreement")
}

#[test(balance = 200_000_000_000_000_000_000)]
fn the_shell_judges_every_slot_against_one_clock() uses (evm: mut Evm) {
    probe()
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 1)

    // Clock at 1000. In every position the boundary is the same: 1000 and below are rejected,
    // 1001 is accepted. A clock that moved with the slot index would break one of these.
    set_time(shell, 1000)
    assert!(
        try_create(shell, two(1001, 1001), ether(3)),
        "positive control: both slots 1001",
    )
    assert!(
        !try_create(shell, two(1000, 1001), ether(3)),
        "slot 0 == 1000",
    )
    assert!(
        !try_create(shell, two(1001, 1000), ether(3)),
        "slot 1 == 1000",
    )
    assert!(
        !try_create(shell, two(999, 1001), ether(3)),
        "slot 0 == 999",
    )
    assert!(
        !try_create(shell, two(1001, 999), ether(3)),
        "slot 1 == 999",
    )
    assert!(
        try_create(shell, two(1002, 1001), ether(3)),
        "slot 1 == 1001, slot 0 later",
    )
    assert!(
        try_create(shell, three(1001, 1001, 1001), ether(6)),
        "positive control: three slots 1001",
    )
    assert!(
        !try_create(shell, three(1001, 1001, 1000), ether(6)),
        "slot 2 == 1000",
    )
    assert!(
        !try_create(shell, three(1000, 1001, 1001), ether(6)),
        "slot 0 == 1000",
    )
    assert!(
        !try_create(shell, three(1001, 1000, 1001), ether(6)),
        "slot 1 == 1000",
    )
    assert!(
        outstanding(shell) == ether(12),
        "three accepted: 3 + 3 + 6 ETH, rejections left nothing",
    )

    // Move the clock: the same inputs are judged against the new time, in every slot.
    set_time(shell, 2000)
    assert!(
        !try_create(shell, two(1001, 1001), ether(3)),
        "both slots now in the past",
    )
    assert!(
        !try_create(shell, two(2001, 1001), ether(3)),
        "slot 1 is in the past",
    )
    assert!(
        !try_create(shell, two(1001, 2001), ether(3)),
        "slot 0 is in the past",
    )
    assert!(
        try_create(shell, two(2001, 2001), ether(3)),
        "both slots 2001",
    )
    assert!(
        outstanding(shell) == ether(15) && evm.balance(shell) == ether(15),
    )
}

#[test(balance = 400_000_000_000_000_000_000)]
fn shell_and_production_agree_on_every_two_and_three_milestone_boundary()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 2)
    let now = evm.timestamp().as_seconds()
    set_time(shell, now)

    // Offsets around `now` for each slot: -1, 0, +1. Every combination for two slots (9) must
    // get the same verdict from both contracts, and only (+1, +1) is accepted.
    var accepted: u256 = 0
    var x: u256 = 0
    while x < 3 {
        var y: u256 = 0
        while y < 3 {
            let ok = agree(prod, shell, two(now + x - 1, now + y - 1), ether(3))
            assert!(
                ok == (x == 2 && y == 2),
                "only both slots at now + 1 is accepted",
            )
            if ok { accepted += 1 }
            y += 1
        }
        x += 1
    }
    assert!(accepted == 1)
    // And one slot at a time on a three-milestone agreement (the others far ahead).
    var k: u8 = 0
    while k < 3 {
        var off: u256 = 0
        while off < 3 {
            var due = [now + 100, now + 200, now + 300]
            due[k as usize] = now + off - 1
            let ok = agree(prod, shell, three(due[0], due[1], due[2]), ether(6))
            assert!(ok == (off == 2), "slot k is accepted only at now + 1")
            if ok { accepted += 1 }
            off += 1
        }
        k += 1
    }
    assert!(accepted == 4, "1 + 3 accepted")
    same_state(prod, shell, 1)
    same_state(prod, shell, 4)
    assert!(
        outstanding(prod) == outstanding(shell) && evm.balance(prod) == evm.balance(shell),
    )
}

// ===================================================================== Phase 2B
// The roles are Actors: the harness has no caller impersonation, so the provider, the verifier
// and a stranger are three separate contracts that forward calls to Settlane. The client is the
// test contract. Every negative case asserts WHY the call reverted (the reason survives the Actor).

enum Why {
    UnknownAgreement,
    NotProvider,
    NotVerifier,
    NoSuchMilestone,
    WrongState,
    NotSubmitted,
    DeliveryClosed,
    ReviewClosed,
    ZeroEvidence,
    EvidenceMismatch,
    RevisionMismatch,
    NotApproved,
    ZeroPayee,
    TransferFailed,
    NotClient,
    NotRefundable,
    NotExpired,
}

impl Copy for Why {}

fn because(_ out: CallOutcome, _ why: Why) -> bool {
    if out.success() {
        return false
    }
    let reason = match decode_error_string(out.returndata()) {
        Option::Some(reason) => reason,
        Option::None => {
            return false
        },
    }
    match why {
        Why::NotApproved => reason == "milestone is not approved",
        Why::ZeroPayee => reason == "payee is zero",
        Why::TransferFailed => reason == "transfer failed",
        Why::NotClient => reason == "caller is not the client",
        Why::NotRefundable => reason == "milestone cannot be refunded in this state",
        Why::NotExpired => reason == "milestone has not expired",
        Why::UnknownAgreement => reason == "unknown agreement",
        Why::NotProvider => reason == "caller is not the provider",
        Why::NotVerifier => reason == "caller is not the verifier",
        Why::NoSuchMilestone => reason == "no such milestone",
        Why::WrongState => reason == "milestone cannot take evidence in this state",
        Why::NotSubmitted => reason == "milestone is not submitted",
        Why::DeliveryClosed => reason == "delivery window is closed",
        Why::ReviewClosed => reason == "review window is closed",
        Why::ZeroEvidence => reason == "evidence is zero",
        Why::EvidenceMismatch => reason == "evidence does not match the submitted evidence",
        Why::RevisionMismatch => reason == "submission revision does not match",
    }
}

fn actor(_ salt: u256) -> Address uses (evm: mut Evm) {
    evm.create2<Actor>(value: Wei::zero(), args: (), salt)
}

fn parties(_ a: Args, _ p: Address, _ v: Address) -> Args {
    var b = a
    b.provider = p
    b.verifier = v
    b
}

// `by` forwards the call to `s`, so Settlane sees `by` as the caller.
fn submit_out(_ by: Address, _ s: Address, _ id: u256, _ m: u8, _ e: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: by,
        gas: 2000000,
        value: Wei::zero(),
        message: ActorMsg::SubmitVia { target: s, id, m, evidence: e },
    )
}

fn approve_out(
    _ by: Address,
    _ s: Address,
    _ id: u256,
    _ m: u8,
    _ e: u256,
    _ revision: u256,
) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: by,
        gas: 2000000,
        value: Wei::zero(),
        message: ActorMsg::ApproveVia { target: s, id, m, evidence: e, revision },
    )
}

fn reject_out(
    _ by: Address,
    _ s: Address,
    _ id: u256,
    _ m: u8,
    _ e: u256,
    _ revision: u256,
) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: by,
        gas: 2000000,
        value: Wei::zero(),
        message: ActorMsg::RejectVia { target: s, id, m, evidence: e, revision },
    )
}

// Direct calls from the test contract (the client).
fn submit_direct(_ s: Address, _ id: u256, _ m: u8, _ e: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Submit { id, m, evidence: e },
    )
}

fn approve_direct(_ s: Address, _ id: u256, _ m: u8, _ e: u256, _ revision: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Approve { id, m, evidence: e, revision },
    )
}

fn reject_direct(_ s: Address, _ id: u256, _ m: u8, _ e: u256, _ revision: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Reject { id, m, evidence: e, revision },
    )
}

fn state_of(_ s: Address, _ id: u256, _ m: u8) -> u8 uses (evm: mut Evm) {
    milestone(s, id, m).0
}

fn evidence_of(_ s: Address, _ id: u256, _ m: u8) -> u256 uses (evm: mut Evm) {
    milestone(s, id, m).5
}

fn rejections_of(_ s: Address, _ id: u256, _ m: u8) -> u256
uses (evm: mut Evm)
{
    milestone(s, id, m).6
}

fn same_milestone(
    _ a: (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256),
    _ b: (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256),
) -> bool {
    a.0 == b.0
        && a.1 == b.1
        && a.2 == b.2
        && a.3 == b.3
        && a.4 == b.4
        && a.5 == b.5
        && a.6 == b.6
        && a.7 == b.7
}

// The fields no transition may ever change: amount, both deadlines and the spec.
fn fixed_fields(
    _ a: (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256),
    _ b: (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256),
) -> bool {
    a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4
}

// A transition moves no ETH: what the contract holds is exactly what is owed (no surplus here).
fn assert_money(_ s: Address, _ owed: Wei) uses (evm: mut Evm) {
    assert!(outstanding(s) == owed, "total outstanding changed")
    assert!(evm.balance(s) == owed, "the contract balance changed")
}

#[test(balance = 300_000_000_000_000_000_000)]
fn provider_submits_and_verifier_approves_on_production_with_the_real_clock()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(two(now + 100, now + 200), p, v), ether(3)) == 1,
    )
    let funded = milestone(prod, 1, 0)
    assert!(
        funded.0 == 1 && funded.5 == 0 && funded.6 == 0,
        "Funded, no evidence, no rejections",
    )

    assert!(
        submit_out(p, prod, 1, 0, 0xe1).success(),
        "the provider submits",
    )
    let submitted = milestone(prod, 1, 0)
    assert!(
        submitted.0 == 2 && submitted.5 == 0xe1 && submitted.6 == 0,
        "Submitted with the evidence",
    )
    assert!(
        fixed_fields(funded, submitted),
        "amount, deadlines and spec are untouched",
    )
    assert!(state_of(prod, 1, 1) == 1, "milestone 1 is independent")

    assert!(
        approve_out(v, prod, 1, 0, 0xe1, 1).success(),
        "the verifier approves",
    )
    let approved = milestone(prod, 1, 0)
    assert!(
        approved.0 == 3 && approved.5 == 0xe1 && approved.6 == 0,
        "Approved, the evidence is kept",
    )
    assert!(
        fixed_fields(funded, approved),
        "approval changes only the state",
    )

    assert!(submit_out(p, prod, 1, 1, 0xe2).success())
    assert!(approve_out(v, prod, 1, 1, 0xe2, 1).success())
    assert!(
        state_of(prod, 1, 1) == 3 && evidence_of(prod, 1, 1) == 0xe2,
    )
    // No ETH moved and approval paid nothing: everything is still owed.
    assert_money(prod, ether(3))
    let acc = accounting(prod, 1)
    assert!(
        acc.0 == ether(3) && acc.1 == Wei::zero() && acc.2 == Wei::zero() && acc.3 == ether(3),
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn only_the_provider_submits_and_only_the_verifier_reviews()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let st = actor(13)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(two(now + 100, now + 200), p, v), ether(3)) == 1,
    )
    let f0 = milestone(prod, 1, 0)
    let f1 = milestone(prod, 1, 1)

    // Funded: only the provider may submit.
    assert!(
        because(submit_out(v, prod, 1, 0, 0xe1), Why::NotProvider),
        "the verifier cannot submit",
    )
    assert!(
        because(submit_out(st, prod, 1, 0, 0xe1), Why::NotProvider),
        "a stranger cannot submit",
    )
    assert!(
        because(submit_direct(prod, 1, 0, 0xe1), Why::NotProvider),
        "the client cannot submit",
    )
    // Reviewing a Funded milestone: the others lack the role, and the verifier has the wrong state.
    assert!(
        because(approve_out(p, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
        "the provider cannot approve",
    )
    assert!(
        because(approve_out(st, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(approve_direct(prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(reject_out(p, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(reject_out(st, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(reject_direct(prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(approve_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
        "the verifier, but nothing is submitted",
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
    )
    assert!(
        same_milestone(milestone(prod, 1, 0), f0) && same_milestone(milestone(prod, 1, 1), f1),
        "nothing changed",
    )

    // The provider submits both milestones (positive control).
    assert!(submit_out(p, prod, 1, 0, 0xe1).success())
    assert!(submit_out(p, prod, 1, 1, 0xe2).success())
    let s0 = milestone(prod, 1, 0)
    let s1 = milestone(prod, 1, 1)

    // Submitted: still only the provider may resubmit, and only the verifier may review.
    assert!(because(submit_out(v, prod, 1, 0, 0xe9), Why::NotProvider))
    assert!(
        because(submit_out(st, prod, 1, 0, 0xe9), Why::NotProvider),
    )
    assert!(because(submit_direct(prod, 1, 0, 0xe9), Why::NotProvider))
    assert!(
        because(approve_out(p, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
        "the provider cannot approve its own work",
    )
    assert!(
        because(approve_out(st, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(approve_direct(prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(reject_out(p, prod, 1, 1, 0xe2, 1), Why::NotVerifier),
        "the provider cannot reject",
    )
    assert!(
        because(reject_out(st, prod, 1, 1, 0xe2, 1), Why::NotVerifier),
    )
    assert!(
        because(reject_direct(prod, 1, 1, 0xe2, 1), Why::NotVerifier),
    )
    assert!(
        same_milestone(milestone(prod, 1, 0), s0) && same_milestone(milestone(prod, 1, 1), s1),
        "nothing changed",
    )

    // The verifier acts (positive controls): approve one, reject the other.
    assert!(approve_out(v, prod, 1, 0, 0xe1, 1).success())
    assert!(reject_out(v, prod, 1, 1, 0xe2, 1).success())
    assert!(state_of(prod, 1, 0) == 3, "milestone 0 Approved")
    assert!(
        state_of(prod, 1, 1) == 1 && evidence_of(prod, 1, 1) == 0 && rejections_of(prod, 1, 1) == 1,
        "milestone 1 back to Funded",
    )
    assert_money(prod, ether(3))
}

#[test(balance = 300_000_000_000_000_000_000)]
fn evidence_must_match_and_stale_evidence_can_neither_be_approved_nor_rejected()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 1,
    )

    assert!(
        because(submit_out(p, prod, 1, 0, 0), Why::ZeroEvidence),
        "zero evidence cannot be submitted",
    )
    assert!(state_of(prod, 1, 0) == 1, "still Funded")
    assert!(
        submit_out(p, prod, 1, 0, 0xe1).success(),
        "positive control: evidence e1",
    )

    // The verifier must name exactly the stored evidence (D-015), for approve and for reject.
    assert!(
        because(approve_out(v, prod, 1, 0, 0, 1), Why::EvidenceMismatch),
        "zero never matches",
    )
    assert!(
        because(
            approve_out(v, prod, 1, 0, 0x99, 1),
            Why::EvidenceMismatch,
        ),
        "a different evidence",
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0, 1), Why::EvidenceMismatch),
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0x99, 1), Why::EvidenceMismatch),
    )
    assert!(
        state_of(prod, 1, 0) == 2 && evidence_of(prod, 1, 0) == 0xe1,
        "still Submitted with e1",
    )

    // Reject e1: back to Funded, the evidence is cleared, the counter is 1.
    assert!(reject_out(v, prod, 1, 0, 0xe1, 1).success())
    assert!(
        state_of(prod, 1, 0) == 1 && evidence_of(prod, 1, 0) == 0 && rejections_of(prod, 1, 0) == 1,
    )
    assert!(
        because(approve_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
        "nothing is submitted any more",
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
    )

    // The provider resubmits e2. The verifier's old e1 is now stale (the S-1 race of D-015).
    assert!(submit_out(p, prod, 1, 0, 0xe2).success())
    assert!(
        because(reject_out(v, prod, 1, 0, 0xe1, 1), Why::EvidenceMismatch),
        "a Reject meant for e1 must not hit e2",
    )
    assert!(
        because(
            approve_out(v, prod, 1, 0, 0xe1, 1),
            Why::EvidenceMismatch,
        ),
        "an Approve meant for e1 must not hit e2",
    )
    assert!(
        state_of(prod, 1, 0) == 2
            && evidence_of(prod, 1, 0) == 0xe2
            && rejections_of(prod, 1, 0) == 1,
    )

    // A resubmission while Submitted replaces the evidence; only the latest can be approved.
    assert!(submit_out(p, prod, 1, 0, 0xe3).success())
    assert!(evidence_of(prod, 1, 0) == 0xe3)
    assert!(
        because(
            approve_out(v, prod, 1, 0, 0xe2, 1),
            Why::EvidenceMismatch,
        ),
        "e2 was replaced",
    )
    assert!(
        approve_out(v, prod, 1, 0, 0xe3, 3).success(),
        "e3 is approved",
    )
    assert!(
        state_of(prod, 1, 0) == 3
            && evidence_of(prod, 1, 0) == 0xe3
            && rejections_of(prod, 1, 0) == 1,
    )
    assert_money(prod, ether(1))
}

#[test(balance = 300_000_000_000_000_000_000)]
fn replays_and_invalid_transitions_are_rejected_and_an_approved_milestone_never_changes()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 1,
    )
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 2,
    )

    // Agreement 1 goes to Approved. A replay of every step, and every other action, is rejected.
    assert!(submit_out(p, prod, 1, 0, 0xe1).success())
    assert!(
        submit_out(p, prod, 1, 0, 0xe1).success(),
        "an identical resubmission advances the revision",
    )
    assert!(
        state_of(prod, 1, 0) == 2
            && evidence_of(prod, 1, 0) == 0xe1
            && rejections_of(prod, 1, 0) == 0,
    )
    assert!(approve_out(v, prod, 1, 0, 0xe1, 2).success())
    let approved = milestone(prod, 1, 0)
    assert!(approved.0 == 3)
    assert!(
        because(approve_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
        "replayed approve",
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
        "reject after approve",
    )
    assert!(
        because(submit_out(p, prod, 1, 0, 0xe1), Why::WrongState),
        "replayed submit after approve",
    )
    assert!(
        because(submit_out(p, prod, 1, 0, 0xe7), Why::WrongState),
        "new evidence after approve",
    )
    assert!(
        same_milestone(milestone(prod, 1, 0), approved),
        "an approved milestone never changes",
    )
    assert_money(prod, ether(2))

    // Agreement 2 goes Funded -> Submitted -> Funded (rejected). Replays and wrong-state calls fail.
    assert!(
        because(approve_out(v, prod, 2, 0, 0xe1, 1), Why::NotSubmitted),
        "approve from Funded",
    )
    assert!(
        because(reject_out(v, prod, 2, 0, 0xe1, 1), Why::NotSubmitted),
        "reject from Funded",
    )
    assert!(submit_out(p, prod, 2, 0, 0xe1).success())
    assert!(reject_out(v, prod, 2, 0, 0xe1, 1).success())
    assert!(
        because(reject_out(v, prod, 2, 0, 0xe1, 1), Why::NotSubmitted),
        "replayed reject",
    )
    assert!(
        because(approve_out(v, prod, 2, 0, 0xe1, 1), Why::NotSubmitted),
        "approve after reject",
    )
    assert!(
        state_of(prod, 2, 0) == 1 && rejections_of(prod, 2, 0) == 1,
        "back to Funded, counted once",
    )
    assert!(
        submit_out(p, prod, 2, 0, 0xe2).success(),
        "and it can be submitted again",
    )
    assert!(
        same_milestone(milestone(prod, 1, 0), approved),
        "agreement 1 was never touched",
    )
    assert_money(prod, ether(2))
}

// Time-dependent tests use the test-clock shell. The agreement is created at shell time 1000 with
// deliver_by 2000 and a 3600 s review period, so decide_by is 5600.
fn shell_at_1000() -> Address uses (evm: mut Evm) {
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 1)
    set_time(shell, 1000)
    shell
}

#[test(balance = 300_000_000_000_000_000_000)]
fn the_delivery_window_closes_exactly_at_deliver_by() uses (evm: mut Evm) {
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    var i: u256 = 0
    while i < 6 {
        assert!(
            create(shell, parties(single(2000), p, v), ether(1)) == i + 1,
        )
        i += 1
    }
    // Agreement 1: d - 1 is open.
    set_time(shell, 1999)
    assert!(submit_out(p, shell, 1, 0, 0xe1).success(), "d - 1: open")
    assert!(state_of(shell, 1, 0) == 2)
    // Agreements 2 and 3: d and d + 1 are closed, and the milestone stays Funded with no evidence.
    set_time(shell, 2000)
    assert!(
        because(submit_out(p, shell, 2, 0, 0xe1), Why::DeliveryClosed),
        "d: closed",
    )
    set_time(shell, 2001)
    assert!(
        because(submit_out(p, shell, 3, 0, 0xe1), Why::DeliveryClosed),
        "d + 1: closed",
    )
    assert!(
        state_of(shell, 2, 0) == 1 && evidence_of(shell, 2, 0) == 0,
        "agreement 2 stays Funded",
    )
    assert!(state_of(shell, 3, 0) == 1)
    // Resubmission is the same window: submitted at d - 1, a resubmission at d is closed.
    set_time(shell, 1999)
    assert!(submit_out(p, shell, 4, 0, 0xe1).success())
    set_time(shell, 2000)
    assert!(
        because(submit_out(p, shell, 4, 0, 0xe2), Why::DeliveryClosed),
        "no resubmission at d",
    )
    assert!(
        state_of(shell, 4, 0) == 2 && evidence_of(shell, 4, 0) == 0xe1,
        "the old evidence stands",
    )
    // A milestone rejected before d and still Funded at d cannot take new evidence: it is stuck.
    set_time(shell, 1999)
    assert!(submit_out(p, shell, 5, 0, 0xe1).success())
    assert!(reject_out(v, shell, 5, 0, 0xe1, 1).success())
    set_time(shell, 2000)
    assert!(
        because(submit_out(p, shell, 5, 0, 0xe2), Why::DeliveryClosed),
        "rejected, then d: closed",
    )
    assert!(
        state_of(shell, 5, 0) == 1 && rejections_of(shell, 5, 0) == 1,
    )
    assert_money(shell, ether(6))
}

#[test(balance = 300_000_000_000_000_000_000)]
fn the_review_window_closes_exactly_at_decide_by_and_a_late_submission_keeps_it_whole()
uses (evm: mut Evm)
{
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    var i: u256 = 0
    while i < 6 {
        assert!(
            create(shell, parties(single(2000), p, v), ether(1)) == i + 1,
        )
        i += 1
    }
    // Everything is submitted at d - 1 = 1999, one second before delivery closes.
    set_time(shell, 1999)
    var id: u256 = 1
    while id <= 6 {
        assert!(submit_out(p, shell, id, 0, 0xe0 + id).success())
        id += 1
    }
    // The delivery window is now closed, but the review window (decide_by = 5600) is whole.
    set_time(shell, 3000)
    assert!(
        approve_out(v, shell, 1, 0, 0xe1, 1).success(),
        "approve long after d, before decide_by",
    )
    set_time(shell, 5599)
    assert!(
        approve_out(v, shell, 2, 0, 0xe2, 1).success(),
        "decide_by - 1: approve is open",
    )
    assert!(
        reject_out(v, shell, 3, 0, 0xe3, 1).success(),
        "decide_by - 1: reject is open",
    )
    set_time(shell, 5600)
    assert!(
        because(approve_out(v, shell, 4, 0, 0xe4, 1), Why::ReviewClosed),
        "decide_by: approve is closed",
    )
    assert!(
        because(reject_out(v, shell, 4, 0, 0xe4, 1), Why::ReviewClosed),
        "decide_by: reject is closed",
    )
    set_time(shell, 5601)
    assert!(
        because(approve_out(v, shell, 5, 0, 0xe5, 1), Why::ReviewClosed),
        "decide_by + 1: closed",
    )
    assert!(
        because(reject_out(v, shell, 6, 0, 0xe6, 1), Why::ReviewClosed),
    )
    // A closed review leaves the milestone Submitted (a refund in a later phase can take it).
    assert!(
        state_of(shell, 4, 0) == 2 && evidence_of(shell, 4, 0) == 0xe4,
    )
    assert!(state_of(shell, 5, 0) == 2 && state_of(shell, 6, 0) == 2)
    // And the provider cannot resubmit either: the delivery window closed at 2000.
    assert!(
        because(submit_out(p, shell, 4, 0, 0xea), Why::DeliveryClosed),
    )
    assert!(
        state_of(shell, 1, 0) == 3 && state_of(shell, 2, 0) == 3,
        "approved",
    )
    assert!(
        state_of(shell, 3, 0) == 1 && rejections_of(shell, 3, 0) == 1,
        "rejected at decide_by - 1",
    )
    assert_money(shell, ether(6))
}

#[test(balance = 300_000_000_000_000_000_000)]
fn an_approved_milestone_stays_immutable_through_every_deadline()
uses (evm: mut Evm)
{
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    assert!(create(shell, parties(single(2000), p, v), ether(1)) == 1)
    set_time(shell, 1500)
    assert!(submit_out(p, shell, 1, 0, 0xe1).success())
    set_time(shell, 1600)
    assert!(approve_out(v, shell, 1, 0, 0xe1, 1).success())
    let approved = milestone(shell, 1, 0)
    assert!(approved.0 == 3)

    // At each of these times every action by the right role is rejected, and nothing changes.
    // The state is checked before the window, so the reason is the state, even after the deadlines.
    var times = [1601, 1999, 2000, 5599, 5600, 1000000]
    var k: u8 = 0
    while k < 6 {
        set_time(shell, times[k as usize])
        assert!(
            because(submit_out(p, shell, 1, 0, 0xe1), Why::WrongState),
            "submit",
        )
        assert!(
            because(submit_out(p, shell, 1, 0, 0xee), Why::WrongState),
            "submit new evidence",
        )
        assert!(
            because(approve_out(v, shell, 1, 0, 0xe1, 1), Why::NotSubmitted),
            "approve",
        )
        assert!(
            because(reject_out(v, shell, 1, 0, 0xe1, 1), Why::NotSubmitted),
            "reject",
        )
        assert!(
            same_milestone(milestone(shell, 1, 0), approved),
            "unchanged",
        )
        k += 1
    }
    assert_money(shell, ether(1))
    let acc = accounting(shell, 1)
    assert!(
        acc.0 == ether(1) && acc.1 == Wei::zero() && acc.2 == Wei::zero() && acc.3 == ether(1),
        "approval never expires",
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn unknown_agreements_and_unused_milestones_are_rejected_by_the_right_role_on_both_contracts()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 2)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    set_time(shell, now)
    let targets = [prod, shell]

    var t: u8 = 0
    while t < 2 {
        let s = targets[t as usize]
        // No agreement yet: ids 0 and 1 are unknown, whoever calls.
        assert!(
            because(submit_out(p, s, 0, 0, 0xe1), Why::UnknownAgreement),
            "id 0",
        )
        assert!(
            because(approve_out(v, s, 0, 0, 0xe1, 1), Why::UnknownAgreement),
        )
        assert!(
            because(reject_out(v, s, 0, 0, 0xe1, 1), Why::UnknownAgreement),
        )
        assert!(
            because(submit_out(p, s, 1, 0, 0xe1), Why::UnknownAgreement),
            "before any agreement",
        )
        assert!(
            because(approve_out(v, s, 1, 0, 0xe1, 1), Why::UnknownAgreement),
        )
        assert!(
            because(reject_out(v, s, 1, 0, 0xe1, 1), Why::UnknownAgreement),
        )
        assert!(
            create(s, parties(single(now + 100), p, v), ether(1)) == 1,
            "positive control",
        )
        // Known agreement, wrong id.
        assert!(
            because(submit_out(p, s, 2, 0, 0xe1), Why::UnknownAgreement),
            "id 2",
        )
        assert!(
            because(approve_out(v, s, MAX, 0, 0xe1, 1), Why::UnknownAgreement),
            "id 2^256 - 1",
        )
        assert!(
            because(reject_out(v, s, MAX, 0, 0xe1, 1), Why::UnknownAgreement),
        )
        // Known agreement with one milestone: slots 1, 2, 3 and 255 are unused.
        var slot: u8 = 1
        while slot != 0 {
            assert!(
                because(submit_out(p, s, 1, slot, 0xe1), Why::NoSuchMilestone),
                "unused slot, submit",
            )
            assert!(
                because(approve_out(v, s, 1, slot, 0xe1, 1), Why::NoSuchMilestone),
                "unused slot, approve",
            )
            assert!(
                because(reject_out(v, s, 1, slot, 0xe1, 1), Why::NoSuchMilestone),
                "unused slot, reject",
            )
            if slot == 3 {
                slot = 255
            } else if slot == 255 { slot = 0 } else { slot += 1 }
        }
        assert!(
            state_of(s, 1, 0) == 1 && state_of(s, 1, 1) == 0,
            "the unused slot stayed None",
        )
        assert!(
            submit_out(p, s, 1, 0, 0xe1).success(),
            "positive control: slot 0 works",
        )
        assert_money(s, ether(1))
        t += 1
    }
}

#[test(balance = 400_000_000_000_000_000_000)]
fn agreements_are_isolated_and_milestones_are_independent()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p1 = actor(21)
    let v1 = actor(22)
    let p2 = actor(23)
    let v2 = actor(24)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(
                prod,
                parties(three(now + 100, now + 200, now + 300), p1, v1),
                ether(6),
            ) == 1,
    )
    assert!(
        create(
                prod,
                parties(three(now + 100, now + 200, now + 300), p2, v2),
                ether(6),
            ) == 2,
    )
    let other0 = milestone(prod, 2, 0)
    let other1 = milestone(prod, 2, 1)
    let other2 = milestone(prod, 2, 2)

    // Agreement 1's roles have no power over agreement 2, and the reverse.
    assert!(
        because(submit_out(p1, prod, 2, 0, 0xe1), Why::NotProvider),
        "provider 1 on agreement 2",
    )
    assert!(
        because(submit_out(p2, prod, 1, 0, 0xe1), Why::NotProvider),
        "provider 2 on agreement 1",
    )
    // Work on agreement 1: m0 approved, m1 submitted then rejected, m2 untouched.
    assert!(submit_out(p1, prod, 1, 0, 0xa0).success())
    assert!(submit_out(p1, prod, 1, 1, 0xa1).success())
    assert!(approve_out(v1, prod, 1, 0, 0xa0, 1).success())
    assert!(reject_out(v1, prod, 1, 1, 0xa1, 1).success())
    assert!(
        state_of(prod, 1, 0) == 3 && state_of(prod, 1, 1) == 1 && state_of(prod, 1, 2) == 1,
        "independent milestones",
    )
    assert!(
        rejections_of(prod, 1, 0) == 0
            && rejections_of(prod, 1, 1) == 1
            && rejections_of(prod, 1, 2) == 0,
        "independent counters",
    )
    assert!(
        evidence_of(prod, 1, 0) == 0xa0
            && evidence_of(prod, 1, 1) == 0
            && evidence_of(prod, 1, 2) == 0,
    )
    // Agreement 2 has not changed at all.
    assert!(same_milestone(milestone(prod, 2, 0), other0))
    assert!(same_milestone(milestone(prod, 2, 1), other1))
    assert!(same_milestone(milestone(prod, 2, 2), other2))

    // Submitted on agreement 2: verifier 1 cannot touch it, verifier 2 can, and 1 is still unchanged.
    assert!(submit_out(p2, prod, 2, 0, 0xb0).success())
    assert!(
        because(approve_out(v1, prod, 2, 0, 0xb0, 1), Why::NotVerifier),
        "verifier 1 on agreement 2",
    )
    assert!(
        because(reject_out(v1, prod, 2, 0, 0xb0, 1), Why::NotVerifier),
    )
    assert!(
        because(approve_out(v2, prod, 1, 2, 0xb0, 1), Why::NotVerifier),
        "verifier 2 holds no role on agreement 1: the role is checked before the state",
    )
    assert!(approve_out(v2, prod, 2, 0, 0xb0, 1).success())
    assert!(
        state_of(prod, 2, 0) == 3 && state_of(prod, 1, 0) == 3,
        "both approved, separately",
    )
    assert!(
        evidence_of(prod, 1, 0) == 0xa0 && evidence_of(prod, 2, 0) == 0xb0,
        "each keeps its own evidence",
    )
    assert_money(prod, ether(12))
    assert!(
        accounting(prod, 1).3 == ether(6) && accounting(prod, 2).3 == ether(6),
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn the_rejection_counter_counts_every_revision_request_and_never_decreases()
uses (evm: mut Evm)
{
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    assert!(create(shell, parties(single(2000), p, v), ether(1)) == 1)
    var k: u256 = 0
    while k < 3 {
        set_time(shell, 1100 + k)
        assert!(
            submit_out(p, shell, 1, 0, 0xc0 + k).success(),
            "submit revision k",
        )
        assert!(evidence_of(shell, 1, 0) == 0xc0 + k)
        assert!(
            reject_out(v, shell, 1, 0, 0xc0 + k, k + 1).success(),
            "reject revision k",
        )
        assert!(
            rejections_of(shell, 1, 0) == k + 1,
            "the counter goes up by one",
        )
        assert!(
            evidence_of(shell, 1, 0) == 0 && state_of(shell, 1, 0) == 1,
            "evidence cleared, Funded again",
        )
        k += 1
    }
    set_time(shell, 1500)
    assert!(submit_out(p, shell, 1, 0, 0xcf).success())
    assert!(approve_out(v, shell, 1, 0, 0xcf, 4).success())
    assert!(
        rejections_of(shell, 1, 0) == 3,
        "approval keeps the count",
    )
    assert!(
        state_of(shell, 1, 0) == 3 && evidence_of(shell, 1, 0) == 0xcf,
    )
    assert_money(shell, ether(1))
}

#[test(balance = 400_000_000_000_000_000_000)]
fn production_and_the_shell_agree_on_every_step_of_a_transition_script()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 2)
    let p = actor(11)
    let v = actor(12)
    let st = actor(13)
    let now = evm.timestamp().as_seconds()
    set_time(shell, now)
    let a = parties(three(now + 100, now + 200, now + 300), p, v)
    assert!(create(prod, a, ether(6)) == 1)
    assert!(create(shell, a, ether(6)) == 1)

    // Each step runs on both and must get the same verdict. `true` means it was accepted.
    assert!(agree_submit(p, prod, shell, 1, 0, 0xe1), "submit e1")
    assert!(
        !agree_submit(st, prod, shell, 1, 0, 0xe2),
        "stranger submit",
    )
    assert!(!agree_submit(p, prod, shell, 1, 0, 0), "zero evidence")
    assert!(!agree_submit(p, prod, shell, 1, 5, 0xe2), "unused slot")
    assert!(
        !agree_submit(p, prod, shell, 9, 0, 0xe2),
        "unknown agreement",
    )
    assert!(
        !agree_review(false, p, prod, shell, 1, 0, 0xe1, 1),
        "approve by the provider",
    )
    assert!(
        !agree_review(true, v, prod, shell, 1, 0, 0x77, 1),
        "approve wrong evidence",
    )
    assert!(
        !agree_review(false, v, prod, shell, 1, 0, 0x77, 1),
        "reject wrong evidence",
    )
    assert!(
        agree_review(false, v, prod, shell, 1, 0, 0xe1, 1),
        "reject e1",
    )
    assert!(
        !agree_review(false, v, prod, shell, 1, 0, 0xe1, 1),
        "replayed reject",
    )
    assert!(
        !agree_review(true, v, prod, shell, 1, 0, 0xe1, 1),
        "approve after reject",
    )
    assert!(agree_submit(p, prod, shell, 1, 0, 0xe3), "resubmit e3")
    assert!(
        !agree_review(true, v, prod, shell, 1, 0, 0xe1, 1),
        "stale approve",
    )
    assert!(
        agree_review(true, v, prod, shell, 1, 0, 0xe3, 2),
        "approve e3",
    )
    assert!(
        !agree_submit(p, prod, shell, 1, 0, 0xe4),
        "submit after approve",
    )
    assert!(agree_submit(p, prod, shell, 1, 2, 0xe5), "milestone 2")
    assert!(
        agree_review(false, v, prod, shell, 1, 2, 0xe5, 1),
        "reject milestone 2",
    )
    assert!(
        agree_submit(p, prod, shell, 1, 2, 0xe5),
        "resubmit milestone 2",
    )
    assert!(
        agree_review(true, v, prod, shell, 1, 2, 0xe5, 2),
        "approve milestone 2",
    )
    same_state(prod, shell, 1)
    assert!(
        outstanding(prod) == outstanding(shell) && evm.balance(prod) == evm.balance(shell),
    )
}

fn agree_submit(
    _ by: Address,
    _ prod: Address,
    _ shell: Address,
    _ id: u256,
    _ m: u8,
    _ e: u256,
) -> bool
uses (evm: mut Evm)
{
    let x = submit_out(by, prod, id, m, e).success()
    let y = submit_out(by, shell, id, m, e).success()
    assert!(x == y, "shell and production disagree on submit")
    x
}

// approve when `approve` is true, reject otherwise
fn agree_review(
    _ approve: bool,
    _ by: Address,
    _ prod: Address,
    _ shell: Address,
    _ id: u256,
    _ m: u8,
    _ e: u256,
    _ revision: u256,
) -> bool
uses (evm: mut Evm)
{
    var x = false
    var y = false
    if approve {
        x = approve_out(by, prod, id, m, e, revision).success()
        y = approve_out(by, shell, id, m, e, revision).success()
    } else {
        x = reject_out(by, prod, id, m, e, revision).success()
        y = reject_out(by, shell, id, m, e, revision).success()
    }
    assert!(x == y, "shell and production disagree on a review")
    x
}

#[test(balance = 300_000_000_000_000_000_000)]
fn transitions_are_not_payable_and_never_move_money() uses (evm: mut Evm) {
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 1,
    )
    assert_money(prod, ether(1))

    // The same calls with value attached are rejected (non-payable) and keep nothing. Each has a
    // zero-value positive control that succeeds, so value is the only difference.
    let with_value = ether(1)
    let submit_value = evm
        .try_call(
            addr: p,
            gas: 2000000,
            value: with_value,
            message: ActorMsg::SubmitVia { target: prod, id: 1, m: 0, evidence: 0xe1 },
        )
    assert!(!submit_value.success(), "submit with value is rejected")
    assert!(
        empty_revert(submit_value),
        "submit with value: the revert data is empty (non-payable), not a reasoned revert",
    )
    assert!(state_of(prod, 1, 0) == 1, "and it changed nothing")
    assert!(
        submit_out(p, prod, 1, 0, 0xe1).success(),
        "positive control: submit without value",
    )
    let reject_value = evm
        .try_call(
            addr: v,
            gas: 2000000,
            value: with_value,
            message: ActorMsg::RejectVia { target: prod, id: 1, m: 0, evidence: 0xe1, revision: 1 },
        )
    assert!(!reject_value.success(), "reject with value is rejected")
    assert!(
        empty_revert(reject_value),
        "reject with value: the revert data is empty (non-payable), not a reasoned revert",
    )
    assert!(state_of(prod, 1, 0) == 2, "still Submitted")
    let approve_value = evm
        .try_call(
            addr: v,
            gas: 2000000,
            value: with_value,
            message: ActorMsg::ApproveVia {
                target: prod,
                id: 1,
                m: 0,
                evidence: 0xe1,
                revision: 1,
            },
        )
    assert!(!approve_value.success(), "approve with value is rejected")
    assert!(
        empty_revert(approve_value),
        "approve with value: the revert data is empty (non-payable), not a reasoned revert",
    )
    assert!(state_of(prod, 1, 0) == 2, "still Submitted")
    assert!(
        approve_out(v, prod, 1, 0, 0xe1, 1).success(),
        "positive control: approve without value",
    )
    // The contract holds exactly what it did, the totals did not move, and the actors kept their ETH.
    assert_money(prod, ether(1))
    let acc = accounting(prod, 1)
    assert!(
        acc.0 == ether(1) && acc.1 == Wei::zero() && acc.2 == Wei::zero() && acc.3 == ether(1),
        "approval pays nothing",
    )
    assert!(
        evm.balance(p) == Wei::zero() && evm.balance(v) == Wei::zero(),
        "no ETH reached the provider or the verifier",
    )
}

#[test(balance = 100_000_000_000_000_000_000)]
fn restored_and_identical_evidence_require_a_fresh_review_revision()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 1,
    )
    assert!(milestone(prod, 1, 0).7 == 0)
    assert!(submit_out(p, prod, 1, 0, 0xa1).success())
    assert!(submit_out(p, prod, 1, 0, 0xb1).success())
    assert!(submit_out(p, prod, 1, 0, 0xa1).success())
    let restored = milestone(prod, 1, 0)
    assert!(restored.7 == 3)
    assert!(
        because(
            approve_out(v, prod, 1, 0, 0xa1, 1),
            Why::RevisionMismatch,
        ),
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0xa1, 1), Why::RevisionMismatch),
    )
    assert!(same_milestone(restored, milestone(prod, 1, 0)))

    assert!(reject_out(v, prod, 1, 0, 0xa1, 3).success())
    assert!(milestone(prod, 1, 0).7 == 3)
    assert!(submit_out(p, prod, 1, 0, 0xa1).success())
    assert!(
        because(reject_out(v, prod, 1, 0, 0xa1, 3), Why::RevisionMismatch),
    )
    assert!(submit_out(p, prod, 1, 0, 0xa1).success())
    let identical = milestone(prod, 1, 0)
    assert!(
        identical.7 == 5 && identical.6 == 1 && identical.5 == 0xa1,
    )
    assert!(
        because(
            approve_out(v, prod, 1, 0, 0xa1, 4),
            Why::RevisionMismatch,
        ),
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0xa1, 4), Why::RevisionMismatch),
    )
    assert!(same_milestone(identical, milestone(prod, 1, 0)))
    assert!(approve_out(v, prod, 1, 0, 0xa1, 5).success())
    assert!(milestone(prod, 1, 0).7 == 5)
    assert_money(prod, ether(1))
}

#[test(balance = 100_000_000_000_000_000_000)]
fn third_slot_revision_lifecycle_at_both_deadlines() uses (evm: mut Evm) {
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    let args = parties(three(2000, 2000, 2000), p, v)
    assert!(create(shell, args, ether(6)) == 1)
    assert!(create(shell, args, ether(6)) == 2)
    assert!(create(shell, args, ether(6)) == 3)
    let sibling0 = milestone(shell, 1, 0)
    let sibling1 = milestone(shell, 1, 1)
    let original = milestone(shell, 1, 2)
    set_time(shell, 1999)
    assert!(submit_out(p, shell, 1, 2, 0xd1).success())
    assert!(reject_out(v, shell, 1, 2, 0xd1, 1).success())
    assert!(submit_out(p, shell, 1, 2, 0xd2).success())
    assert!(submit_out(p, shell, 2, 2, 0xd3).success())
    assert!(submit_out(p, shell, 3, 2, 0xd5).success())
    let submitted = milestone(shell, 1, 2)
    assert!(
        submitted.0 == 2 && submitted.5 == 0xd2 && submitted.6 == 1 && submitted.7 == 2,
    )
    set_time(shell, 2000)
    assert!(
        because(submit_out(p, shell, 1, 2, 0xd4), Why::DeliveryClosed),
    )
    set_time(shell, 2001)
    assert!(
        because(submit_out(p, shell, 1, 2, 0xd4), Why::DeliveryClosed),
    )
    assert!(same_milestone(submitted, milestone(shell, 1, 2)))
    set_time(shell, 5599)
    assert!(approve_out(v, shell, 1, 2, 0xd2, 2).success())
    assert!(reject_out(v, shell, 3, 2, 0xd5, 1).success())
    assert!(
        because(submit_out(p, shell, 3, 2, 0xd6), Why::DeliveryClosed),
    )
    let rejected = milestone(shell, 3, 2)
    assert!(
        rejected.0 == 1 && rejected.5 == 0 && rejected.6 == 1 && rejected.7 == 1,
    )
    let pending = milestone(shell, 2, 2)
    set_time(shell, 5600)
    assert!(
        because(approve_out(v, shell, 2, 2, 0xd3, 1), Why::ReviewClosed),
    )
    assert!(
        because(reject_out(v, shell, 2, 2, 0xd3, 1), Why::ReviewClosed),
    )
    set_time(shell, 5601)
    assert!(
        because(approve_out(v, shell, 2, 2, 0xd3, 1), Why::ReviewClosed),
    )
    assert!(
        because(reject_out(v, shell, 2, 2, 0xd3, 1), Why::ReviewClosed),
    )
    assert!(same_milestone(pending, milestone(shell, 2, 2)))
    let approved = milestone(shell, 1, 2)
    assert!(fixed_fields(original, approved))
    assert!(
        approved.0 == 3 && approved.5 == 0xd2 && approved.6 == 1 && approved.7 == 2,
    )
    assert!(same_milestone(sibling0, milestone(shell, 1, 0)))
    assert!(same_milestone(sibling1, milestone(shell, 1, 1)))
    assert_money(shell, ether(18))
}

// The accounting invariants (docs/SECURITY.md I1, I2, I9) for agreements 1..=last_id, and
// that agreement last_id + 1 does not exist. Called after every state-changing step.
// I9 is `balance >= outstanding` in general: ETH can reach the contract without an agreement
// (it is pre-funded at its address before deployment, forced in by selfdestruct or a coinbase
// reward), and nothing in the contract can claim it. `surplus` is the extra ETH the test knows
// about (zero for most tests), and the balance must be exactly `outstanding + surplus`.
fn check_invariants(_ s: Address, _ last_id: u256, _ surplus: Wei)
uses (evm: mut Evm)
{
    var id: u256 = 1
    var sum = Wei::zero()
    while id <= last_id {
        let acc = accounting(s, id)
        // I1: deposited == paid + refunded + outstanding.
        assert!(acc.0 == acc.1 + acc.2 + acc.3, "I1 conservation")
        var live = Wei::zero()
        var m: u8 = 0
        while m < 3 {
            let x = milestone(s, id, m)
            // states 1..=3 (Funded, Submitted, Approved) are still owed.
            if x.0 >= 1 && x.0 <= 3 {
                live = live + x.1
            }
            m += 1
        }
        assert!(
            live == acc.3,
            "outstanding equals the live milestone amounts",
        )
        sum = sum + acc.3
        id += 1
    }
    assert!(
        outstanding(s) == sum,
        "total outstanding equals the per-agreement sum",
    )
    // I9, general form: the contract always holds at least what it owes.
    assert!(evm.balance(s) >= sum, "I9 balance >= outstanding")
    // And exactly what the test knows: nothing was lost and nothing was created.
    assert!(
        evm.balance(s) == sum + surplus,
        "balance == outstanding + known surplus",
    )
    assert!(!exists(s, last_id + 1), "no agreement beyond last_id")
}

// F-3 (R-005): a non-payable function rejects attached value with EMPTY revert data, which tells it
// apart from every reasoned revert (`because` needs a decodable `Error(string)`).
fn empty_revert(_ out: CallOutcome) -> bool {
    !out.success() && out.returndata_len() == 0
}

// ------------------------------------------------------------------------- Phase 3A: Claim
// T5: from Approved, Claim(to) by the provider, to != 0, goes to Paid, paid += amount,
// outstanding -= amount, and sends exactly the stored amount to `to` with the 2300-gas stipend.
// Every write happens before the transfer, and a failed transfer reverts all of them.

// `by` forwards Claim to `s`, so Settlane sees `by` as the caller.
fn claim_out(_ by: Address, _ s: Address, _ id: u256, _ m: u8, _ to: Address) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: by,
        gas: 2000000,
        value: Wei::zero(),
        message: ActorMsg::ClaimVia { target: s, id, m, to },
    )
}

// A claim that must succeed. Returns what Settlane reports it sent.
fn claim_ok(_ by: Address, _ s: Address, _ id: u256, _ m: u8, _ to: Address) -> Wei
uses (evm: mut Evm)
{
    evm.call(
        addr: by,
        gas: 2000000,
        value: Wei::zero(),
        message: ActorMsg::ClaimVia { target: s, id, m, to },
    )
}

fn claim_direct(_ s: Address, _ id: u256, _ m: u8, _ to: Address) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Claim { id, m, to },
    )
}

// Submits and approves milestone m with evidence e (first submission, so revision 1).
fn approve_first(_ p: Address, _ v: Address, _ s: Address, _ id: u256, _ m: u8, _ e: u256)
uses (evm: mut Evm)
{
    assert!(submit_out(p, s, id, m, e).success(), "setup: submit")
    assert!(approve_out(v, s, id, m, e, 1).success(), "setup: approve")
    assert!(state_of(s, id, m) == 3, "setup: Approved")
}

fn same_accounting(_ a: (Wei, Wei, Wei, Wei), _ b: (Wei, Wei, Wei, Wei)) -> bool {
    a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3
}

#[test(balance = 300_000_000_000_000_000_000)]
fn the_provider_claims_an_approved_milestone_and_is_paid_the_stored_amount_once()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let payee = Address::new(0x9b1)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(
                prod,
                parties(three(now + 100, now + 200, now + 300), p, v),
                ether(6),
            ) == 1,
    )
    // A second agreement with the same parties: a claim on agreement 1 must not touch it.
    assert!(
        create(prod, parties(two(now + 100, now + 200), p, v), ether(3)) == 2,
    )
    assert_money(prod, ether(9))
    check_invariants(prod, 2, Wei::zero())
    approve_first(p, v, prod, 1, 1, 0xe2)
    let before = milestone(prod, 1, 1)
    let other0 = milestone(prod, 1, 0)
    let other2 = milestone(prod, 1, 2)
    let second = accounting(prod, 2)
    let second0 = milestone(prod, 2, 0)

    // Milestone 1 holds 2 ETH: exactly that is paid, to the chosen payee, and reported.
    assert!(
        claim_ok(p, prod, 1, 1, payee) == ether(2),
        "the claim reports the stored amount",
    )
    assert!(
        evm.balance(payee) == ether(2),
        "the payee received exactly the stored amount",
    )
    assert!(
        evm.balance(p) == Wei::zero(),
        "nothing went to the caller: `to` is the payee",
    )
    let paid = milestone(prod, 1, 1)
    assert!(paid.0 == 4, "Paid")
    assert!(
        fixed_fields(before, paid),
        "amount, deadlines and spec are unchanged",
    )
    assert!(
        paid.5 == before.5 && paid.6 == before.6 && paid.7 == before.7,
        "evidence, rejections and revision are kept",
    )
    let acc = accounting(prod, 1)
    assert!(
        acc.0 == ether(6) && acc.1 == ether(2) && acc.2 == Wei::zero() && acc.3 == ether(4),
        "deposited 6, paid 2, refunded 0, outstanding 4",
    )
    assert_money(prod, ether(7))
    check_invariants(prod, 2, Wei::zero())
    assert!(
        same_milestone(milestone(prod, 1, 0), other0),
        "milestone 0 is untouched",
    )
    assert!(
        same_milestone(milestone(prod, 1, 2), other2),
        "milestone 2 is untouched",
    )
    assert!(
        same_accounting(accounting(prod, 2), second),
        "agreement 2 is untouched",
    )
    assert!(
        same_milestone(milestone(prod, 2, 0), second0),
        "agreement 2 milestone 0 is untouched",
    )

    // Replay: the same claim, to the same or another payee, is rejected and pays nothing more.
    assert!(
        because(claim_out(p, prod, 1, 1, payee), Why::NotApproved),
        "a second claim",
    )
    assert!(
        because(claim_out(p, prod, 1, 1, p), Why::NotApproved),
        "a second claim to another payee",
    )
    // Paid is final: no transition reopens it.
    assert!(
        because(submit_out(p, prod, 1, 1, 0xe9), Why::WrongState),
        "no submission after Paid",
    )
    assert!(
        because(approve_out(v, prod, 1, 1, 0xe2, 1), Why::NotSubmitted),
        "no approval after Paid",
    )
    assert!(
        because(reject_out(v, prod, 1, 1, 0xe2, 1), Why::NotSubmitted),
        "no rejection after Paid",
    )
    assert!(
        same_milestone(milestone(prod, 1, 1), paid),
        "the paid milestone never changes",
    )
    assert!(evm.balance(payee) == ether(2), "still paid exactly once")
    assert_money(prod, ether(7))
    check_invariants(prod, 2, Wei::zero())

    // The other milestones can still be claimed, each once: the payout total equals the deposit.
    approve_first(p, v, prod, 1, 0, 0xe1)
    approve_first(p, v, prod, 1, 2, 0xe3)
    assert!(claim_ok(p, prod, 1, 0, payee) == ether(1))
    assert!(
        claim_ok(p, prod, 1, 2, Address::new(0x9b2)) == ether(3),
        "each claim chooses its own payee",
    )
    assert!(
        evm.balance(payee) == ether(3) && evm.balance(Address::new(0x9b2)) == ether(3),
    )
    let done = accounting(prod, 1)
    assert!(
        done.0 == ether(6) && done.1 == ether(6) && done.2 == Wei::zero() && done.3 == Wei::zero(),
        "fully paid: paid == deposited and nothing is outstanding",
    )
    assert_money(prod, ether(3))
    check_invariants(prod, 2, Wei::zero())
    assert!(
        same_accounting(accounting(prod, 2), second),
        "agreement 2 is still untouched",
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn only_the_provider_may_claim_and_only_an_approved_milestone_to_a_nonzero_payee()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let st = actor(13)
    let payee = Address::new(0x9b1)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(two(now + 100, now + 200), p, v), ether(3)) == 1,
    )
    let acc0 = accounting(prod, 1)

    // Funded: the others lack the role, and the provider has the wrong state.
    assert!(
        because(claim_direct(prod, 1, 0, payee), Why::NotProvider),
        "the client cannot claim",
    )
    assert!(
        because(claim_out(v, prod, 1, 0, payee), Why::NotProvider),
        "the verifier cannot claim",
    )
    assert!(
        because(claim_out(st, prod, 1, 0, payee), Why::NotProvider),
        "a stranger cannot claim",
    )
    assert!(
        because(claim_out(p, prod, 1, 0, payee), Why::NotApproved),
        "Funded is not claimable",
    )
    // Submitted is not claimable either.
    assert!(submit_out(p, prod, 1, 0, 0xe1).success())
    assert!(
        because(claim_out(p, prod, 1, 0, payee), Why::NotApproved),
        "Submitted is not claimable",
    )
    assert!(state_of(prod, 1, 0) == 2, "still Submitted")
    // A rejected milestone is back to Funded and still not claimable.
    assert!(reject_out(v, prod, 1, 0, 0xe1, 1).success())
    assert!(
        because(claim_out(p, prod, 1, 0, payee), Why::NotApproved),
        "rejected is not claimable",
    )

    // Approved: still only the provider, and never to the zero address.
    approve_first(p, v, prod, 1, 1, 0xe2)
    let approved = milestone(prod, 1, 1)
    assert!(
        because(claim_direct(prod, 1, 1, payee), Why::NotProvider),
        "the client cannot claim",
    )
    assert!(
        because(claim_direct(prod, 1, 1, evm.address()), Why::NotProvider),
        "not even to itself",
    )
    assert!(
        because(claim_out(v, prod, 1, 1, v), Why::NotProvider),
        "the verifier cannot claim",
    )
    assert!(
        because(claim_out(st, prod, 1, 1, st), Why::NotProvider),
        "a stranger cannot claim",
    )
    assert!(
        because(
            claim_out(v, prod, 1, 1, Address::zero()),
            Why::NotProvider,
        ),
        "role before payee",
    )
    assert!(
        because(claim_out(p, prod, 1, 1, Address::zero()), Why::ZeroPayee),
        "the payee is not zero",
    )
    // Unused slot and unknown agreements: the right reason, whoever asks.
    assert!(
        because(claim_out(p, prod, 1, 2, payee), Why::NoSuchMilestone),
        "slot 2 is unused",
    )
    assert!(
        because(claim_out(p, prod, 1, 3, payee), Why::NoSuchMilestone),
        "slot 3 does not exist",
    )
    assert!(
        because(claim_out(st, prod, 1, 2, payee), Why::NotProvider),
        "role before milestone",
    )
    assert!(
        because(claim_out(p, prod, 0, 1, payee), Why::UnknownAgreement),
        "id 0",
    )
    assert!(
        because(claim_out(p, prod, 2, 1, payee), Why::UnknownAgreement),
        "id 2",
    )
    assert!(
        because(claim_out(p, prod, MAX, 1, payee), Why::UnknownAgreement),
        "id 2^256 - 1",
    )

    // Nothing above changed anything or moved any ETH.
    assert!(
        same_milestone(milestone(prod, 1, 1), approved),
        "still Approved, unchanged",
    )
    assert!(
        same_accounting(accounting(prod, 1), acc0),
        "accounting unchanged",
    )
    assert_money(prod, ether(3))
    check_invariants(prod, 1, Wei::zero())
    assert!(
        evm.balance(payee) == Wei::zero()
            && evm.balance(p) == Wei::zero()
            && evm.balance(v) == Wei::zero()
            && evm.balance(st) == Wei::zero(),
        "nobody was paid",
    )
    // Positive control: the provider's valid claim succeeds.
    assert!(
        claim_ok(p, prod, 1, 1, payee) == ether(2),
        "positive control",
    )
    assert!(evm.balance(payee) == ether(2))
    assert_money(prod, ether(1))
    check_invariants(prod, 1, Wei::zero())
}

#[test(balance = 300_000_000_000_000_000_000)]
fn a_failed_transfer_reverts_the_whole_claim_and_a_retry_to_another_payee_succeeds()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    // Contracts that cannot receive plain ETH: the Actor and Settlane have no fallback.
    let refuses = actor(14)
    let payee = Address::new(0x9b1)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(two(now + 100, now + 200), p, v), ether(3)) == 1,
    )
    approve_first(p, v, prod, 1, 1, 0xe2)
    let approved = milestone(prod, 1, 1)
    let acc = accounting(prod, 1)

    assert!(
        because(claim_out(p, prod, 1, 1, refuses), Why::TransferFailed),
        "a refusing payee",
    )
    assert!(
        because(claim_out(p, prod, 1, 1, prod), Why::TransferFailed),
        "Settlane cannot pay itself",
    )
    assert!(
        because(claim_out(p, prod, 1, 1, v), Why::TransferFailed),
        "the verifier Actor refuses too",
    )
    // Every write before the transfer was reverted with it.
    assert!(
        same_milestone(milestone(prod, 1, 1), approved),
        "still Approved, unchanged",
    )
    assert!(
        same_accounting(accounting(prod, 1), acc),
        "paid and outstanding unchanged",
    )
    assert_money(prod, ether(3))
    check_invariants(prod, 1, Wei::zero())
    assert!(
        evm.balance(refuses) == Wei::zero(),
        "the refusing payee holds nothing",
    )

    // A reverting payee blocks only its own claim: the provider retries with another `to`.
    assert!(
        claim_ok(p, prod, 1, 1, payee) == ether(2),
        "the retry succeeds",
    )
    assert!(
        evm.balance(payee) == ether(2) && state_of(prod, 1, 1) == 4,
    )
    assert_money(prod, ether(1))
    check_invariants(prod, 1, Wei::zero())
    assert!(
        because(claim_out(p, prod, 1, 1, payee), Why::NotApproved),
        "and only once",
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn a_reentrant_provider_is_paid_exactly_once() uses (evm: mut Evm) {
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let r = evm.create2<Reentrant>(value: Wei::zero(), args: (), salt: 21)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    // Extra ETH sits in the contract (agreement 1 milestone 1 and agreement 2), so a second
    // payout of milestone 0 would be possible if the contract allowed it.
    assert!(
        create(prod, parties(two(now + 100, now + 200), r, v), ether(3)) == 1,
    )
    assert!(
        create(
                prod,
                parties(three(now + 100, now + 200, now + 300), r, v),
                ether(6),
            ) == 2,
    )
    evm.call(
        addr: r,
        gas: 200000,
        value: Wei::zero(),
        message: AttackMsg::Setup { target: prod, id: 1, m: 0 },
    )
    evm.call(
        addr: r,
        gas: 2000000,
        value: Wei::zero(),
        message: AttackMsg::SubmitAs { evidence: 0xe1 },
    )
    assert!(approve_out(v, prod, 1, 0, 0xe1, 1).success())
    assert!(state_of(prod, 1, 0) == 3, "Approved")

    // The attacker claims to itself. Its fallback receives only the stipend, so it cannot even try.
    let got: Wei = evm
        .call(
            addr: r,
            gas: 2000000,
            value: Wei::zero(),
            message: AttackMsg::ClaimTo { to: r },
        )
    assert!(got == ether(1), "one payout of the stored amount")
    assert!(
        evm.balance(r) == ether(1),
        "the attacker holds exactly one payout",
    )
    let st: (u256, u256) = evm
        .call(
            addr: r,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::Stats {},
        )
    assert!(
        st.0 == 0 && st.1 == 0,
        "no nested claim was attempted under the stipend",
    )
    assert!(state_of(prod, 1, 0) == 4, "Paid")
    assert_money(prod, ether(8))
    check_invariants(prod, 2, Wei::zero())
    let acc = accounting(prod, 1)
    assert!(
        acc.1 == ether(1) && acc.3 == ether(2),
        "paid 1, outstanding 2",
    )

    // A second claim by the attacker is rejected with the state reason.
    assert!(
        because(
            evm.try_call(
                addr: r,
                gas: 2000000,
                value: Wei::zero(),
                message: AttackMsg::ClaimTo { to: r },
            ),
            Why::NotApproved,
        ),
        "the attacker's second claim",
    )
    // Positive control that the attacker is live: given real gas, its fallback does try to claim
    // again, and the nested claim fails because the milestone is already Paid.
    assert!(
        evm.send_value(addr: r, gas: 500000, value: wei(1)).success(),
        "the fallback ran",
    )
    let st2: (u256, u256) = evm
        .call(
            addr: r,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::Stats {},
        )
    assert!(
        st2.0 == 1 && st2.1 == 0,
        "one nested attempt, and it failed",
    )
    assert!(
        evm.balance(r) == ether(1) + wei(1),
        "still exactly one payout",
    )
    assert_money(prod, ether(8))
    check_invariants(prod, 2, Wei::zero())
}

#[test(balance = 300_000_000_000_000_000_000)]
fn claim_is_not_payable() uses (evm: mut Evm) {
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let payee = Address::new(0x9b1)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 1,
    )
    approve_first(p, v, prod, 1, 0, 0xe1)
    // ClaimVia is payable and forwards the ETH it receives as the call value. Settlane rejects it and keeps nothing.
    let out = evm
        .try_call(
            addr: p,
            gas: 2000000,
            value: ether(1),
            message: ActorMsg::ClaimVia { target: prod, id: 1, m: 0, to: payee },
        )
    assert!(!out.success(), "a claim with value is rejected")
    assert!(
        empty_revert(out),
        "and its revert data is empty, unlike every reasoned revert",
    )
    assert!(state_of(prod, 1, 0) == 3, "still Approved")
    assert_money(prod, ether(1))
    check_invariants(prod, 1, Wei::zero())
    assert!(evm.balance(payee) == Wei::zero(), "nothing was paid")
    // Positive control: the same claim with no value succeeds.
    assert!(
        claim_ok(p, prod, 1, 0, payee) == ether(1),
        "positive control",
    )
    assert_money(prod, Wei::zero())
    check_invariants(prod, 1, Wei::zero())
}

#[test(balance = 300_000_000_000_000_000_000)]
fn approval_never_expires_and_production_and_the_shell_agree_on_claims()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let payee = Address::new(0x9b1)
    let now = evm.timestamp().as_seconds()
    set_time(shell, now)
    let a = parties(three(now + 100, now + 200, now + 300), p, v)
    assert!(
        create(prod, a, ether(6)) == 1 && create(shell, a, ether(6)) == 1,
    )
    approve_first(p, v, prod, 1, 0, 0xe1)
    approve_first(p, v, shell, 1, 0, 0xe1)
    approve_first(p, v, prod, 1, 2, 0xe3)
    approve_first(p, v, shell, 1, 2, 0xe3)
    same_state(prod, shell, 1)

    // Same verdicts and the same reasons on both, step by step.
    assert!(because(claim_out(v, prod, 1, 0, payee), Why::NotProvider))
    assert!(
        because(claim_out(v, shell, 1, 0, payee), Why::NotProvider),
    )
    assert!(because(claim_out(p, prod, 1, 1, payee), Why::NotApproved))
    assert!(
        because(claim_out(p, shell, 1, 1, payee), Why::NotApproved),
    )
    assert!(
        because(claim_out(p, prod, 1, 0, Address::zero()), Why::ZeroPayee),
    )
    assert!(
        because(
            claim_out(p, shell, 1, 0, Address::zero()),
            Why::ZeroPayee,
        ),
    )
    assert!(because(claim_out(p, prod, 1, 0, v), Why::TransferFailed))
    assert!(because(claim_out(p, shell, 1, 0, v), Why::TransferFailed))
    assert!(claim_ok(p, prod, 1, 0, payee) == ether(1))
    assert!(claim_ok(p, shell, 1, 0, payee) == ether(1))
    same_state(prod, shell, 1)
    assert_money(prod, ether(5))
    check_invariants(prod, 1, Wei::zero())
    assert_money(shell, ether(5))
    check_invariants(shell, 1, Wei::zero())

    // Approval never expires: long after deliver_by and decide_by of every milestone, the
    // shell still pays the approved milestone 2 (Claim has no time guard).
    set_time(shell, now + 100_000_000)
    assert!(
        because(submit_out(p, shell, 1, 1, 0xe2), Why::DeliveryClosed),
        "the clock really moved",
    )
    assert!(
        claim_ok(p, shell, 1, 2, payee) == ether(3),
        "a late claim of an approved milestone",
    )
    assert!(state_of(shell, 1, 2) == 4)
    assert!(
        because(claim_out(p, shell, 1, 2, payee), Why::NotApproved),
        "once",
    )
    assert_money(shell, ether(2))
    check_invariants(shell, 1, Wei::zero())
    assert!(
        evm.balance(payee) == ether(5),
        "1 + 1 + 3 ETH in total across both contracts",
    )
}

// ------------------------------------------------------------- R-005: reentrancy without a threshold

// Two agreements funded for the same provider, so a second payout of one milestone would come out
// of another milestone's escrow. Returns the contract.
fn funded_for(_ provider: Address, _ v: Address) -> Address
uses (evm: mut Evm)
{
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(
                prod,
                parties(three(now + 100, now + 200, now + 300), provider, v),
                ether(6),
            ) == 1,
    )
    assert!(
        create(
                prod,
                parties(two(now + 100, now + 200), provider, v),
                ether(3),
            ) == 2,
    )
    prod
}

fn aim(_ attacker: Address, _ prod: Address, _ id: u256, _ m: u8)
uses (evm: mut Evm)
{
    evm.call(
        addr: attacker,
        gas: 200000,
        value: Wei::zero(),
        message: AttackMsg::Setup { target: prod, id, m },
    )
}

// The attacker submits (as the provider) and the verifier approves milestone m of agreement 1.
fn approve_attacker(_ attacker: Address, _ v: Address, _ prod: Address, _ m: u8, _ e: u256)
uses (evm: mut Evm)
{
    aim(attacker, prod, 1, m)
    evm.call(
        addr: attacker,
        gas: 2000000,
        value: Wei::zero(),
        message: AttackMsg::SubmitAs { evidence: e },
    )
    assert!(
        approve_out(v, prod, 1, m, e, 1).success(),
        "setup: approve",
    )
}

fn attacker_claims(_ attacker: Address, _ to: Address) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: attacker,
        gas: 5000000,
        value: Wei::zero(),
        message: AttackMsg::ClaimTo { to },
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn a_provider_that_always_re_enters_is_never_paid_under_the_stipend_and_never_twice()
uses (evm: mut Evm)
{
    probe()
    let v = actor(12)
    let g = evm.create2<Greedy>(value: Wei::zero(), args: (), salt: 24)
    let prod = funded_for(g, v)
    approve_attacker(g, v, prod, 0, 0xe1)
    approve_attacker(g, v, prod, 1, 0xe2)
    let loot = Address::new(LOOT)
    let honest = Address::new(0x9b1)
    check_invariants(prod, 2, Wei::zero())

    // Positive control: the attacker IS live. Given real gas its fallback re-enters and claims
    // milestone 0, the ETH goes to the third address, and nothing in the attacker stops it.
    aim(g, prod, 1, 0)
    assert!(
        evm.send_value(addr: g, gas: 500000, value: wei(1)).success(),
        "control: the fallback ran with real gas",
    )
    assert!(
        evm.balance(loot) == ether(1),
        "control: the re-entrant claim paid the third address",
    )
    assert!(state_of(prod, 1, 0) == 4, "control: milestone 0 is Paid")
    assert!(
        evm.balance(g) == wei(1),
        "control: the attacker kept only the wei it was sent",
    )
    check_invariants(prod, 2, Wei::zero())

    // The attack: claim milestone 1 to the attacker itself. The send carries only the stipend, the
    // fallback cannot finish, the send fails and the whole claim reverts (nothing was paid).
    aim(g, prod, 1, 1)
    let before = milestone(prod, 1, 1)
    let acc = accounting(prod, 1)
    assert!(
        because(attacker_claims(g, g), Why::TransferFailed),
        "an always-re-entering payee cannot be paid with the stipend",
    )
    assert!(
        same_milestone(milestone(prod, 1, 1), before),
        "still Approved, unchanged",
    )
    assert!(
        same_accounting(accounting(prod, 1), acc),
        "paid and outstanding unchanged",
    )
    assert!(
        evm.balance(loot) == ether(1),
        "the third address got nothing more",
    )
    assert!(evm.balance(g) == wei(1), "the attacker got nothing")
    check_invariants(prod, 2, Wei::zero())

    // The provider is not locked out: the same milestone pays once to an ordinary address.
    let got: Wei = evm
        .call(
            addr: g,
            gas: 5000000,
            value: Wei::zero(),
            message: AttackMsg::ClaimTo { to: honest },
        )
    assert!(
        got == ether(2) && evm.balance(honest) == ether(2),
        "paid once to an address that can receive it",
    )
    assert!(state_of(prod, 1, 1) == 4)
    assert!(
        because(attacker_claims(g, honest), Why::NotApproved),
        "and only once",
    )
    assert!(
        because(attacker_claims(g, g), Why::NotApproved),
        "not to itself either",
    )
    check_invariants(prod, 2, Wei::zero())
    assert!(
        evm.balance(prod) == ether(9) - ether(1) - ether(2),
        "exactly 1 + 2 ETH left the contract",
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn a_provider_that_re_enters_once_with_whatever_gas_it_gets_cannot_be_paid()
uses (evm: mut Evm)
{
    probe()
    let v = actor(12)
    let o = evm.create2<Once>(value: Wei::zero(), args: (), salt: 25)
    let prod = funded_for(o, v)
    approve_attacker(o, v, prod, 0, 0xe1)
    approve_attacker(o, v, prod, 1, 0xe2)
    check_invariants(prod, 2, Wei::zero())

    // Positive control: with real gas the fallback records its re-entry (`entered` becomes 2). It
    // needs more than the stipend to do that, which is exactly what the claim must never give it.
    aim(o, prod, 1, 0)
    assert!(
        evm.send_value(addr: o, gas: 500000, value: wei(1)).success(),
        "control: the fallback ran",
    )
    let seen: (u256, u256) = evm
        .call(
            addr: o,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::Stats {},
        )
    assert!(
        seen.0 == 2,
        "control: the attacker re-entered once with real gas",
    )
    check_invariants(prod, 2, Wei::zero())

    // The attack on milestone 1: with the stipend the fallback cannot even record its re-entry.
    aim(o, prod, 1, 1)
    let held = evm.balance(o)
    let before = milestone(prod, 1, 1)
    let acc = accounting(prod, 1)
    let owed = outstanding(prod)
    assert!(
        because(attacker_claims(o, o), Why::TransferFailed),
        "the claim reverts",
    )
    let after: (u256, u256) = evm
        .call(
            addr: o,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::Stats {},
        )
    assert!(
        after.0 == 1,
        "the fallback never got far enough to record a re-entry",
    )
    assert!(evm.balance(o) == held, "the attacker was paid nothing")
    assert!(
        same_milestone(milestone(prod, 1, 1), before),
        "still Approved, unchanged",
    )
    assert!(
        same_accounting(accounting(prod, 1), acc),
        "accounting unchanged",
    )
    assert!(outstanding(prod) == owed, "total outstanding unchanged")
    check_invariants(prod, 2, Wei::zero())
    assert!(
        evm.balance(prod) >= acc.3 + accounting(prod, 2).3,
        "the contract still holds everything it owes (I9)",
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn a_payee_is_given_no_more_than_the_2300_gas_stipend() uses (evm: mut Evm) {
    probe()
    let p = actor(11)
    let v = actor(12)
    let prod = funded_for(p, v)
    approve_first(p, v, prod, 1, 0, 0xe1)
    let cap = evm.create2<GasCap>(value: Wei::zero(), args: (), salt: 31)
    // Positive control: GasCap really rejects a send with more gas.
    assert!(
        !evm.send_value(addr: cap, gas: 10000, value: wei(1)).success(),
        "control: the payee rejects 10000 gas",
    )
    assert!(
        claim_ok(p, prod, 1, 0, cap) == ether(1),
        "the fallback saw at most the stipend",
    )
    assert!(evm.balance(cap) == ether(1))
    check_invariants(prod, 2, Wei::zero())
}

#[test(balance = 300_000_000_000_000_000_000)]
fn precompile_payees_are_the_providers_own_choice_and_some_strand_the_eth()
uses (evm: mut Evm)
{
    probe()
    let p = actor(11)
    let v = actor(12)
    let prod = funded_for(p, v)
    approve_first(p, v, prod, 1, 0, 0xe1)
    approve_first(p, v, prod, 1, 1, 0xe2)
    // ecrecover (0x01) costs 3000 gas, above the stipend: the send fails and the claim reverts.
    assert!(
        because(
            claim_out(p, prod, 1, 0, Address::new(1)),
            Why::TransferFailed,
        ),
        "0x01 fails",
    )
    assert!(state_of(prod, 1, 0) == 3, "and nothing changed")
    // identity (0x04) and sha256 (0x02) are cheap: the claim succeeds and the ETH is stranded at
    // the precompile. This is the provider's own `to`; it is documented, not prevented.
    assert!(
        claim_ok(p, prod, 1, 0, Address::new(4)) == ether(1),
        "0x04 accepts",
    )
    assert!(
        evm.balance(Address::new(4)) == ether(1),
        "the ETH sits at the identity precompile",
    )
    assert!(
        claim_ok(p, prod, 1, 1, Address::new(2)) == ether(2),
        "0x02 accepts",
    )
    check_invariants(prod, 2, Wei::zero())
}

// ------------------------------------------------------------------------- Phase 3B: Refund
// T6: from Funded or Submitted, once expired, Refund(to) by the client, to != 0, goes to Refunded,
// refunded += amount, outstanding -= amount, and sends exactly the stored amount to `to` with the
// 2300-gas stipend. Every write happens before the transfer, and a failed transfer reverts all of
// them. Expiry needs a clock that moves, so the positive path runs on the shell (same handler).

// The test contract is the client of every agreement it creates directly.
fn refund_direct(_ s: Address, _ id: u256, _ m: u8, _ to: Address) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Refund { id, m, to },
    )
}

// A refund by the client that must succeed. Returns what Settlane reports it sent.
fn refund_ok(_ s: Address, _ id: u256, _ m: u8, _ to: Address) -> Wei
uses (evm: mut Evm)
{
    evm.call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Refund { id, m, to },
    )
}

// `by` forwards Refund to `s`, so Settlane sees `by` as the caller.
fn refund_out(_ by: Address, _ s: Address, _ id: u256, _ m: u8, _ to: Address) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: by,
        gas: 2000000,
        value: Wei::zero(),
        message: ActorMsg::RefundVia { target: s, id, m, to },
    )
}

fn refund_via_ok(_ by: Address, _ s: Address, _ id: u256, _ m: u8, _ to: Address) -> Wei
uses (evm: mut Evm)
{
    evm.call(
        addr: by,
        gas: 2000000,
        value: Wei::zero(),
        message: ActorMsg::RefundVia { target: s, id, m, to },
    )
}

// An agreement created through the Actor `by`, which becomes its client.
fn create_via(_ by: Address, _ s: Address, _ a: Args, _ value: Wei) -> u256
uses (evm: mut Evm)
{
    evm.call(
        addr: by,
        gas: 2000000,
        value,
        message: ActorMsg::CreateVia {
            target: s,
            provider: a.provider,
            verifier: a.verifier,
            review_period: a.review_period,
            n: a.n,
            amounts: a.amounts,
            deliver_by: a.deliver_by,
            specs: a.specs,
        },
    )
}

fn acc_is(
    _ a: (Wei, Wei, Wei, Wei),
    _ deposited: Wei,
    _ paid: Wei,
    _ refunded: Wei,
    _ owed: Wei,
) -> bool {
    a.0 == deposited && a.1 == paid && a.2 == refunded && a.3 == owed
}

#[test(balance = 300_000_000_000_000_000_000)]
fn the_client_refunds_expired_milestones_once_and_claim_and_refund_exclude_each_other()
uses (evm: mut Evm)
{
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    let payee = Address::new(0x9b1)
    let payee2 = Address::new(0x9b2)
    // Agreement 1: 1 + 2 + 3 ETH due at 2000, 3000, 4000 (review 3600 s). Agreement 2 (1 + 2 ETH)
    // is another agreement's escrow and must not move at all.
    assert!(
        create(shell, parties(three(2000, 3000, 4000), p, v), ether(6)) == 1,
    )
    assert!(
        create(shell, parties(two(2000, 3000), p, v), ether(3)) == 2,
    )
    check_invariants(shell, 2, Wei::zero())
    // Milestone 1 is submitted, milestone 2 approved, milestone 0 left Funded.
    set_time(shell, 1500)
    assert!(
        submit_out(p, shell, 1, 1, 0xe2).success(),
        "setup: submit m1",
    )
    approve_first(p, v, shell, 1, 2, 0xe3)
    check_invariants(shell, 2, Wei::zero())

    // Funded milestone 0 at its deliver_by: expired, refunded the stored amount to the client's `to`.
    set_time(shell, 2000)
    let m0 = milestone(shell, 1, 0)
    assert!(
        refund_ok(shell, 1, 0, payee) == ether(1),
        "the refund returns the stored amount",
    )
    assert!(evm.balance(payee) == ether(1), "and sends exactly it")
    assert!(state_of(shell, 1, 0) == 5, "Refunded")
    assert!(
        fixed_fields(milestone(shell, 1, 0), m0),
        "amount, deadlines and spec kept",
    )
    assert!(
        acc_is(
            accounting(shell, 1),
            ether(6),
            Wei::zero(),
            ether(1),
            ether(5),
        ),
        "refunded += 1, outstanding -= 1",
    )
    assert!(outstanding(shell) == ether(8), "total outstanding -= 1")
    check_invariants(shell, 2, Wei::zero())

    // Refunded is final: no second refund, no claim, no evidence, no review.
    let refunded = milestone(shell, 1, 0)
    assert!(
        because(refund_direct(shell, 1, 0, payee), Why::NotRefundable),
        "a second refund",
    )
    assert!(
        because(refund_direct(shell, 1, 0, payee2), Why::NotRefundable),
        "not to another payee either",
    )
    assert!(
        because(claim_out(p, shell, 1, 0, payee), Why::NotApproved),
        "no claim after a refund",
    )
    assert!(
        because(submit_out(p, shell, 1, 0, 0xe9), Why::WrongState),
        "no evidence after a refund",
    )
    assert!(
        because(approve_out(v, shell, 1, 0, 0xe9, 1), Why::NotSubmitted),
        "no review after a refund",
    )
    assert!(
        same_milestone(milestone(shell, 1, 0), refunded),
        "unchanged",
    )
    check_invariants(shell, 2, Wei::zero())

    // Submitted milestone 1 is not expired at its deliver_by: the review window is still open.
    set_time(shell, 3000)
    assert!(
        because(refund_direct(shell, 1, 1, payee), Why::NotExpired),
        "Submitted, at deliver_by",
    )
    set_time(shell, 6599)
    assert!(
        because(refund_direct(shell, 1, 1, payee), Why::NotExpired),
        "Submitted, at decide_by - 1",
    )
    set_time(shell, 6600)
    assert!(
        refund_ok(shell, 1, 1, payee2) == ether(2),
        "Submitted, at decide_by",
    )
    assert!(evm.balance(payee2) == ether(2))
    assert!(
        acc_is(
            accounting(shell, 1),
            ether(6),
            Wei::zero(),
            ether(3),
            ether(3),
        ),
    )
    check_invariants(shell, 2, Wei::zero())

    // Approved milestone 2 never expires: no refund long after both deadlines. It is claimed,
    // and a refund after the claim fails too.
    set_time(shell, 100000)
    assert!(
        because(refund_direct(shell, 1, 2, payee), Why::NotRefundable),
        "Approved is never refundable",
    )
    assert!(state_of(shell, 1, 2) == 3, "still Approved")
    assert!(claim_ok(p, shell, 1, 2, payee) == ether(3), "claimed")
    assert!(
        because(refund_direct(shell, 1, 2, payee), Why::NotRefundable),
        "no refund after a claim",
    )
    assert!(state_of(shell, 1, 2) == 4, "still Paid")
    assert!(
        acc_is(
            accounting(shell, 1),
            ether(6),
            ether(3),
            ether(3),
            Wei::zero(),
        ),
        "deposited == paid + refunded, nothing owed",
    )
    check_invariants(shell, 2, Wei::zero())

    // Agreement 2 never moved: the contract holds exactly its escrow.
    assert!(
        acc_is(
            accounting(shell, 2),
            ether(3),
            Wei::zero(),
            Wei::zero(),
            ether(3),
        ),
        "agreement 2 untouched",
    )
    assert!(state_of(shell, 2, 0) == 1 && state_of(shell, 2, 1) == 1)
    assert!(evm.balance(payee) == ether(4), "1 refunded + 3 claimed")
    assert_money(shell, ether(3))
}

#[test(balance = 300_000_000_000_000_000_000)]
fn only_the_client_may_refund_and_only_an_expired_unpaid_milestone_to_a_nonzero_payee()
uses (evm: mut Evm)
{
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    let st = actor(13)
    let payee = Address::new(0x9b1)
    // Agreement 1: two milestones (slot 2 unused). Agreement 2: due far in the future.
    assert!(
        create(shell, parties(two(2000, 3000), p, v), ether(3)) == 1,
    )
    assert!(create(shell, parties(single(50000), p, v), ether(1)) == 2)
    set_time(shell, 1500)
    approve_first(p, v, shell, 1, 1, 0xe2)
    // Every deadline of agreement 1 has passed; agreement 2 is still open.
    set_time(shell, 10000)
    let m0 = milestone(shell, 1, 0)
    let m1 = milestone(shell, 1, 1)
    check_invariants(shell, 2, Wei::zero())

    // Roles: only the client. The provider, the verifier and a stranger are refused first.
    assert!(
        because(refund_out(p, shell, 1, 0, payee), Why::NotClient),
        "the provider",
    )
    assert!(
        because(refund_out(v, shell, 1, 0, payee), Why::NotClient),
        "the verifier",
    )
    assert!(
        because(refund_out(st, shell, 1, 0, payee), Why::NotClient),
        "a stranger",
    )
    assert!(
        because(refund_out(p, shell, 1, 0, p), Why::NotClient),
        "the provider, to itself",
    )
    assert!(
        because(
            refund_out(st, shell, 1, 2, Address::zero()),
            Why::NotClient,
        ),
        "role before milestone and payee",
    )
    // Unknown agreements, whoever calls.
    assert!(
        because(refund_direct(shell, 0, 0, payee), Why::UnknownAgreement),
        "id 0",
    )
    assert!(
        because(refund_direct(shell, 3, 0, payee), Why::UnknownAgreement),
        "id 3",
    )
    assert!(
        because(
            refund_direct(shell, MAX, 0, payee),
            Why::UnknownAgreement,
        ),
        "id 2^256 - 1",
    )
    assert!(
        because(refund_out(st, shell, 3, 0, payee), Why::UnknownAgreement),
        "unknown before role",
    )
    // Unused slots of a known agreement.
    assert!(
        because(refund_direct(shell, 1, 2, payee), Why::NoSuchMilestone),
        "slot 2 unused",
    )
    assert!(
        because(refund_direct(shell, 1, 3, payee), Why::NoSuchMilestone),
        "slot 3",
    )
    // States: Approved is never refundable, and the state is checked before the payee.
    assert!(
        because(refund_direct(shell, 1, 1, payee), Why::NotRefundable),
        "Approved",
    )
    assert!(
        because(
            refund_direct(shell, 1, 1, Address::zero()),
            Why::NotRefundable,
        ),
        "state before payee",
    )
    // Window: a Funded milestone before its deadline, checked before the payee.
    assert!(
        because(refund_direct(shell, 2, 0, payee), Why::NotExpired),
        "not expired",
    )
    assert!(
        because(
            refund_direct(shell, 2, 0, Address::zero()),
            Why::NotExpired,
        ),
        "window before payee",
    )
    // Payee: never the zero address.
    assert!(
        because(
            refund_direct(shell, 1, 0, Address::zero()),
            Why::ZeroPayee,
        ),
        "payee zero",
    )
    // Nothing above changed anything.
    assert!(same_milestone(milestone(shell, 1, 0), m0))
    assert!(same_milestone(milestone(shell, 1, 1), m1))
    assert!(evm.balance(payee) == Wei::zero(), "nothing was refunded")
    assert_money(shell, ether(4))
    check_invariants(shell, 2, Wei::zero())
    // Positive control: the client, an expired Funded milestone, a nonzero payee.
    assert!(
        refund_ok(shell, 1, 0, payee) == ether(1),
        "positive control",
    )
    assert_money(shell, ether(3))
    check_invariants(shell, 2, Wei::zero())
}

#[test(balance = 300_000_000_000_000_000_000)]
fn refund_boundaries_hold_at_d_minus_1_d_and_d_plus_1_in_every_slot_and_state()
uses (evm: mut Evm)
{
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    // Agreements 1 and 2 stay Funded; 3 and 4 are submitted in every slot at 1500. Deadlines differ
    // per slot (2000, 3000, 4000), so a handler that read another slot's deadline would fail here.
    var i: u256 = 0
    while i < 4 {
        assert!(
            create(shell, parties(three(2000, 3000, 4000), p, v), ether(6)) == i + 1,
        )
        i += 1
    }
    // Agreement 5: rejected after its delivery deadline (F3), refundable at once.
    assert!(create(shell, parties(single(2000), p, v), ether(1)) == 5)
    set_time(shell, 1500)
    var k: u8 = 0
    while k < 3 {
        assert!(submit_out(p, shell, 3, k, 0xd0 + (k as u256)).success())
        assert!(submit_out(p, shell, 4, k, 0xd0 + (k as u256)).success())
        k += 1
    }
    assert!(submit_out(p, shell, 5, 0, 0xe5).success())
    check_invariants(shell, 5, Wei::zero())

    // Funded: expires exactly at deliver_by, slot by slot.
    k = 0
    while k < 3 {
        let d: u256 = 2000 + 1000 * (k as u256)
        let amount = ether((k as u256) + 1)
        set_time(shell, d - 1)
        assert!(
            because(
                refund_direct(shell, 1, k, Address::new(0x9b1)),
                Why::NotExpired,
            ),
            "Funded at d - 1",
        )
        assert!(
            because(
                refund_direct(shell, 2, k, Address::new(0x9b1)),
                Why::NotExpired,
            ),
            "Funded at d - 1 (agreement 2)",
        )
        set_time(shell, d)
        assert!(
            refund_ok(shell, 1, k, Address::new(0x9b1)) == amount,
            "Funded at d",
        )
        set_time(shell, d + 1)
        assert!(
            refund_ok(shell, 2, k, Address::new(0x9b2)) == amount,
            "Funded at d + 1",
        )
        assert!(state_of(shell, 1, k) == 5 && state_of(shell, 2, k) == 5)
        check_invariants(shell, 5, Wei::zero())
        k += 1
    }
    assert!(evm.balance(Address::new(0x9b1)) == ether(6))
    assert!(evm.balance(Address::new(0x9b2)) == ether(6))

    // Submitted: not expired at deliver_by, expires exactly at decide_by. Review and refund are
    // disjoint: at decide_by - 1 the verifier can still act and the client cannot.
    k = 0
    while k < 3 {
        let d: u256 = 2000 + 1000 * (k as u256)
        let e: u256 = d + 3600
        let amount = ether((k as u256) + 1)
        set_time(shell, d)
        assert!(
            because(
                refund_direct(shell, 3, k, Address::new(0x9b3)),
                Why::NotExpired,
            ),
            "Submitted at deliver_by",
        )
        set_time(shell, e - 1)
        assert!(
            because(
                refund_direct(shell, 3, k, Address::new(0x9b3)),
                Why::NotExpired,
            ),
            "Submitted at decide_by - 1",
        )
        set_time(shell, e)
        assert!(
            because(
                approve_out(v, shell, 4, k, 0xd0 + (k as u256), 1),
                Why::ReviewClosed,
            ),
            "the verifier is out at decide_by",
        )
        assert!(
            refund_ok(shell, 3, k, Address::new(0x9b3)) == amount,
            "Submitted at decide_by",
        )
        set_time(shell, e + 1)
        assert!(
            refund_ok(shell, 4, k, Address::new(0x9b4)) == amount,
            "Submitted at decide_by + 1",
        )
        assert!(state_of(shell, 3, k) == 5 && state_of(shell, 4, k) == 5)
        check_invariants(shell, 5, Wei::zero())
        k += 1
    }

    // F3: a rejection after deliver_by leaves a Funded milestone whose delivery has closed, so it
    // is refundable at once, inside what was the review window.
    set_time(shell, 2500)
    assert!(
        reject_out(v, shell, 5, 0, 0xe5, 1).success(),
        "rejected after d",
    )
    assert!(state_of(shell, 5, 0) == 1, "Funded again")
    assert!(
        because(submit_out(p, shell, 5, 0, 0xe6), Why::DeliveryClosed),
        "the provider cannot resubmit",
    )
    assert!(
        refund_ok(shell, 5, 0, Address::new(0x9b5)) == ether(1),
        "and the client is refunded at once",
    )
    check_invariants(shell, 5, Wei::zero())
    assert_money(shell, Wei::zero())
}

#[test(balance = 300_000_000_000_000_000_000)]
fn a_failed_refund_transfer_reverts_the_whole_refund_and_a_retry_to_another_payee_succeeds()
uses (evm: mut Evm)
{
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    let refuses = actor(14)
    let payee = Address::new(0x9b1)
    assert!(
        create(shell, parties(two(2000, 3000), p, v), ether(3)) == 1,
    )
    set_time(shell, 3000)
    let before = milestone(shell, 1, 1)
    let acc = accounting(shell, 1)
    assert!(
        because(refund_direct(shell, 1, 1, refuses), Why::TransferFailed),
        "a refusing payee",
    )
    assert!(
        because(refund_direct(shell, 1, 1, shell), Why::TransferFailed),
        "Settlane cannot refund to itself",
    )
    assert!(
        because(refund_direct(shell, 1, 1, v), Why::TransferFailed),
        "the verifier Actor refuses too",
    )
    // Every write before the transfer was reverted with it.
    assert!(
        same_milestone(milestone(shell, 1, 1), before),
        "still Funded, unchanged",
    )
    assert!(
        same_accounting(accounting(shell, 1), acc),
        "refunded and outstanding unchanged",
    )
    assert_money(shell, ether(3))
    check_invariants(shell, 1, Wei::zero())
    assert!(evm.balance(refuses) == Wei::zero())

    // A refusing payee blocks only its own refund: the client retries with another `to`.
    assert!(
        refund_ok(shell, 1, 1, payee) == ether(2),
        "the retry succeeds",
    )
    assert!(
        evm.balance(payee) == ether(2) && state_of(shell, 1, 1) == 5,
    )
    assert_money(shell, ether(1))
    check_invariants(shell, 1, Wei::zero())
    assert!(
        because(refund_direct(shell, 1, 1, payee), Why::NotRefundable),
        "and only once",
    )

    // The payee gets the stipend and no more: a payee that rejects more than 2300 gas is paid.
    let cap = evm.create2<GasCap>(value: Wei::zero(), args: (), salt: 31)
    assert!(
        !evm.send_value(addr: cap, gas: 10000, value: wei(1)).success(),
        "control: the payee rejects 10000 gas",
    )
    assert!(
        refund_ok(shell, 1, 0, cap) == ether(1),
        "the fallback saw at most the stipend",
    )
    assert!(evm.balance(cap) == ether(1))
    assert_money(shell, Wei::zero())
    check_invariants(shell, 1, Wei::zero())
}

// The attacker as the client: it creates and funds agreement 1 as itself.
fn create_as(_ attacker: Address, _ s: Address, _ a: Args, _ value: Wei) -> u256
uses (evm: mut Evm)
{
    evm.call(
        addr: attacker,
        gas: 2000000,
        value,
        message: AttackMsg::CreateAs {
            target: s,
            provider: a.provider,
            verifier: a.verifier,
            review_period: a.review_period,
            n: a.n,
            amounts: a.amounts,
            deliver_by: a.deliver_by,
            specs: a.specs,
        },
    )
}

fn aim_refund(_ attacker: Address, _ s: Address, _ id: u256, _ m: u8)
uses (evm: mut Evm)
{
    evm.call(
        addr: attacker,
        gas: 200000,
        value: Wei::zero(),
        message: AttackMsg::AimRefund { target: s, id, m },
    )
}

fn attacker_refunds(_ attacker: Address, _ to: Address) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: attacker,
        gas: 5000000,
        value: Wei::zero(),
        message: AttackMsg::RefundTo { to },
    )
}

// Agreement 1 (1 + 2 + 3 ETH) belongs to the attacker as client; agreement 2 (1 + 2 ETH) belongs
// to the test contract, so a double refund would be paid out of someone else's escrow. At 5000
// every milestone of both is expired and Funded.
fn attacker_shell(_ attacker: Address, _ p: Address, _ v: Address) -> Address
uses (evm: mut Evm)
{
    let shell = shell_at_1000()
    assert!(
        create_as(
                attacker,
                shell,
                parties(three(2000, 3000, 4000), p, v),
                ether(6),
            ) == 1,
    )
    assert!(
        create(shell, parties(two(2000, 3000), p, v), ether(3)) == 2,
    )
    set_time(shell, 5000)
    shell
}

#[test(balance = 300_000_000_000_000_000_000)]
fn a_client_that_always_re_enters_is_never_refunded_under_the_stipend_and_never_twice()
uses (evm: mut Evm)
{
    probe()
    let p = actor(11)
    let v = actor(12)
    let g = evm.create2<Greedy>(value: Wei::zero(), args: (), salt: 24)
    let shell = attacker_shell(g, p, v)
    let loot = Address::new(LOOT)
    let honest = Address::new(0x9b1)
    check_invariants(shell, 2, Wei::zero())

    // Positive control: the attacker IS live. Given real gas, its fallback re-enters and refunds
    // milestone 0 to the third address, and nothing in the attacker stops it.
    aim_refund(g, shell, 1, 0)
    assert!(
        evm.send_value(addr: g, gas: 500000, value: wei(1)).success(),
        "control: the fallback ran with real gas",
    )
    assert!(
        evm.balance(loot) == ether(1),
        "control: the re-entrant refund paid the third address",
    )
    assert!(
        state_of(shell, 1, 0) == 5,
        "control: milestone 0 is Refunded",
    )
    assert!(
        evm.balance(g) == wei(1),
        "control: the attacker kept only its wei",
    )
    check_invariants(shell, 2, Wei::zero())

    // The attack: refund milestone 1 to the attacker itself. The send carries only the stipend,
    // the fallback cannot finish, the send fails and the whole refund reverts.
    aim_refund(g, shell, 1, 1)
    let before = milestone(shell, 1, 1)
    let acc = accounting(shell, 1)
    let owed = outstanding(shell)
    assert!(
        because(attacker_refunds(g, g), Why::TransferFailed),
        "an always-re-entering client cannot be refunded with the stipend",
    )
    assert!(
        same_milestone(milestone(shell, 1, 1), before),
        "still Funded, unchanged",
    )
    assert!(
        same_accounting(accounting(shell, 1), acc),
        "refunded and outstanding unchanged",
    )
    assert!(outstanding(shell) == owed, "total outstanding unchanged")
    assert!(
        evm.balance(loot) == ether(1),
        "the third address got nothing more",
    )
    assert!(evm.balance(g) == wei(1), "the attacker got nothing")
    check_invariants(shell, 2, Wei::zero())

    // The client is not locked out: the same milestone refunds once to an ordinary address.
    let got: Wei = evm
        .call(
            addr: g,
            gas: 5000000,
            value: Wei::zero(),
            message: AttackMsg::RefundTo { to: honest },
        )
    assert!(
        got == ether(2) && evm.balance(honest) == ether(2),
        "refunded once to an address that can receive it",
    )
    assert!(state_of(shell, 1, 1) == 5)
    assert!(
        because(attacker_refunds(g, honest), Why::NotRefundable),
        "and only once",
    )
    assert!(
        because(attacker_refunds(g, g), Why::NotRefundable),
        "not to itself either",
    )
    check_invariants(shell, 2, Wei::zero())
    assert!(
        acc_is(
            accounting(shell, 2),
            ether(3),
            Wei::zero(),
            Wei::zero(),
            ether(3),
        ),
        "agreement 2 untouched",
    )
    assert!(
        evm.balance(shell) == ether(9) - ether(1) - ether(2),
        "exactly 1 + 2 ETH left the contract",
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn a_client_that_re_enters_once_with_whatever_gas_it_gets_cannot_be_refunded()
uses (evm: mut Evm)
{
    probe()
    let p = actor(11)
    let v = actor(12)
    let o = evm.create2<Once>(value: Wei::zero(), args: (), salt: 25)
    let shell = attacker_shell(o, p, v)
    check_invariants(shell, 2, Wei::zero())

    // Positive control: with real gas the fallback records its re-entry (`entered` becomes 2) and
    // its nested refund of milestone 0 to itself goes through.
    aim_refund(o, shell, 1, 0)
    assert!(
        evm.send_value(addr: o, gas: 500000, value: wei(1)).success(),
        "control: the fallback ran",
    )
    let seen: (u256, u256) = evm
        .call(
            addr: o,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::Stats {},
        )
    assert!(
        seen.0 == 2,
        "control: the attacker re-entered once with real gas",
    )
    assert!(
        state_of(shell, 1, 0) == 5,
        "control: milestone 0 refunded once",
    )
    check_invariants(shell, 2, Wei::zero())

    // The attack on milestone 1: with the stipend the fallback cannot even record its re-entry.
    aim_refund(o, shell, 1, 1)
    let held = evm.balance(o)
    let before = milestone(shell, 1, 1)
    let acc = accounting(shell, 1)
    let owed = outstanding(shell)
    assert!(
        because(attacker_refunds(o, o), Why::TransferFailed),
        "the refund reverts",
    )
    let after: (u256, u256) = evm
        .call(
            addr: o,
            gas: 100000,
            value: Wei::zero(),
            message: AttackMsg::Stats {},
        )
    assert!(
        after.0 == 1,
        "the fallback never got far enough to record a re-entry",
    )
    assert!(evm.balance(o) == held, "the attacker was paid nothing")
    assert!(
        same_milestone(milestone(shell, 1, 1), before),
        "still Funded, unchanged",
    )
    assert!(
        same_accounting(accounting(shell, 1), acc),
        "accounting unchanged",
    )
    assert!(outstanding(shell) == owed, "total outstanding unchanged")
    check_invariants(shell, 2, Wei::zero())
    assert!(
        evm.balance(shell) >= acc.3 + accounting(shell, 2).3,
        "the contract still holds everything it owes (I9)",
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn refund_is_not_payable_on_production_or_the_shell() uses (evm: mut Evm) {
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    let c = actor(15)
    let payee = Address::new(0x9b1)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 1,
    )
    assert!(
        create_via(c, shell, parties(single(2000), p, v), ether(1)) == 1,
    )
    set_time(shell, 2000)
    // RefundVia is payable and forwards what it receives. Settlane rejects attached value before
    // anything else, with EMPTY revert data, even for the real client of an expired milestone.
    let out = evm
        .try_call(
            addr: c,
            gas: 2000000,
            value: ether(1),
            message: ActorMsg::RefundVia { target: shell, id: 1, m: 0, to: payee },
        )
    assert!(
        empty_revert(out),
        "shell: a refund with value is rejected, empty data",
    )
    let direct = evm
        .try_call(
            addr: prod,
            gas: 500000,
            value: wei(1),
            message: SettleMsg::Refund { id: 1, m: 0, to: payee },
        )
    assert!(
        empty_revert(direct),
        "production: rejected before the expiry check",
    )
    assert!(state_of(shell, 1, 0) == 1 && state_of(prod, 1, 0) == 1)
    assert_money(shell, ether(1))
    assert_money(prod, ether(1))
    check_invariants(shell, 1, Wei::zero())
    check_invariants(prod, 1, Wei::zero())
    // Positive controls: without value, production reports a reason and the shell refunds.
    assert!(
        because(refund_direct(prod, 1, 0, payee), Why::NotExpired),
        "production: a reasoned revert",
    )
    assert!(
        refund_via_ok(c, shell, 1, 0, payee) == ether(1),
        "shell: the same refund with no value succeeds",
    )
    assert_money(shell, Wei::zero())
    check_invariants(shell, 1, Wei::zero())
}

#[test(balance = 400_000_000_000_000_000_000)]
fn refunds_belong_to_each_agreements_client_and_accounting_holds_across_claims_and_refunds()
uses (evm: mut Evm)
{
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    let c = actor(15)
    let payee = Address::new(0x9b1)
    let payee2 = Address::new(0x9b2)
    // Agreement 1: client = test contract. Agreement 2: client = Actor c. Same provider and verifier.
    assert!(
        create(shell, parties(three(2000, 3000, 4000), p, v), ether(6)) == 1,
    )
    assert!(
        create_via(c, shell, parties(three(2000, 3000, 4000), p, v), ether(6)) == 2,
    )
    set_time(shell, 1500)
    approve_first(p, v, shell, 1, 0, 0xa0)
    approve_first(p, v, shell, 2, 2, 0xb2)
    check_invariants(shell, 2, Wei::zero())
    set_time(shell, 10000)

    // Each client refunds only its own agreement.
    assert!(
        because(refund_direct(shell, 2, 0, payee), Why::NotClient),
        "the client of 1 is not the client of 2",
    )
    assert!(
        because(refund_out(c, shell, 1, 1, payee), Why::NotClient),
        "the client of 2 is not the client of 1",
    )
    check_invariants(shell, 2, Wei::zero())

    // Interleave claims and refunds across both agreements, checking every step.
    assert!(refund_ok(shell, 1, 1, payee) == ether(2))
    check_invariants(shell, 2, Wei::zero())
    assert!(refund_via_ok(c, shell, 2, 0, payee2) == ether(1))
    check_invariants(shell, 2, Wei::zero())
    assert!(claim_ok(p, shell, 2, 2, payee) == ether(3))
    check_invariants(shell, 2, Wei::zero())
    assert!(claim_ok(p, shell, 1, 0, payee2) == ether(1))
    check_invariants(shell, 2, Wei::zero())
    assert!(refund_via_ok(c, shell, 2, 1, payee2) == ether(2))
    check_invariants(shell, 2, Wei::zero())
    assert!(
        acc_is(
            accounting(shell, 1),
            ether(6),
            ether(1),
            ether(2),
            ether(3),
        ),
        "agreement 1: 1 paid, 2 refunded, 3 owed",
    )
    assert!(
        acc_is(
            accounting(shell, 2),
            ether(6),
            ether(3),
            ether(3),
            Wei::zero(),
        ),
        "agreement 2: settled",
    )
    assert!(
        outstanding(shell) == ether(3),
        "only agreement 1's slot 2 is owed",
    )
    assert!(
        evm.balance(payee) == ether(5) && evm.balance(payee2) == ether(4),
    )
    assert_money(shell, ether(3))
    // The last milestone: refunded by its client, and then nothing is owed anywhere.
    assert!(refund_ok(shell, 1, 2, payee) == ether(3))
    check_invariants(shell, 2, Wei::zero())
    assert_money(shell, Wei::zero())
}
