use std::evm::returndata::decode_error_string
// Dev-ingot tests for Phase 2A. These need what the production ingot's tests cannot have:
// a clock that moves (the test-clock shell) and a caller other than the test contract (the
// Actor). The shell runs the production handlers (D-016), so what is tested here is the
// shipped creation logic under other clocks and other callers.
use ingot::{Actor, ActorMsg, DevMsg, SettlaneTestClock}
use std::evm::CallOutcome
use settlane::settlane::{SettleMsg, Settlane}
use std::evm::{ether, seconds, wei}

const MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

struct Args {
    provider: Address,
    verifier: Address,
    review_period: Duration,
    n: u8,
    amounts: [Wei; 3],
    deliver_by: [Timestamp; 3],
    specs: [u256; 3],
}

impl Copy for Args {}

// Emitted by the TEST CONTRACT with its own address (R-003). scripts/check_events.py compares
// the `client` topic of every direct-call AgreementCreated with it, so the client of a direct
// call is checked against a value that does not come from Settlane.
#[event]
struct CallerProbe {
    #[indexed]
    who: Address,
}

fn probe() uses (evm: mut Evm) {
    evm.emit(CallerProbe { who: evm.address() })
}

fn t(_ secs: u256) -> Timestamp {
    Timestamp::from_seconds(secs)
}

// A valid three-milestone agreement (1 + 2 + 3 ETH) with deadlines 100, 200, 300 s after `base`.
fn valid(_ base: u256) -> Args {
    Args {
        provider: Address::new(0xa1),
        verifier: Address::new(0xa2),
        review_period: seconds(3600),
        n: 3,
        amounts: [ether(1), ether(2), ether(3)],
        deliver_by: [t(base + 100), t(base + 200), t(base + 300)],
        specs: [0x51, 0x52, 0x53],
    }
}

// A one-milestone agreement of 1 ETH due at `deliver_by`.
fn single(_ deliver_by: u256) -> Args {
    Args {
        provider: Address::new(0xa1),
        verifier: Address::new(0xa2),
        review_period: seconds(3600),
        n: 1,
        amounts: [ether(1), Wei::zero(), Wei::zero()],
        deliver_by: [t(deliver_by), t(0), t(0)],
        specs: [0x51, 0, 0],
    }
}

// Two milestones (1 + 2 ETH) due at d0 and d1, slot 2 empty. Fund it with 3 ETH.
fn two(_ d0: u256, _ d1: u256) -> Args {
    Args {
        provider: Address::new(0xa1),
        verifier: Address::new(0xa2),
        review_period: seconds(3600),
        n: 2,
        amounts: [ether(1), ether(2), Wei::zero()],
        deliver_by: [t(d0), t(d1), t(0)],
        specs: [0x51, 0x52, 0],
    }
}

// Three milestones (1 + 2 + 3 ETH) due at d0, d1 and d2. Fund it with 6 ETH.
fn three(_ d0: u256, _ d1: u256, _ d2: u256) -> Args {
    Args {
        provider: Address::new(0xa1),
        verifier: Address::new(0xa2),
        review_period: seconds(3600),
        n: 3,
        amounts: [ether(1), ether(2), ether(3)],
        deliver_by: [t(d0), t(d1), t(d2)],
        specs: [0x51, 0x52, 0x53],
    }
}

fn try_create(_ s: Address, _ a: Args, _ value: Wei) -> bool
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 1000000,
        value,
        message: SettleMsg::Create {
            provider: a.provider,
            verifier: a.verifier,
            review_period: a.review_period,
            n: a.n,
            amounts: a.amounts,
            deliver_by: a.deliver_by,
            specs: a.specs,
        },
    )
        .success()
}

fn create(_ s: Address, _ a: Args, _ value: Wei) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: s,
        gas: 1000000,
        value,
        message: SettleMsg::Create {
            provider: a.provider,
            verifier: a.verifier,
            review_period: a.review_period,
            n: a.n,
            amounts: a.amounts,
            deliver_by: a.deliver_by,
            specs: a.specs,
        },
    )
}

fn set_time(_ shell: Address, _ now: u256) uses (evm: mut Evm) {
    evm.call(
        addr: shell,
        gas: 100000,
        value: Wei::zero(),
        message: DevMsg::SetTime { now: t(now) },
    )
}

fn outstanding(_ s: Address) -> Wei uses (evm: mut Evm) {
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::TotalOutstanding {},
    )
}

fn milestone(_ s: Address, _ id: u256, _ m: u8) -> (
    u8,
    Wei,
    Timestamp,
    Timestamp,
    u256,
    u256,
    u256,
    u256,
)
uses (evm: mut Evm)
{
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetMilestone { id, m },
    )
}

fn agreement(_ s: Address, _ id: u256) -> (Address, Address, Address, Duration, u8)
uses (evm: mut Evm)
{
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetAgreement { id },
    )
}

fn accounting(_ s: Address, _ id: u256) -> (Wei, Wei, Wei, Wei)
uses (evm: mut Evm)
{
    evm.call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetAccounting { id },
    )
}

fn exists(_ s: Address, _ id: u256) -> bool uses (evm: mut Evm) {
    evm.try_call(
        addr: s,
        gas: 100000,
        value: Wei::zero(),
        message: SettleMsg::GetAgreement { id },
    )
        .success()
}

// Both contracts expose identical state for agreement `id` through every public view.
fn same_state(_ a: Address, _ b: Address, _ id: u256) uses (evm: mut Evm) {
    let x = agreement(a, id)
    let y = agreement(b, id)
    assert!(
        x.0 == y.0 && x.1 == y.1 && x.2 == y.2 && x.3 == y.3 && x.4 == y.4,
        "agreement differs",
    )
    let p = accounting(a, id)
    let q = accounting(b, id)
    assert!(
        p.0 == q.0 && p.1 == q.1 && p.2 == q.2 && p.3 == q.3,
        "accounting differs",
    )
    var m: u8 = 0
    while m < 4 {
        let u = milestone(a, id, m)
        let v = milestone(b, id, m)
        assert!(
            u.0 == v.0
                && u.1 == v.1
                && u.2 == v.2
                && u.3 == v.3
                && u.4 == v.4
                && u.5 == v.5
                && u.6 == v.6
                && u.7 == v.7,
            "milestone differs",
        )
        m += 1
    }
}

// Runs the same call on both and requires the same verdict. Returns it.
fn agree(_ prod: Address, _ shell: Address, _ a: Args, _ value: Wei) -> bool
uses (evm: mut Evm)
{
    let x = try_create(prod, a, value)
    let y = try_create(shell, a, value)
    assert!(x == y, "shell and production disagree")
    x
}

#[test(balance = 200_000_000_000_000_000_000)]
fn shell_and_production_agree_when_their_clocks_agree() uses (evm: mut Evm) {
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 2)
    let now = evm.timestamp().as_seconds()
    set_time(shell, now)

    // Valid creation: same id, same stored state.
    let good = valid(now)
    assert!(create(prod, good, ether(6)) == 1)
    assert!(create(shell, good, ether(6)) == 1)
    same_state(prod, shell, 1)
    assert!(outstanding(prod) == outstanding(shell))

    // The same verdict for a spread of invalid inputs (each is rejected by both).
    var a = good
    a.provider = Address::zero()
    assert!(!agree(prod, shell, a, ether(6)), "provider zero")
    a = good
    a.provider = evm.address()
    assert!(!agree(prod, shell, a, ether(6)), "client is provider")
    a = good
    a.verifier = good.provider
    assert!(!agree(prod, shell, a, ether(6)), "provider is verifier")
    a = good
    a.n = 4
    assert!(!agree(prod, shell, a, ether(6)), "n = 4")
    a = good
    a.review_period = Duration::zero()
    assert!(!agree(prod, shell, a, ether(6)), "zero review period")
    assert!(
        !agree(prod, shell, good, ether(6) + wei(1)),
        "one wei too much",
    )
    assert!(
        !agree(prod, shell, good, ether(6) - wei(1)),
        "one wei too little",
    )
    a = good
    a.deliver_by = [t(now), t(now + 200), t(now + 300)]
    assert!(!agree(prod, shell, a, ether(6)), "deliver_by == now")
    a = single(MAX - 999)
    a.review_period = seconds(1000)
    assert!(!agree(prod, shell, a, ether(1)), "decide_by overflow")
    a = single(now + 1)
    assert!(
        agree(prod, shell, a, ether(1)),
        "now + 1 accepted by both",
    )

    // Unknown ids behave alike: agreements revert, milestones read as None.
    assert!(exists(prod, 1) && exists(shell, 1))
    assert!(!exists(prod, 3) && !exists(shell, 3))
    assert!(!exists(prod, 0) && !exists(shell, 0))
    same_state(prod, shell, 2)
    assert!(
        milestone(prod, 3, 0).0 == 0 && milestone(shell, 3, 0).0 == 0,
    )
    assert!(
        outstanding(prod) == ether(7) && outstanding(shell) == ether(7),
    )
    assert!(
        evm.balance(prod) == ether(7) && evm.balance(shell) == ether(7),
    )
}

#[test(balance = 100_000_000_000_000_000_000)]
fn the_shell_crosses_creation_deadlines_that_a_frozen_block_cannot()
uses (evm: mut Evm)
{
    probe()
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 1)

    // Clock at 1000: deliver_by 1000 is rejected, 1001 is accepted (strict `>`).
    set_time(shell, 1000)
    assert!(
        !try_create(shell, single(1000), ether(1)),
        "deliver_by == now",
    )
    assert!(
        !try_create(shell, single(999), ether(1)),
        "deliver_by == now - 1",
    )
    assert!(
        outstanding(shell) == Wei::zero(),
        "rejections leave nothing behind",
    )
    assert!(
        try_create(shell, single(1001), ether(1)),
        "deliver_by == now + 1",
    )
    assert!(milestone(shell, 1, 0).2 == t(1001))
    assert!(milestone(shell, 1, 0).3 == t(1001 + 3600), "decide_by")

    // Move the clock past that deadline: the same input is now in the past.
    set_time(shell, 1001)
    assert!(
        !try_create(shell, single(1001), ether(1)),
        "now caught up with 1001",
    )
    set_time(shell, 5000)
    assert!(
        !try_create(shell, single(1001), ether(1)),
        "1001 is long past",
    )
    assert!(
        try_create(shell, single(5001), ether(1)),
        "5001 is after 5000",
    )

    // A deadline is judged against the clock at creation only. Agreement 1 is stored as created.
    assert!(
        milestone(shell, 1, 0).2 == t(1001),
        "stored deadlines never change",
    )
    assert!(milestone(shell, 1, 0).0 == 1, "still Funded")

    // Time zero: a used slot with deliver_by 0 is never in the future.
    set_time(shell, 0)
    assert!(
        !try_create(shell, single(0), ether(1)),
        "deliver_by 0 at time 0",
    )
    assert!(
        try_create(shell, single(1), ether(1)),
        "deliver_by 1 at time 0",
    )

    // The sum is exact at any clock, and the three-milestone shape works at a late clock.
    set_time(shell, 10000)
    assert!(!try_create(shell, valid(10000), ether(6) + wei(1)))
    assert!(try_create(shell, valid(10000), ether(6)))
    assert!(outstanding(shell) == ether(9), "1 + 1 + 1 + 6 ETH")
    assert!(evm.balance(shell) == ether(9))
}

#[test(balance = 100_000_000_000_000_000_000)]
fn production_has_no_way_to_set_its_clock() uses (evm: mut Evm) {
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 2)
    let now = evm.timestamp().as_seconds()

    // Positive control: the same `setTime` call works on the shell.
    assert!(
        evm.try_call(
            addr: shell,
            gas: 100000,
            value: Wei::zero(),
            message: DevMsg::SetTime { now: t(now + 10000) },
        )
            .success(),
    )
    // Production rejects it: the selector does not exist there. Several forms of the attempt.
    assert!(
        !evm.try_call(
            addr: prod,
            gas: 100000,
            value: Wei::zero(),
            message: DevMsg::SetTime { now: t(now + 10000) },
        )
            .success(),
    )
    assert!(
        !evm.try_call(
            addr: prod,
            gas: 100000,
            value: Wei::zero(),
            message: DevMsg::SetTime { now: t(0) },
        )
            .success(),
    )
    assert!(
        !evm.try_call(
            addr: prod,
            gas: 100000,
            value: ether(1),
            message: DevMsg::SetTime { now: t(now + 10000) },
        )
            .success(),
    )

    // And production time still follows the block: the boundary has not moved.
    assert!(
        !try_create(prod, single(now), ether(1)),
        "deliver_by == block time is still rejected",
    )
    assert!(
        try_create(prod, single(now + 1000), ether(1)),
        "now + 1000 is still accepted",
    )
    assert!(outstanding(prod) == ether(1))
    // The shell's clock was moved far ahead, production's was not affected by it.
    assert!(
        try_create(prod, single(now + 1), ether(1)),
        "now + 1 is still accepted by production",
    )
    assert!(
        !try_create(shell, single(now + 1), ether(1)),
        "the same input is past on the moved shell",
    )
}

#[test(balance = 100_000_000_000_000_000_000)]
fn the_client_is_the_caller_and_never_a_parameter() uses (evm: mut Evm) {
    let s = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let actor = evm.create2<Actor>(value: Wei::zero(), args: (), salt: 2)
    let now = evm.timestamp().as_seconds()
    let a = valid(now)

    // Created through the actor, the actor is the client and the test contract is not.
    let id: u256 = evm
        .call(
            addr: actor,
            gas: 2000000,
            value: ether(6),
            message: ActorMsg::CreateVia {
                target: s,
                provider: a.provider,
                verifier: a.verifier,
                review_period: a.review_period,
                n: a.n,
                amounts: a.amounts,
                deliver_by: a.deliver_by,
                specs: a.specs,
            },
        )
    assert!(id == 1)
    let ag = agreement(s, 1)
    assert!(ag.0 == actor, "the actor is the client")
    assert!(ag.0 != evm.address())
    assert!(evm.balance(s) == ether(6) && outstanding(s) == ether(6))

    // Distinctness is judged against the real caller: the actor as its own provider is
    // rejected, while the test contract (a different address) as provider is accepted.
    let by_itself = evm
        .try_call(
            addr: actor,
            gas: 2000000,
            value: ether(6),
            message: ActorMsg::CreateVia {
                target: s,
                provider: actor,
                verifier: a.verifier,
                review_period: a.review_period,
                n: a.n,
                amounts: a.amounts,
                deliver_by: a.deliver_by,
                specs: a.specs,
            },
        )
    assert!(
        !by_itself.success(),
        "the actor cannot be its own provider",
    )
    assert!(
        outstanding(s) == ether(6),
        "the rejected call left nothing behind",
    )
    let other = evm
        .try_call(
            addr: actor,
            gas: 2000000,
            value: ether(6),
            message: ActorMsg::CreateVia {
                target: s,
                provider: evm.address(),
                verifier: a.verifier,
                review_period: a.review_period,
                n: a.n,
                amounts: a.amounts,
                deliver_by: a.deliver_by,
                specs: a.specs,
            },
        )
    assert!(other.success(), "a different provider is accepted")
    assert!(
        agreement(s, 2).0 == actor && agreement(s, 2).1 == evm.address(),
    )
    assert!(outstanding(s) == ether(12))
}

// A `u8` field is range-checked at ABI decode (experiments/review/u1_u8_abi.fe). If it were
// truncated instead, n = 259 would silently become n = 3. This mirrors the production message
// with a wide `n` and the same 4-byte selector. It lives in the dev ingot because the
// production ingot may not use a selector that is not `sol(..)` (lint C-ABI, R-002 finding 1),
// and `sol(..)` itself cannot be used here: the compiler checks it against the `u256` field.
msg WideCreate {
    // keccak256("create(address,address,uint256,uint8,uint256[3],uint256[3],uint256[3])")[:4]
    #[selector = 0x75ac1b9d]
    Create {
        provider: Address,
        verifier: Address,
        review_period: Duration,
        n: u256,
        amounts: [Wei; 3],
        deliver_by: [Timestamp; 3],
        specs: [u256; 3],
    } -> u256,
}

fn try_wide(_ s: Address, _ a: Args, _ n: u256, _ value: Wei) -> bool
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 1000000,
        value,
        message: WideCreate::Create {
            provider: a.provider,
            verifier: a.verifier,
            review_period: a.review_period,
            n,
            amounts: a.amounts,
            deliver_by: a.deliver_by,
            specs: a.specs,
        },
    )
        .success()
}

#[test(balance = 100_000_000_000_000_000_000)]
fn a_wide_n_is_rejected_at_decode_and_never_truncated() uses (evm: mut Evm) {
    probe()
    let s = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let now = evm.timestamp().as_seconds()
    let a = valid(now)
    assert!(
        try_wide(s, a, 3, ether(6)),
        "positive control: the wide mirror works with n = 3",
    )
    assert!(
        !try_wide(s, a, 256, ether(6)),
        "n = 256 must not wrap to 0",
    )
    assert!(
        !try_wide(s, a, 259, ether(6)),
        "n = 259 must not wrap to 3",
    )
    assert!(!try_wide(s, a, MAX, ether(6)), "n = 2^256 - 1")
    assert!(
        outstanding(s) == ether(6) && evm.balance(s) == ether(6),
        "only the control created anything",
    )
    assert!(!exists(s, 2), "no second agreement")
}

#[test(balance = 200_000_000_000_000_000_000)]
fn the_shell_judges_every_slot_against_one_clock() uses (evm: mut Evm) {
    probe()
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 1)

    // Clock at 1000. In every position the boundary is the same: 1000 and below are rejected,
    // 1001 is accepted. A clock that moved with the slot index would break one of these.
    set_time(shell, 1000)
    assert!(
        try_create(shell, two(1001, 1001), ether(3)),
        "positive control: both slots 1001",
    )
    assert!(
        !try_create(shell, two(1000, 1001), ether(3)),
        "slot 0 == 1000",
    )
    assert!(
        !try_create(shell, two(1001, 1000), ether(3)),
        "slot 1 == 1000",
    )
    assert!(
        !try_create(shell, two(999, 1001), ether(3)),
        "slot 0 == 999",
    )
    assert!(
        !try_create(shell, two(1001, 999), ether(3)),
        "slot 1 == 999",
    )
    assert!(
        try_create(shell, two(1002, 1001), ether(3)),
        "slot 1 == 1001, slot 0 later",
    )
    assert!(
        try_create(shell, three(1001, 1001, 1001), ether(6)),
        "positive control: three slots 1001",
    )
    assert!(
        !try_create(shell, three(1001, 1001, 1000), ether(6)),
        "slot 2 == 1000",
    )
    assert!(
        !try_create(shell, three(1000, 1001, 1001), ether(6)),
        "slot 0 == 1000",
    )
    assert!(
        !try_create(shell, three(1001, 1000, 1001), ether(6)),
        "slot 1 == 1000",
    )
    assert!(
        outstanding(shell) == ether(12),
        "three accepted: 3 + 3 + 6 ETH, rejections left nothing",
    )

    // Move the clock: the same inputs are judged against the new time, in every slot.
    set_time(shell, 2000)
    assert!(
        !try_create(shell, two(1001, 1001), ether(3)),
        "both slots now in the past",
    )
    assert!(
        !try_create(shell, two(2001, 1001), ether(3)),
        "slot 1 is in the past",
    )
    assert!(
        !try_create(shell, two(1001, 2001), ether(3)),
        "slot 0 is in the past",
    )
    assert!(
        try_create(shell, two(2001, 2001), ether(3)),
        "both slots 2001",
    )
    assert!(
        outstanding(shell) == ether(15) && evm.balance(shell) == ether(15),
    )
}

#[test(balance = 400_000_000_000_000_000_000)]
fn shell_and_production_agree_on_every_two_and_three_milestone_boundary()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 2)
    let now = evm.timestamp().as_seconds()
    set_time(shell, now)

    // Offsets around `now` for each slot: -1, 0, +1. Every combination for two slots (9) must
    // get the same verdict from both contracts, and only (+1, +1) is accepted.
    var accepted: u256 = 0
    var x: u256 = 0
    while x < 3 {
        var y: u256 = 0
        while y < 3 {
            let ok = agree(prod, shell, two(now + x - 1, now + y - 1), ether(3))
            assert!(
                ok == (x == 2 && y == 2),
                "only both slots at now + 1 is accepted",
            )
            if ok { accepted += 1 }
            y += 1
        }
        x += 1
    }
    assert!(accepted == 1)
    // And one slot at a time on a three-milestone agreement (the others far ahead).
    var k: u8 = 0
    while k < 3 {
        var off: u256 = 0
        while off < 3 {
            var due = [now + 100, now + 200, now + 300]
            due[k as usize] = now + off - 1
            let ok = agree(prod, shell, three(due[0], due[1], due[2]), ether(6))
            assert!(ok == (off == 2), "slot k is accepted only at now + 1")
            if ok { accepted += 1 }
            off += 1
        }
        k += 1
    }
    assert!(accepted == 4, "1 + 3 accepted")
    same_state(prod, shell, 1)
    same_state(prod, shell, 4)
    assert!(
        outstanding(prod) == outstanding(shell) && evm.balance(prod) == evm.balance(shell),
    )
}

// ===================================================================== Phase 2B
// The roles are Actors: the harness has no caller impersonation, so the provider, the verifier
// and a stranger are three separate contracts that forward calls to Settlane. The client is the
// test contract. Every negative case asserts WHY the call reverted (the reason survives the Actor).

enum Why {
    UnknownAgreement,
    NotProvider,
    NotVerifier,
    NoSuchMilestone,
    WrongState,
    NotSubmitted,
    DeliveryClosed,
    ReviewClosed,
    ZeroEvidence,
    EvidenceMismatch,
    RevisionMismatch,
}

impl Copy for Why {}

fn because(_ out: CallOutcome, _ why: Why) -> bool {
    if out.success() {
        return false
    }
    let reason = match decode_error_string(out.returndata()) {
        Option::Some(reason) => reason,
        Option::None => {
            return false
        },
    }
    match why {
        Why::UnknownAgreement => reason == "unknown agreement",
        Why::NotProvider => reason == "caller is not the provider",
        Why::NotVerifier => reason == "caller is not the verifier",
        Why::NoSuchMilestone => reason == "no such milestone",
        Why::WrongState => reason == "milestone cannot take evidence in this state",
        Why::NotSubmitted => reason == "milestone is not submitted",
        Why::DeliveryClosed => reason == "delivery window is closed",
        Why::ReviewClosed => reason == "review window is closed",
        Why::ZeroEvidence => reason == "evidence is zero",
        Why::EvidenceMismatch => reason == "evidence does not match the submitted evidence",
        Why::RevisionMismatch => reason == "submission revision does not match",
    }
}

fn actor(_ salt: u256) -> Address uses (evm: mut Evm) {
    evm.create2<Actor>(value: Wei::zero(), args: (), salt)
}

fn parties(_ a: Args, _ p: Address, _ v: Address) -> Args {
    var b = a
    b.provider = p
    b.verifier = v
    b
}

// `by` forwards the call to `s`, so Settlane sees `by` as the caller.
fn submit_out(_ by: Address, _ s: Address, _ id: u256, _ m: u8, _ e: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: by,
        gas: 2000000,
        value: Wei::zero(),
        message: ActorMsg::SubmitVia { target: s, id, m, evidence: e },
    )
}

fn approve_out(
    _ by: Address,
    _ s: Address,
    _ id: u256,
    _ m: u8,
    _ e: u256,
    _ revision: u256,
) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: by,
        gas: 2000000,
        value: Wei::zero(),
        message: ActorMsg::ApproveVia { target: s, id, m, evidence: e, revision },
    )
}

fn reject_out(
    _ by: Address,
    _ s: Address,
    _ id: u256,
    _ m: u8,
    _ e: u256,
    _ revision: u256,
) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: by,
        gas: 2000000,
        value: Wei::zero(),
        message: ActorMsg::RejectVia { target: s, id, m, evidence: e, revision },
    )
}

// Direct calls from the test contract (the client).
fn submit_direct(_ s: Address, _ id: u256, _ m: u8, _ e: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Submit { id, m, evidence: e },
    )
}

fn approve_direct(_ s: Address, _ id: u256, _ m: u8, _ e: u256, _ revision: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Approve { id, m, evidence: e, revision },
    )
}

fn reject_direct(_ s: Address, _ id: u256, _ m: u8, _ e: u256, _ revision: u256) -> CallOutcome
uses (evm: mut Evm)
{
    evm.try_call(
        addr: s,
        gas: 500000,
        value: Wei::zero(),
        message: SettleMsg::Reject { id, m, evidence: e, revision },
    )
}

fn state_of(_ s: Address, _ id: u256, _ m: u8) -> u8 uses (evm: mut Evm) {
    milestone(s, id, m).0
}

fn evidence_of(_ s: Address, _ id: u256, _ m: u8) -> u256 uses (evm: mut Evm) {
    milestone(s, id, m).5
}

fn rejections_of(_ s: Address, _ id: u256, _ m: u8) -> u256
uses (evm: mut Evm)
{
    milestone(s, id, m).6
}

fn same_milestone(
    _ a: (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256),
    _ b: (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256),
) -> bool {
    a.0 == b.0
        && a.1 == b.1
        && a.2 == b.2
        && a.3 == b.3
        && a.4 == b.4
        && a.5 == b.5
        && a.6 == b.6
        && a.7 == b.7
}

// The fields no transition may ever change: amount, both deadlines and the spec.
fn fixed_fields(
    _ a: (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256),
    _ b: (u8, Wei, Timestamp, Timestamp, u256, u256, u256, u256),
) -> bool {
    a.1 == b.1 && a.2 == b.2 && a.3 == b.3 && a.4 == b.4
}

// A transition moves no ETH: what the contract holds is exactly what is owed (no surplus here).
fn assert_money(_ s: Address, _ owed: Wei) uses (evm: mut Evm) {
    assert!(outstanding(s) == owed, "total outstanding changed")
    assert!(evm.balance(s) == owed, "the contract balance changed")
}

#[test(balance = 300_000_000_000_000_000_000)]
fn provider_submits_and_verifier_approves_on_production_with_the_real_clock()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(two(now + 100, now + 200), p, v), ether(3)) == 1,
    )
    let funded = milestone(prod, 1, 0)
    assert!(
        funded.0 == 1 && funded.5 == 0 && funded.6 == 0,
        "Funded, no evidence, no rejections",
    )

    assert!(
        submit_out(p, prod, 1, 0, 0xe1).success(),
        "the provider submits",
    )
    let submitted = milestone(prod, 1, 0)
    assert!(
        submitted.0 == 2 && submitted.5 == 0xe1 && submitted.6 == 0,
        "Submitted with the evidence",
    )
    assert!(
        fixed_fields(funded, submitted),
        "amount, deadlines and spec are untouched",
    )
    assert!(state_of(prod, 1, 1) == 1, "milestone 1 is independent")

    assert!(
        approve_out(v, prod, 1, 0, 0xe1, 1).success(),
        "the verifier approves",
    )
    let approved = milestone(prod, 1, 0)
    assert!(
        approved.0 == 3 && approved.5 == 0xe1 && approved.6 == 0,
        "Approved, the evidence is kept",
    )
    assert!(
        fixed_fields(funded, approved),
        "approval changes only the state",
    )

    assert!(submit_out(p, prod, 1, 1, 0xe2).success())
    assert!(approve_out(v, prod, 1, 1, 0xe2, 1).success())
    assert!(
        state_of(prod, 1, 1) == 3 && evidence_of(prod, 1, 1) == 0xe2,
    )
    // No ETH moved and approval paid nothing: everything is still owed.
    assert_money(prod, ether(3))
    let acc = accounting(prod, 1)
    assert!(
        acc.0 == ether(3) && acc.1 == Wei::zero() && acc.2 == Wei::zero() && acc.3 == ether(3),
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn only_the_provider_submits_and_only_the_verifier_reviews()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let st = actor(13)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(two(now + 100, now + 200), p, v), ether(3)) == 1,
    )
    let f0 = milestone(prod, 1, 0)
    let f1 = milestone(prod, 1, 1)

    // Funded: only the provider may submit.
    assert!(
        because(submit_out(v, prod, 1, 0, 0xe1), Why::NotProvider),
        "the verifier cannot submit",
    )
    assert!(
        because(submit_out(st, prod, 1, 0, 0xe1), Why::NotProvider),
        "a stranger cannot submit",
    )
    assert!(
        because(submit_direct(prod, 1, 0, 0xe1), Why::NotProvider),
        "the client cannot submit",
    )
    // Reviewing a Funded milestone: the others lack the role, and the verifier has the wrong state.
    assert!(
        because(approve_out(p, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
        "the provider cannot approve",
    )
    assert!(
        because(approve_out(st, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(approve_direct(prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(reject_out(p, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(reject_out(st, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(reject_direct(prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(approve_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
        "the verifier, but nothing is submitted",
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
    )
    assert!(
        same_milestone(milestone(prod, 1, 0), f0) && same_milestone(milestone(prod, 1, 1), f1),
        "nothing changed",
    )

    // The provider submits both milestones (positive control).
    assert!(submit_out(p, prod, 1, 0, 0xe1).success())
    assert!(submit_out(p, prod, 1, 1, 0xe2).success())
    let s0 = milestone(prod, 1, 0)
    let s1 = milestone(prod, 1, 1)

    // Submitted: still only the provider may resubmit, and only the verifier may review.
    assert!(because(submit_out(v, prod, 1, 0, 0xe9), Why::NotProvider))
    assert!(
        because(submit_out(st, prod, 1, 0, 0xe9), Why::NotProvider),
    )
    assert!(because(submit_direct(prod, 1, 0, 0xe9), Why::NotProvider))
    assert!(
        because(approve_out(p, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
        "the provider cannot approve its own work",
    )
    assert!(
        because(approve_out(st, prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(approve_direct(prod, 1, 0, 0xe1, 1), Why::NotVerifier),
    )
    assert!(
        because(reject_out(p, prod, 1, 1, 0xe2, 1), Why::NotVerifier),
        "the provider cannot reject",
    )
    assert!(
        because(reject_out(st, prod, 1, 1, 0xe2, 1), Why::NotVerifier),
    )
    assert!(
        because(reject_direct(prod, 1, 1, 0xe2, 1), Why::NotVerifier),
    )
    assert!(
        same_milestone(milestone(prod, 1, 0), s0) && same_milestone(milestone(prod, 1, 1), s1),
        "nothing changed",
    )

    // The verifier acts (positive controls): approve one, reject the other.
    assert!(approve_out(v, prod, 1, 0, 0xe1, 1).success())
    assert!(reject_out(v, prod, 1, 1, 0xe2, 1).success())
    assert!(state_of(prod, 1, 0) == 3, "milestone 0 Approved")
    assert!(
        state_of(prod, 1, 1) == 1 && evidence_of(prod, 1, 1) == 0 && rejections_of(prod, 1, 1) == 1,
        "milestone 1 back to Funded",
    )
    assert_money(prod, ether(3))
}

#[test(balance = 300_000_000_000_000_000_000)]
fn evidence_must_match_and_stale_evidence_can_neither_be_approved_nor_rejected()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 1,
    )

    assert!(
        because(submit_out(p, prod, 1, 0, 0), Why::ZeroEvidence),
        "zero evidence cannot be submitted",
    )
    assert!(state_of(prod, 1, 0) == 1, "still Funded")
    assert!(
        submit_out(p, prod, 1, 0, 0xe1).success(),
        "positive control: evidence e1",
    )

    // The verifier must name exactly the stored evidence (D-015), for approve and for reject.
    assert!(
        because(approve_out(v, prod, 1, 0, 0, 1), Why::EvidenceMismatch),
        "zero never matches",
    )
    assert!(
        because(
            approve_out(v, prod, 1, 0, 0x99, 1),
            Why::EvidenceMismatch,
        ),
        "a different evidence",
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0, 1), Why::EvidenceMismatch),
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0x99, 1), Why::EvidenceMismatch),
    )
    assert!(
        state_of(prod, 1, 0) == 2 && evidence_of(prod, 1, 0) == 0xe1,
        "still Submitted with e1",
    )

    // Reject e1: back to Funded, the evidence is cleared, the counter is 1.
    assert!(reject_out(v, prod, 1, 0, 0xe1, 1).success())
    assert!(
        state_of(prod, 1, 0) == 1 && evidence_of(prod, 1, 0) == 0 && rejections_of(prod, 1, 0) == 1,
    )
    assert!(
        because(approve_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
        "nothing is submitted any more",
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
    )

    // The provider resubmits e2. The verifier's old e1 is now stale (the S-1 race of D-015).
    assert!(submit_out(p, prod, 1, 0, 0xe2).success())
    assert!(
        because(reject_out(v, prod, 1, 0, 0xe1, 1), Why::EvidenceMismatch),
        "a Reject meant for e1 must not hit e2",
    )
    assert!(
        because(
            approve_out(v, prod, 1, 0, 0xe1, 1),
            Why::EvidenceMismatch,
        ),
        "an Approve meant for e1 must not hit e2",
    )
    assert!(
        state_of(prod, 1, 0) == 2
            && evidence_of(prod, 1, 0) == 0xe2
            && rejections_of(prod, 1, 0) == 1,
    )

    // A resubmission while Submitted replaces the evidence; only the latest can be approved.
    assert!(submit_out(p, prod, 1, 0, 0xe3).success())
    assert!(evidence_of(prod, 1, 0) == 0xe3)
    assert!(
        because(
            approve_out(v, prod, 1, 0, 0xe2, 1),
            Why::EvidenceMismatch,
        ),
        "e2 was replaced",
    )
    assert!(
        approve_out(v, prod, 1, 0, 0xe3, 3).success(),
        "e3 is approved",
    )
    assert!(
        state_of(prod, 1, 0) == 3
            && evidence_of(prod, 1, 0) == 0xe3
            && rejections_of(prod, 1, 0) == 1,
    )
    assert_money(prod, ether(1))
}

#[test(balance = 300_000_000_000_000_000_000)]
fn replays_and_invalid_transitions_are_rejected_and_an_approved_milestone_never_changes()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 1,
    )
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 2,
    )

    // Agreement 1 goes to Approved. A replay of every step, and every other action, is rejected.
    assert!(submit_out(p, prod, 1, 0, 0xe1).success())
    assert!(
        submit_out(p, prod, 1, 0, 0xe1).success(),
        "an identical resubmission advances the revision",
    )
    assert!(
        state_of(prod, 1, 0) == 2
            && evidence_of(prod, 1, 0) == 0xe1
            && rejections_of(prod, 1, 0) == 0,
    )
    assert!(approve_out(v, prod, 1, 0, 0xe1, 2).success())
    let approved = milestone(prod, 1, 0)
    assert!(approved.0 == 3)
    assert!(
        because(approve_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
        "replayed approve",
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0xe1, 1), Why::NotSubmitted),
        "reject after approve",
    )
    assert!(
        because(submit_out(p, prod, 1, 0, 0xe1), Why::WrongState),
        "replayed submit after approve",
    )
    assert!(
        because(submit_out(p, prod, 1, 0, 0xe7), Why::WrongState),
        "new evidence after approve",
    )
    assert!(
        same_milestone(milestone(prod, 1, 0), approved),
        "an approved milestone never changes",
    )
    assert_money(prod, ether(2))

    // Agreement 2 goes Funded -> Submitted -> Funded (rejected). Replays and wrong-state calls fail.
    assert!(
        because(approve_out(v, prod, 2, 0, 0xe1, 1), Why::NotSubmitted),
        "approve from Funded",
    )
    assert!(
        because(reject_out(v, prod, 2, 0, 0xe1, 1), Why::NotSubmitted),
        "reject from Funded",
    )
    assert!(submit_out(p, prod, 2, 0, 0xe1).success())
    assert!(reject_out(v, prod, 2, 0, 0xe1, 1).success())
    assert!(
        because(reject_out(v, prod, 2, 0, 0xe1, 1), Why::NotSubmitted),
        "replayed reject",
    )
    assert!(
        because(approve_out(v, prod, 2, 0, 0xe1, 1), Why::NotSubmitted),
        "approve after reject",
    )
    assert!(
        state_of(prod, 2, 0) == 1 && rejections_of(prod, 2, 0) == 1,
        "back to Funded, counted once",
    )
    assert!(
        submit_out(p, prod, 2, 0, 0xe2).success(),
        "and it can be submitted again",
    )
    assert!(
        same_milestone(milestone(prod, 1, 0), approved),
        "agreement 1 was never touched",
    )
    assert_money(prod, ether(2))
}

// Time-dependent tests use the test-clock shell. The agreement is created at shell time 1000 with
// deliver_by 2000 and a 3600 s review period, so decide_by is 5600.
fn shell_at_1000() -> Address uses (evm: mut Evm) {
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 1)
    set_time(shell, 1000)
    shell
}

#[test(balance = 300_000_000_000_000_000_000)]
fn the_delivery_window_closes_exactly_at_deliver_by() uses (evm: mut Evm) {
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    var i: u256 = 0
    while i < 6 {
        assert!(
            create(shell, parties(single(2000), p, v), ether(1)) == i + 1,
        )
        i += 1
    }
    // Agreement 1: d - 1 is open.
    set_time(shell, 1999)
    assert!(submit_out(p, shell, 1, 0, 0xe1).success(), "d - 1: open")
    assert!(state_of(shell, 1, 0) == 2)
    // Agreements 2 and 3: d and d + 1 are closed, and the milestone stays Funded with no evidence.
    set_time(shell, 2000)
    assert!(
        because(submit_out(p, shell, 2, 0, 0xe1), Why::DeliveryClosed),
        "d: closed",
    )
    set_time(shell, 2001)
    assert!(
        because(submit_out(p, shell, 3, 0, 0xe1), Why::DeliveryClosed),
        "d + 1: closed",
    )
    assert!(
        state_of(shell, 2, 0) == 1 && evidence_of(shell, 2, 0) == 0,
        "agreement 2 stays Funded",
    )
    assert!(state_of(shell, 3, 0) == 1)
    // Resubmission is the same window: submitted at d - 1, a resubmission at d is closed.
    set_time(shell, 1999)
    assert!(submit_out(p, shell, 4, 0, 0xe1).success())
    set_time(shell, 2000)
    assert!(
        because(submit_out(p, shell, 4, 0, 0xe2), Why::DeliveryClosed),
        "no resubmission at d",
    )
    assert!(
        state_of(shell, 4, 0) == 2 && evidence_of(shell, 4, 0) == 0xe1,
        "the old evidence stands",
    )
    // A milestone rejected before d and still Funded at d cannot take new evidence: it is stuck.
    set_time(shell, 1999)
    assert!(submit_out(p, shell, 5, 0, 0xe1).success())
    assert!(reject_out(v, shell, 5, 0, 0xe1, 1).success())
    set_time(shell, 2000)
    assert!(
        because(submit_out(p, shell, 5, 0, 0xe2), Why::DeliveryClosed),
        "rejected, then d: closed",
    )
    assert!(
        state_of(shell, 5, 0) == 1 && rejections_of(shell, 5, 0) == 1,
    )
    assert_money(shell, ether(6))
}

#[test(balance = 300_000_000_000_000_000_000)]
fn the_review_window_closes_exactly_at_decide_by_and_a_late_submission_keeps_it_whole()
uses (evm: mut Evm)
{
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    var i: u256 = 0
    while i < 6 {
        assert!(
            create(shell, parties(single(2000), p, v), ether(1)) == i + 1,
        )
        i += 1
    }
    // Everything is submitted at d - 1 = 1999, one second before delivery closes.
    set_time(shell, 1999)
    var id: u256 = 1
    while id <= 6 {
        assert!(submit_out(p, shell, id, 0, 0xe0 + id).success())
        id += 1
    }
    // The delivery window is now closed, but the review window (decide_by = 5600) is whole.
    set_time(shell, 3000)
    assert!(
        approve_out(v, shell, 1, 0, 0xe1, 1).success(),
        "approve long after d, before decide_by",
    )
    set_time(shell, 5599)
    assert!(
        approve_out(v, shell, 2, 0, 0xe2, 1).success(),
        "decide_by - 1: approve is open",
    )
    assert!(
        reject_out(v, shell, 3, 0, 0xe3, 1).success(),
        "decide_by - 1: reject is open",
    )
    set_time(shell, 5600)
    assert!(
        because(approve_out(v, shell, 4, 0, 0xe4, 1), Why::ReviewClosed),
        "decide_by: approve is closed",
    )
    assert!(
        because(reject_out(v, shell, 4, 0, 0xe4, 1), Why::ReviewClosed),
        "decide_by: reject is closed",
    )
    set_time(shell, 5601)
    assert!(
        because(approve_out(v, shell, 5, 0, 0xe5, 1), Why::ReviewClosed),
        "decide_by + 1: closed",
    )
    assert!(
        because(reject_out(v, shell, 6, 0, 0xe6, 1), Why::ReviewClosed),
    )
    // A closed review leaves the milestone Submitted (a refund in a later phase can take it).
    assert!(
        state_of(shell, 4, 0) == 2 && evidence_of(shell, 4, 0) == 0xe4,
    )
    assert!(state_of(shell, 5, 0) == 2 && state_of(shell, 6, 0) == 2)
    // And the provider cannot resubmit either: the delivery window closed at 2000.
    assert!(
        because(submit_out(p, shell, 4, 0, 0xea), Why::DeliveryClosed),
    )
    assert!(
        state_of(shell, 1, 0) == 3 && state_of(shell, 2, 0) == 3,
        "approved",
    )
    assert!(
        state_of(shell, 3, 0) == 1 && rejections_of(shell, 3, 0) == 1,
        "rejected at decide_by - 1",
    )
    assert_money(shell, ether(6))
}

#[test(balance = 300_000_000_000_000_000_000)]
fn an_approved_milestone_stays_immutable_through_every_deadline()
uses (evm: mut Evm)
{
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    assert!(create(shell, parties(single(2000), p, v), ether(1)) == 1)
    set_time(shell, 1500)
    assert!(submit_out(p, shell, 1, 0, 0xe1).success())
    set_time(shell, 1600)
    assert!(approve_out(v, shell, 1, 0, 0xe1, 1).success())
    let approved = milestone(shell, 1, 0)
    assert!(approved.0 == 3)

    // At each of these times every action by the right role is rejected, and nothing changes.
    // The state is checked before the window, so the reason is the state, even after the deadlines.
    var times = [1601, 1999, 2000, 5599, 5600, 1000000]
    var k: u8 = 0
    while k < 6 {
        set_time(shell, times[k as usize])
        assert!(
            because(submit_out(p, shell, 1, 0, 0xe1), Why::WrongState),
            "submit",
        )
        assert!(
            because(submit_out(p, shell, 1, 0, 0xee), Why::WrongState),
            "submit new evidence",
        )
        assert!(
            because(approve_out(v, shell, 1, 0, 0xe1, 1), Why::NotSubmitted),
            "approve",
        )
        assert!(
            because(reject_out(v, shell, 1, 0, 0xe1, 1), Why::NotSubmitted),
            "reject",
        )
        assert!(
            same_milestone(milestone(shell, 1, 0), approved),
            "unchanged",
        )
        k += 1
    }
    assert_money(shell, ether(1))
    let acc = accounting(shell, 1)
    assert!(
        acc.0 == ether(1) && acc.1 == Wei::zero() && acc.2 == Wei::zero() && acc.3 == ether(1),
        "approval never expires",
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn unknown_agreements_and_unused_milestones_are_rejected_by_the_right_role_on_both_contracts()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 2)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    set_time(shell, now)
    let targets = [prod, shell]

    var t: u8 = 0
    while t < 2 {
        let s = targets[t as usize]
        // No agreement yet: ids 0 and 1 are unknown, whoever calls.
        assert!(
            because(submit_out(p, s, 0, 0, 0xe1), Why::UnknownAgreement),
            "id 0",
        )
        assert!(
            because(approve_out(v, s, 0, 0, 0xe1, 1), Why::UnknownAgreement),
        )
        assert!(
            because(reject_out(v, s, 0, 0, 0xe1, 1), Why::UnknownAgreement),
        )
        assert!(
            because(submit_out(p, s, 1, 0, 0xe1), Why::UnknownAgreement),
            "before any agreement",
        )
        assert!(
            because(approve_out(v, s, 1, 0, 0xe1, 1), Why::UnknownAgreement),
        )
        assert!(
            because(reject_out(v, s, 1, 0, 0xe1, 1), Why::UnknownAgreement),
        )
        assert!(
            create(s, parties(single(now + 100), p, v), ether(1)) == 1,
            "positive control",
        )
        // Known agreement, wrong id.
        assert!(
            because(submit_out(p, s, 2, 0, 0xe1), Why::UnknownAgreement),
            "id 2",
        )
        assert!(
            because(approve_out(v, s, MAX, 0, 0xe1, 1), Why::UnknownAgreement),
            "id 2^256 - 1",
        )
        assert!(
            because(reject_out(v, s, MAX, 0, 0xe1, 1), Why::UnknownAgreement),
        )
        // Known agreement with one milestone: slots 1, 2, 3 and 255 are unused.
        var slot: u8 = 1
        while slot != 0 {
            assert!(
                because(submit_out(p, s, 1, slot, 0xe1), Why::NoSuchMilestone),
                "unused slot, submit",
            )
            assert!(
                because(approve_out(v, s, 1, slot, 0xe1, 1), Why::NoSuchMilestone),
                "unused slot, approve",
            )
            assert!(
                because(reject_out(v, s, 1, slot, 0xe1, 1), Why::NoSuchMilestone),
                "unused slot, reject",
            )
            if slot == 3 {
                slot = 255
            } else if slot == 255 { slot = 0 } else { slot += 1 }
        }
        assert!(
            state_of(s, 1, 0) == 1 && state_of(s, 1, 1) == 0,
            "the unused slot stayed None",
        )
        assert!(
            submit_out(p, s, 1, 0, 0xe1).success(),
            "positive control: slot 0 works",
        )
        assert_money(s, ether(1))
        t += 1
    }
}

#[test(balance = 400_000_000_000_000_000_000)]
fn agreements_are_isolated_and_milestones_are_independent()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p1 = actor(21)
    let v1 = actor(22)
    let p2 = actor(23)
    let v2 = actor(24)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(
                prod,
                parties(three(now + 100, now + 200, now + 300), p1, v1),
                ether(6),
            ) == 1,
    )
    assert!(
        create(
                prod,
                parties(three(now + 100, now + 200, now + 300), p2, v2),
                ether(6),
            ) == 2,
    )
    let other0 = milestone(prod, 2, 0)
    let other1 = milestone(prod, 2, 1)
    let other2 = milestone(prod, 2, 2)

    // Agreement 1's roles have no power over agreement 2, and the reverse.
    assert!(
        because(submit_out(p1, prod, 2, 0, 0xe1), Why::NotProvider),
        "provider 1 on agreement 2",
    )
    assert!(
        because(submit_out(p2, prod, 1, 0, 0xe1), Why::NotProvider),
        "provider 2 on agreement 1",
    )
    // Work on agreement 1: m0 approved, m1 submitted then rejected, m2 untouched.
    assert!(submit_out(p1, prod, 1, 0, 0xa0).success())
    assert!(submit_out(p1, prod, 1, 1, 0xa1).success())
    assert!(approve_out(v1, prod, 1, 0, 0xa0, 1).success())
    assert!(reject_out(v1, prod, 1, 1, 0xa1, 1).success())
    assert!(
        state_of(prod, 1, 0) == 3 && state_of(prod, 1, 1) == 1 && state_of(prod, 1, 2) == 1,
        "independent milestones",
    )
    assert!(
        rejections_of(prod, 1, 0) == 0
            && rejections_of(prod, 1, 1) == 1
            && rejections_of(prod, 1, 2) == 0,
        "independent counters",
    )
    assert!(
        evidence_of(prod, 1, 0) == 0xa0
            && evidence_of(prod, 1, 1) == 0
            && evidence_of(prod, 1, 2) == 0,
    )
    // Agreement 2 has not changed at all.
    assert!(same_milestone(milestone(prod, 2, 0), other0))
    assert!(same_milestone(milestone(prod, 2, 1), other1))
    assert!(same_milestone(milestone(prod, 2, 2), other2))

    // Submitted on agreement 2: verifier 1 cannot touch it, verifier 2 can, and 1 is still unchanged.
    assert!(submit_out(p2, prod, 2, 0, 0xb0).success())
    assert!(
        because(approve_out(v1, prod, 2, 0, 0xb0, 1), Why::NotVerifier),
        "verifier 1 on agreement 2",
    )
    assert!(
        because(reject_out(v1, prod, 2, 0, 0xb0, 1), Why::NotVerifier),
    )
    assert!(
        because(approve_out(v2, prod, 1, 2, 0xb0, 1), Why::NotVerifier),
        "verifier 2 holds no role on agreement 1: the role is checked before the state",
    )
    assert!(approve_out(v2, prod, 2, 0, 0xb0, 1).success())
    assert!(
        state_of(prod, 2, 0) == 3 && state_of(prod, 1, 0) == 3,
        "both approved, separately",
    )
    assert!(
        evidence_of(prod, 1, 0) == 0xa0 && evidence_of(prod, 2, 0) == 0xb0,
        "each keeps its own evidence",
    )
    assert_money(prod, ether(12))
    assert!(
        accounting(prod, 1).3 == ether(6) && accounting(prod, 2).3 == ether(6),
    )
}

#[test(balance = 300_000_000_000_000_000_000)]
fn the_rejection_counter_counts_every_revision_request_and_never_decreases()
uses (evm: mut Evm)
{
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    assert!(create(shell, parties(single(2000), p, v), ether(1)) == 1)
    var k: u256 = 0
    while k < 3 {
        set_time(shell, 1100 + k)
        assert!(
            submit_out(p, shell, 1, 0, 0xc0 + k).success(),
            "submit revision k",
        )
        assert!(evidence_of(shell, 1, 0) == 0xc0 + k)
        assert!(
            reject_out(v, shell, 1, 0, 0xc0 + k, k + 1).success(),
            "reject revision k",
        )
        assert!(
            rejections_of(shell, 1, 0) == k + 1,
            "the counter goes up by one",
        )
        assert!(
            evidence_of(shell, 1, 0) == 0 && state_of(shell, 1, 0) == 1,
            "evidence cleared, Funded again",
        )
        k += 1
    }
    set_time(shell, 1500)
    assert!(submit_out(p, shell, 1, 0, 0xcf).success())
    assert!(approve_out(v, shell, 1, 0, 0xcf, 4).success())
    assert!(
        rejections_of(shell, 1, 0) == 3,
        "approval keeps the count",
    )
    assert!(
        state_of(shell, 1, 0) == 3 && evidence_of(shell, 1, 0) == 0xcf,
    )
    assert_money(shell, ether(1))
}

#[test(balance = 400_000_000_000_000_000_000)]
fn production_and_the_shell_agree_on_every_step_of_a_transition_script()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let shell = evm.create2<SettlaneTestClock>(value: Wei::zero(), args: (), salt: 2)
    let p = actor(11)
    let v = actor(12)
    let st = actor(13)
    let now = evm.timestamp().as_seconds()
    set_time(shell, now)
    let a = parties(three(now + 100, now + 200, now + 300), p, v)
    assert!(create(prod, a, ether(6)) == 1)
    assert!(create(shell, a, ether(6)) == 1)

    // Each step runs on both and must get the same verdict. `true` means it was accepted.
    assert!(agree_submit(p, prod, shell, 1, 0, 0xe1), "submit e1")
    assert!(
        !agree_submit(st, prod, shell, 1, 0, 0xe2),
        "stranger submit",
    )
    assert!(!agree_submit(p, prod, shell, 1, 0, 0), "zero evidence")
    assert!(!agree_submit(p, prod, shell, 1, 5, 0xe2), "unused slot")
    assert!(
        !agree_submit(p, prod, shell, 9, 0, 0xe2),
        "unknown agreement",
    )
    assert!(
        !agree_review(false, p, prod, shell, 1, 0, 0xe1, 1),
        "approve by the provider",
    )
    assert!(
        !agree_review(true, v, prod, shell, 1, 0, 0x77, 1),
        "approve wrong evidence",
    )
    assert!(
        !agree_review(false, v, prod, shell, 1, 0, 0x77, 1),
        "reject wrong evidence",
    )
    assert!(
        agree_review(false, v, prod, shell, 1, 0, 0xe1, 1),
        "reject e1",
    )
    assert!(
        !agree_review(false, v, prod, shell, 1, 0, 0xe1, 1),
        "replayed reject",
    )
    assert!(
        !agree_review(true, v, prod, shell, 1, 0, 0xe1, 1),
        "approve after reject",
    )
    assert!(agree_submit(p, prod, shell, 1, 0, 0xe3), "resubmit e3")
    assert!(
        !agree_review(true, v, prod, shell, 1, 0, 0xe1, 1),
        "stale approve",
    )
    assert!(
        agree_review(true, v, prod, shell, 1, 0, 0xe3, 2),
        "approve e3",
    )
    assert!(
        !agree_submit(p, prod, shell, 1, 0, 0xe4),
        "submit after approve",
    )
    assert!(agree_submit(p, prod, shell, 1, 2, 0xe5), "milestone 2")
    assert!(
        agree_review(false, v, prod, shell, 1, 2, 0xe5, 1),
        "reject milestone 2",
    )
    assert!(
        agree_submit(p, prod, shell, 1, 2, 0xe5),
        "resubmit milestone 2",
    )
    assert!(
        agree_review(true, v, prod, shell, 1, 2, 0xe5, 2),
        "approve milestone 2",
    )
    same_state(prod, shell, 1)
    assert!(
        outstanding(prod) == outstanding(shell) && evm.balance(prod) == evm.balance(shell),
    )
}

fn agree_submit(
    _ by: Address,
    _ prod: Address,
    _ shell: Address,
    _ id: u256,
    _ m: u8,
    _ e: u256,
) -> bool
uses (evm: mut Evm)
{
    let x = submit_out(by, prod, id, m, e).success()
    let y = submit_out(by, shell, id, m, e).success()
    assert!(x == y, "shell and production disagree on submit")
    x
}

// approve when `approve` is true, reject otherwise
fn agree_review(
    _ approve: bool,
    _ by: Address,
    _ prod: Address,
    _ shell: Address,
    _ id: u256,
    _ m: u8,
    _ e: u256,
    _ revision: u256,
) -> bool
uses (evm: mut Evm)
{
    var x = false
    var y = false
    if approve {
        x = approve_out(by, prod, id, m, e, revision).success()
        y = approve_out(by, shell, id, m, e, revision).success()
    } else {
        x = reject_out(by, prod, id, m, e, revision).success()
        y = reject_out(by, shell, id, m, e, revision).success()
    }
    assert!(x == y, "shell and production disagree on a review")
    x
}

#[test(balance = 300_000_000_000_000_000_000)]
fn transitions_are_not_payable_and_never_move_money() uses (evm: mut Evm) {
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 1,
    )
    assert_money(prod, ether(1))

    // The same calls with value attached are rejected (non-payable) and keep nothing. Each has a
    // zero-value positive control that succeeds, so value is the only difference.
    let with_value = ether(1)
    assert!(
        !evm.try_call(
            addr: p,
            gas: 2000000,
            value: with_value,
            message: ActorMsg::SubmitVia { target: prod, id: 1, m: 0, evidence: 0xe1 },
        )
            .success(),
        "submit with value is rejected",
    )
    assert!(state_of(prod, 1, 0) == 1, "and it changed nothing")
    assert!(
        submit_out(p, prod, 1, 0, 0xe1).success(),
        "positive control: submit without value",
    )
    assert!(
        !evm.try_call(
            addr: v,
            gas: 2000000,
            value: with_value,
            message: ActorMsg::RejectVia { target: prod, id: 1, m: 0, evidence: 0xe1, revision: 1 },
        )
            .success(),
        "reject with value is rejected",
    )
    assert!(state_of(prod, 1, 0) == 2, "still Submitted")
    assert!(
        !evm.try_call(
            addr: v,
            gas: 2000000,
            value: with_value,
            message: ActorMsg::ApproveVia {
                target: prod,
                id: 1,
                m: 0,
                evidence: 0xe1,
                revision: 1,
            },
        )
            .success(),
        "approve with value is rejected",
    )
    assert!(state_of(prod, 1, 0) == 2, "still Submitted")
    assert!(
        approve_out(v, prod, 1, 0, 0xe1, 1).success(),
        "positive control: approve without value",
    )
    // The contract holds exactly what it did, the totals did not move, and the actors kept their ETH.
    assert_money(prod, ether(1))
    let acc = accounting(prod, 1)
    assert!(
        acc.0 == ether(1) && acc.1 == Wei::zero() && acc.2 == Wei::zero() && acc.3 == ether(1),
        "approval pays nothing",
    )
    assert!(
        evm.balance(p) == Wei::zero() && evm.balance(v) == Wei::zero(),
        "no ETH reached the provider or the verifier",
    )
}

#[test(balance = 100_000_000_000_000_000_000)]
fn restored_and_identical_evidence_require_a_fresh_review_revision()
uses (evm: mut Evm)
{
    probe()
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(single(now + 100), p, v), ether(1)) == 1,
    )
    assert!(milestone(prod, 1, 0).7 == 0)
    assert!(submit_out(p, prod, 1, 0, 0xa1).success())
    assert!(submit_out(p, prod, 1, 0, 0xb1).success())
    assert!(submit_out(p, prod, 1, 0, 0xa1).success())
    let restored = milestone(prod, 1, 0)
    assert!(restored.7 == 3)
    assert!(
        because(
            approve_out(v, prod, 1, 0, 0xa1, 1),
            Why::RevisionMismatch,
        ),
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0xa1, 1), Why::RevisionMismatch),
    )
    assert!(same_milestone(restored, milestone(prod, 1, 0)))

    assert!(reject_out(v, prod, 1, 0, 0xa1, 3).success())
    assert!(milestone(prod, 1, 0).7 == 3)
    assert!(submit_out(p, prod, 1, 0, 0xa1).success())
    assert!(
        because(reject_out(v, prod, 1, 0, 0xa1, 3), Why::RevisionMismatch),
    )
    assert!(submit_out(p, prod, 1, 0, 0xa1).success())
    let identical = milestone(prod, 1, 0)
    assert!(
        identical.7 == 5 && identical.6 == 1 && identical.5 == 0xa1,
    )
    assert!(
        because(
            approve_out(v, prod, 1, 0, 0xa1, 4),
            Why::RevisionMismatch,
        ),
    )
    assert!(
        because(reject_out(v, prod, 1, 0, 0xa1, 4), Why::RevisionMismatch),
    )
    assert!(same_milestone(identical, milestone(prod, 1, 0)))
    assert!(approve_out(v, prod, 1, 0, 0xa1, 5).success())
    assert!(milestone(prod, 1, 0).7 == 5)
    assert_money(prod, ether(1))
}

#[test(balance = 100_000_000_000_000_000_000)]
fn third_slot_revision_lifecycle_at_both_deadlines() uses (evm: mut Evm) {
    probe()
    let shell = shell_at_1000()
    let p = actor(11)
    let v = actor(12)
    let args = parties(three(2000, 2000, 2000), p, v)
    assert!(create(shell, args, ether(6)) == 1)
    assert!(create(shell, args, ether(6)) == 2)
    assert!(create(shell, args, ether(6)) == 3)
    let sibling0 = milestone(shell, 1, 0)
    let sibling1 = milestone(shell, 1, 1)
    let original = milestone(shell, 1, 2)
    set_time(shell, 1999)
    assert!(submit_out(p, shell, 1, 2, 0xd1).success())
    assert!(reject_out(v, shell, 1, 2, 0xd1, 1).success())
    assert!(submit_out(p, shell, 1, 2, 0xd2).success())
    assert!(submit_out(p, shell, 2, 2, 0xd3).success())
    assert!(submit_out(p, shell, 3, 2, 0xd5).success())
    let submitted = milestone(shell, 1, 2)
    assert!(
        submitted.0 == 2 && submitted.5 == 0xd2 && submitted.6 == 1 && submitted.7 == 2,
    )
    set_time(shell, 2000)
    assert!(
        because(submit_out(p, shell, 1, 2, 0xd4), Why::DeliveryClosed),
    )
    set_time(shell, 2001)
    assert!(
        because(submit_out(p, shell, 1, 2, 0xd4), Why::DeliveryClosed),
    )
    assert!(same_milestone(submitted, milestone(shell, 1, 2)))
    set_time(shell, 5599)
    assert!(approve_out(v, shell, 1, 2, 0xd2, 2).success())
    assert!(reject_out(v, shell, 3, 2, 0xd5, 1).success())
    assert!(
        because(submit_out(p, shell, 3, 2, 0xd6), Why::DeliveryClosed),
    )
    let rejected = milestone(shell, 3, 2)
    assert!(
        rejected.0 == 1 && rejected.5 == 0 && rejected.6 == 1 && rejected.7 == 1,
    )
    let pending = milestone(shell, 2, 2)
    set_time(shell, 5600)
    assert!(
        because(approve_out(v, shell, 2, 2, 0xd3, 1), Why::ReviewClosed),
    )
    assert!(
        because(reject_out(v, shell, 2, 2, 0xd3, 1), Why::ReviewClosed),
    )
    set_time(shell, 5601)
    assert!(
        because(approve_out(v, shell, 2, 2, 0xd3, 1), Why::ReviewClosed),
    )
    assert!(
        because(reject_out(v, shell, 2, 2, 0xd3, 1), Why::ReviewClosed),
    )
    assert!(same_milestone(pending, milestone(shell, 2, 2)))
    let approved = milestone(shell, 1, 2)
    assert!(fixed_fields(original, approved))
    assert!(
        approved.0 == 3 && approved.5 == 0xd2 && approved.6 == 1 && approved.7 == 2,
    )
    assert!(same_milestone(sibling0, milestone(shell, 1, 0)))
    assert!(same_milestone(sibling1, milestone(shell, 1, 1)))
    assert_money(shell, ether(18))
}
