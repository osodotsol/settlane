// EXPECT: fail C-XFER,C-XFER-RAW
// The Call effect bound as `pay`: the approved text no longer matches, and the binding name itself is rejected so no rule can be dodged by renaming.
use std::evm::StorageMap

pub fn claim_handler(id: u256, m: u8, to: Address) -> Wei
uses (ctx: Ctx, pay: mut Call, log: mut Log, totals: mut Totals, agreements: mut StorageMap<u256, Agreement>, milestones: mut StorageMap<(u256, u8), Milestone>)
{
    let a = agreements.get(key: id)
    let x = milestones.get(key: (id, m))
    let amount = x.amount
    milestones.set(key: (id, m), value: Milestone { state: MilestoneState::Paid, amount: x.amount })
    agreements.set(key: id, value: Agreement { paid: a.paid + amount, refunded: a.refunded })
    totals.outstanding = totals.outstanding - amount
    log.emit(MilestoneClaimed { id, m, to, amount })
    assert!(pay.send_value(addr: to, gas: 0, value: amount).success(), "transfer failed")
    amount
}
