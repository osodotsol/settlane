// EXPECT: pass
use std::evm::ether

msg SettleMsg {
    #[selector = sol("approve(uint256)")]
    Approve { id: u256 },
    #[selector = sol("claim(address)")]
    Claim { to: Address },
}

pub contract Settlane uses (ctx: Ctx, call: mut Call) {
    mut paid: Wei,

    recv SettleMsg {
        // uses (call) would be a violation, but this is only a comment.
        Approve { id } uses (ctx, mut paid) {
            assert!(id > 0, "do not call create here")
            paid = paid
        }

        Claim { to } uses (ctx, mut call, mut paid) {
            paid = paid + ether(1)
            assert!(call.send_value(addr: to, gas: 0, value: ether(1)).success(), "failed")
        }
    }
}
