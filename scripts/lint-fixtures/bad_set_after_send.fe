// EXPECT: fail C-XFER
// A storage write after the transfer: with forwarded gas the recipient could re-enter first.
use std::evm::StorageMap

pub fn claim_handler(id: u256, m: u8, to: Address) -> Wei
uses (ctx: Ctx, call: mut Call, log: mut Log, totals: mut Totals, agreements: mut StorageMap<u256, Agreement>, milestones: mut StorageMap<(u256, u8), Milestone>)
{
    let a = agreements.get(key: id)
    let x = milestones.get(key: (id, m))
    let amount = x.amount
    milestones.set(key: (id, m), value: Milestone { state: MilestoneState::Paid, amount: x.amount })
    agreements.set(key: id, value: Agreement { paid: a.paid + amount, refunded: a.refunded })
    assert!(call.send_value(addr: to, gas: 0, value: amount).success(), "transfer failed")
    totals.outstanding = totals.outstanding - amount
    amount
}
