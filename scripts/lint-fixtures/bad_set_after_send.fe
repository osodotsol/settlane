// EXPECT: fail C-CEI
// The write happens after the transfer: with forwarded gas the recipient could re-enter first.
use std::evm::StorageMap

pub fn claim_like(id: u256, to: Address) -> Wei uses (call: mut Call, owed: mut StorageMap<u256, Wei>) {
    let amount = owed.get(key: id)
    assert!(call.send_value(addr: to, gas: 0, value: amount).success(), "transfer failed")
    owed.set(key: id, value: Wei::zero())
    amount
}
