// EXPECT: fail C-XFER,C-XFER-RAW
// Since D-024 the helper itself is also C-XFER-RAW: only transfer handlers may require Call.
// PATH: tests.fe
// Even in tests.fe, a plain helper (no #[test]) that sends through the `call` binding is rejected:
// a contract could call it. Only `evm.send_value` inside a #[test] function is allowed there.
use std::evm::StorageMap

pub fn pay_out(to: Address, amount: Wei) uses (call: mut Call, owed: mut StorageMap<u256, Wei>) {
    assert!(call.send_value(addr: to, gas: 50000, value: amount).success(), "transfer failed")
    owed.set(key: 0, value: Wei::zero())
}
