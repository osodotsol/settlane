// EXPECT: fail E-CALL
use std::evm::ether

msg SettleMsg {
    #[selector = sol("approve(uint256)")]
    Approve { id: u256 },
    #[selector = sol("claim(address)")]
    Claim { to: Address },
}

pub contract Settlane uses (all: mut Super) {
    mut paid: Wei,

    recv SettleMsg {
        Approve { id } uses (all) {
            assert!(all.send_value(addr: Address::new(1), gas: 0, value: ether(1)).success())
        }
    }
}
