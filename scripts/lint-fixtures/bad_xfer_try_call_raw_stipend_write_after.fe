// EXPECT: fail C-XFER,C-XFER-RAW
// R-005 b2b: a stipend-only raw call with a write after it: no test can see it.
use std::evm::StorageMap

pub fn claim_handler(id: u256, m: u8, to: Address) -> Wei
uses (ctx: Ctx, call: mut Call, log: mut Log, totals: mut Totals, agreements: mut StorageMap<u256, Agreement>, milestones: mut StorageMap<(u256, u8), Milestone>)
{
    let a = agreements.get(key: id)
    let x = milestones.get(key: (id, m))
    let amount = x.amount
    milestones.set(key: (id, m), value: x)
    agreements.set(key: id, value: a)
    log.emit(MilestoneClaimed { id, m, to, amount })
    assert!(call.try_call_raw(addr: to, gas: 0, value: amount, args: MemSpan::empty()).success(), "transfer failed")
    totals.outstanding = totals.outstanding - amount
    amount
}
