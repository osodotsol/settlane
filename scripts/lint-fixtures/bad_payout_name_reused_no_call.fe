// EXPECT: fail E-DUP
// IGNORE: C-XFER,C-XFER-RAW,C-XFER-ARM
// Reusing a payout arm name is rejected even when the duplicate moves no ETH.
use std::evm::ether

msg SettleMsg {
    #[selector = sol("claim(address)")]
    Claim { to: Address },
}

msg AdminMsg {
    #[selector = sol("claimInfo(address)")]
    Claim { to: Address },
}

pub contract Settlane uses (ctx: Ctx, call: mut Call) {
    mut paid: Wei,

    recv SettleMsg {
        Claim { to } uses (ctx, mut call, mut paid) {
            assert!(call.send_value(addr: to, gas: 0, value: ether(1)).success())
        }
    }

    recv AdminMsg {
        Claim { to } uses (ctx) {
            let _ = ctx.balance(to)
        }
    }
}
