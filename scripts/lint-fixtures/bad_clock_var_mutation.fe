// EXPECT: fail C-CLOCK
pub struct Clock {
    pub now: Timestamp,
}

pub fn is_open(deliver_by: Timestamp) -> bool uses (clock: Clock) {
    clock.now < deliver_by
}

msg M {
    #[selector = sol("open(uint256,uint256)")]
    Open { deliver_by: Timestamp, fake_now: Timestamp } -> bool,
}

pub contract Settlane uses (ctx: Ctx) {
    recv M {
        Open { deliver_by, fake_now } -> bool uses (ctx) {
            var c = Clock { now: ctx.timestamp() }
            c.now = fake_now
            var open = false
            with (Clock = c) {
                open = is_open(deliver_by: deliver_by)
            }
            open
        }
    }
}
