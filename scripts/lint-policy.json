{
  "_note": "value_types are the privileged effects: only listed payout arms may name them. RawStorage/RawOps added by review H3 (2026-11-18). benign_contract_effects plus value_types is the fail-closed allowlist of contract-level effect types in the production ingot (E-EFFECT, review H1).",
  "value_types": [
    "Call",
    "Create",
    "Super",
    "Evm",
    "RawStorage",
    "RawOps"
  ],
  "ingots": {
    "settlane": "production",
    "settlane-dev": "dev"
  },
  "contracts": {
    "Settlane": {
      "payout_arms": [
        "SettleMsg::Claim",
        "SettleMsg::Refund"
      ],
      "production": true,
      "deployable": true,
      "abi": {
        "functions": {
          "create(address,address,uint256,uint8,uint256[3],uint256[3],uint256[3])->(uint256)": "payable",
          "submit(uint256,uint8,uint256)->()": "nonpayable",
          "approve(uint256,uint8,uint256,uint256)->()": "nonpayable",
          "reject(uint256,uint8,uint256,uint256)->()": "nonpayable",
          "getAgreement(uint256)->(address,address,address,uint256,uint8)": "view",
          "getMilestone(uint256,uint8)->(uint8,uint256,uint256,uint256,uint256,uint256,uint256,uint256)": "view",
          "getAccounting(uint256)->(uint256,uint256,uint256,uint256)": "view",
          "totalOutstanding()->(uint256)": "view"
        },
        "events": [
          "AgreementCreated(uint256 indexed,address indexed,address indexed,address,uint256,uint8)",
          "MilestoneSubmitted(uint256 indexed,uint8 indexed,uint256 indexed,uint256)",
          "MilestoneApproved(uint256 indexed,uint8 indexed,uint256 indexed,uint256)",
          "MilestoneRejected(uint256 indexed,uint8 indexed,uint256 indexed,uint256,uint256)"
        ]
      }
    },
    "SettlaneTestClock": {
      "payout_arms": [
        "SettleMsg::Claim",
        "SettleMsg::Refund"
      ],
      "test_only": true,
      "note": "Test shell with a settable clock. Defined only in the dev ingot, and must never appear in the production build output (C-LAYOUT, C-ARTIFACT)."
    },
    "Actor": {
      "test_only": true,
      "value_rules": "exempt",
      "note": "Dev-ingot helper acting as a separate caller (docs/FE_NOTES.md E4). May move value in tests."
    }
  },
  "benign_contract_effects": [
    "Ctx",
    "Log"
  ]
}
