# Settlane frontend configuration. Every variable is OPTIONAL: with none set, the app reads the
# live Sepolia deployment through public, keyless RPC endpoints. Nothing here is secret, and the
# app never needs a private key (signing happens only in the user's wallet).
#
# Copy to .env.local only if you want to override a default.

# Comma-separated RPC endpoints for contract reads (default: publicnode, then Tenderly).
# NEXT_PUBLIC_RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co

# Comma-separated endpoints for event logs (default: the read endpoints plus rpc.sepolia.ethpandaops.io).
# NEXT_PUBLIC_HISTORY_RPC_URLS=

# Contract address and its deployment block (defaults: the Sepolia deployment).
# NEXT_PUBLIC_SETTLANE_ADDRESS=0xf79d229a039bf5c84ecc7327060f8bbc888d2182
# NEXT_PUBLIC_DEPLOY_BLOCK=12175958

# Build output directory (used by the end-to-end runner to keep several builds apart).
# SETTLANE_DIST_DIR=.next
