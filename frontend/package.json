{
  "name": "settlane-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.11 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "sync-abi": "node scripts/sync-abi.mjs",
    "check-abi": "node scripts/sync-abi.mjs --check",
    "check": "npm run check-abi && npm run lint && npm run typecheck && npm run test && npm run build",
    "test:live": "SETTLANE_LIVE=1 vitest run tests/live.sepolia.test.ts",
    "snapshot:verify-local": "vitest run tests/snapshot-integrity.test.ts",
    "snapshot:check": "node scripts/build-event-snapshot.mjs --check",
    "snapshot:advance": "node scripts/build-event-snapshot.mjs --advance",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.16",
    "wagmi": "3.7.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
