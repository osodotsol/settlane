{
  "name": "settlane-evm-demo-spike",
  "private": true,
  "type": "module",
  "description": "F0 spike: the pinned production Settlane bytecode on an in-browser EVM. Not part of the app build.",
  "scripts": {
    "node": "node run-node.mjs",
    "bundle": "esbuild browser-entry.mjs --bundle --minify --format=esm --platform=browser --target=es2022 --loader:.bin=text --outfile=dist/spike.js",
    "browser": "node run-browser.mjs"
  },
  "dependencies": {
    "@ethereumjs/vm": "10.1.3",
    "@ethereumjs/evm": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "viem": "2.57.16",
    "esbuild": "0.28.2",
    "playwright": "1.65.0"
  }
}
