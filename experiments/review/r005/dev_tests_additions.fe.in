// R-005 (docs/reviews/2026-11-19-phase3a.md): tests appended to a TEMPORARY copy of
// ingots/settlane-dev/src/tests.fe by run.sh. They use that file's helpers. Never part of the dev ingot.
fn probe_setup() -> (Address, Address) uses (evm: mut Evm) {
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let p = actor(11)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(
        create(prod, parties(three(now + 100, now + 200, now + 300), p, v), ether(6)) == 1,
    )
    approve_first(p, v, prod, 1, 0, 0xe1)
    approve_first(p, v, prod, 1, 1, 0xe2)
    approve_first(p, v, prod, 1, 2, 0xe3)
    (prod, p)
}

#[test(balance = 300_000_000_000_000_000_000)]
fn r005_payee_gets_at_most_the_2300_stipend() uses (evm: mut Evm) {
    let (prod, p) = probe_setup()
    let cap = evm.create2<GasCap>(value: Wei::zero(), args: (), salt: 31)
    // Positive control: GasCap really rejects a send with more gas.
    assert!(!evm.send_value(addr: cap, gas: 10000, value: wei(1)).success(), "control: cap rejects 10000 gas")
    assert!(claim_ok(p, prod, 1, 0, cap) == ether(1), "the fallback saw <= 2300 gas")
    assert!(evm.balance(cap) == ether(1))
}

#[test(balance = 300_000_000_000_000_000_000)]
fn r005_precompile_payees() uses (evm: mut Evm) {
    let (prod, p) = probe_setup()
    // ecrecover costs 3000 gas, above the stipend: the send fails and the claim reverts.
    assert!(because(claim_out(p, prod, 1, 0, Address::new(1)), Why::TransferFailed), "0x01 fails")
    // identity (0x04) costs ~15 gas: the claim succeeds and the ETH is stranded at a precompile.
    assert!(claim_ok(p, prod, 1, 0, Address::new(4)) == ether(1), "0x04 accepts")
    assert!(evm.balance(Address::new(4)) == ether(1), "ETH sits at the identity precompile")
    // sha256 (0x02) costs 60 gas.
    assert!(claim_ok(p, prod, 1, 1, Address::new(2)) == ether(2), "0x02 accepts")
    assert_money(prod, ether(3))
}

#[test(balance = 300_000_000_000_000_000_000)]
fn r005_greedy_provider_always_reenters() uses (evm: mut Evm) {
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let g = evm.create2<Greedy>(value: Wei::zero(), args: (), salt: 22)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(create(prod, parties(two(now + 100, now + 200), g, v), ether(3)) == 1)
    assert!(create(prod, parties(three(now + 100, now + 200, now + 300), g, v), ether(6)) == 2)
    evm.call(addr: g, gas: 200000, value: Wei::zero(), message: AttackMsg::Setup { target: prod, id: 1, m: 0 })
    evm.call(addr: g, gas: 2000000, value: Wei::zero(), message: AttackMsg::SubmitAs { evidence: 0xe1 })
    assert!(approve_out(v, prod, 1, 0, 0xe1, 1).success())
    let out = evm.try_call(addr: g, gas: 2000000, value: Wei::zero(), message: AttackMsg::ClaimTo { to: g })
    // Under the stipend the nested attempt cannot pay. Either the claim succeeds once, or the
    // fallback runs out of gas and the claim reverts with `transfer failed`.
    if out.success() {
        assert!(evm.balance(g) == ether(1), "exactly one payout")
        assert!(state_of(prod, 1, 0) == 4)
        assert_money(prod, ether(8))
        assert!(false, "unexpected: a payee that always re-enters was paid under the stipend")
    } else {
        assert!(because(out, Why::TransferFailed), "the only other allowed outcome")
        assert!(evm.balance(g) == Wei::zero())
        assert!(state_of(prod, 1, 0) == 3)
        assert_money(prod, ether(9))
    }
}

#[test(balance = 300_000_000_000_000_000_000)]
fn r005_nonpayable_claim_returns_empty_revert_data() uses (evm: mut Evm) {
    let (prod, p) = probe_setup()
    let direct = evm.try_call(addr: prod, gas: 500000, value: ether(1), message: SettleMsg::Claim { id: 1, m: 0, to: Address::new(0x9b1) })
    assert!(!direct.success())
    assert!(direct.returndata_len() == 0, "non-payable revert carries no data")
    let via = evm.try_call(addr: p, gas: 2000000, value: ether(1), message: ActorMsg::ClaimVia { target: prod, id: 1, m: 0, to: Address::new(0x9b1) })
    assert!(!via.success())
    assert!(via.returndata_len() == 0, "and the Actor re-raises it empty")
}

#[test(balance = 300_000_000_000_000_000_000)]
fn r005_b7_once_is_paid_twice() uses (evm: mut Evm) {
    let prod = evm.create2<Settlane>(value: Wei::zero(), args: (), salt: 1)
    let g = evm.create2<Once>(value: Wei::zero(), args: (), salt: 23)
    let v = actor(12)
    let now = evm.timestamp().as_seconds()
    assert!(create(prod, parties(two(now + 100, now + 200), g, v), ether(3)) == 1)
    assert!(create(prod, parties(three(now + 100, now + 200, now + 300), g, v), ether(6)) == 2)
    evm.call(addr: g, gas: 200000, value: Wei::zero(), message: AttackMsg::Setup { target: prod, id: 1, m: 0 })
    evm.call(addr: g, gas: 2000000, value: Wei::zero(), message: AttackMsg::SubmitAs { evidence: 0xe1 })
    assert!(approve_out(v, prod, 1, 0, 0xe1, 1).success())
    let got: Wei = evm.call(addr: g, gas: 5000000, value: Wei::zero(), message: AttackMsg::ClaimTo { to: g })
    assert!(got == ether(1), "the outer claim reports 1 ETH")
    assert!(evm.balance(g) == ether(2), "a 1 ETH milestone paid 2 ETH")
    assert!(evm.balance(prod) == ether(7), "2 ETH left the contract")
    assert!(outstanding(prod) == ether(7), "totalOutstanding fell twice")
    let a1 = accounting(prod, 1)
    assert!(a1.1 == ether(1) && a1.3 == ether(2), "agreement 1 records one payment and still owes 2 ETH (stale write)")
    let a2 = accounting(prod, 2)
    assert!(a2.3 == ether(6), "agreement 2 still owes 6 ETH")
    // Insolvent: owed 2 + 6 = 8 ETH, held 7 ETH. Agreement 2's funds paid the attacker.
    assert!(evm.balance(prod) < a1.3 + a2.3, "balance < sum of per-agreement outstanding (I9 broken)")
}
