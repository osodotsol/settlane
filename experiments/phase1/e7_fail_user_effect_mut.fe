// E7d (compile-fail?): a `mut self` method called through a read-only
// user-defined effect binding. Compares with the built-in Call effect, where
// a read-only binding was accepted (e7_fail_readonly_call.fe).
// Expected if mutability is enforced: `fe check --standalone` rejects this.

pub struct Counter { hits: u256 }

impl Counter {
    pub fn inc(mut self) {
        self.hits += 1
    }
}

fn bump() uses (counter: Counter) {
    counter.inc()
}

pub fn run() -> u256 {
    var c = Counter { hits: 0 }
    with (Counter = mut c) {
        bump()
    }
    c.hits
}
